<div class="cart-page-section" data-cart-page-section>
  <div class="cart-page-container">
    {%- if cart.item_count == 0 -%}
      <div class="cart-page__empty">
        <h1 class="cart-page__empty-title">{{ settings.cart_drawer_empty_title | default: 'Sua sacola está vazia' }}</h1>
        
        <a href="{{ settings.cart_drawer_empty_button_url | default: routes.all_products_collection_url }}" class="cart-page__empty-btn">
          {{ settings.cart_drawer_empty_button_label | default: 'Continuar comprando' }}
        </a>
      </div>
    {%- else -%}
      <div class="cart-page__header">
        <h1>Sacola</h1>
        <p class="cart-page__item-count">
          {{ cart.item_count }}
          {% if cart.item_count == 1 %}
            item
          {% else %}
            itens
          {% endif %}
        </p>
      </div>

      <div class="cart-page__layout">
        <!-- Coluna Esquerda: Itens -->
        <div class="cart-page__left">
          <!-- Barra de Frete Grátis -->
          {%- if settings.cart_drawer_show_free_shipping -%}
            {%- assign free_shipping_threshold = settings.cart_drawer_free_shipping_threshold | times: 100 -%}
            {%- assign cart_total = cart.total_price -%}
            {%- assign amount_left = free_shipping_threshold | minus: cart_total -%}
            {%- if amount_left < 0 -%}{%- assign amount_left = 0 -%}{%- endif -%}
            {%- if free_shipping_threshold > 0 -%}
              {%- assign progress_percentage = cart_total | times: 100.0 | divided_by: free_shipping_threshold -%}
            {%- else -%}
              {%- assign progress_percentage = 100 -%}
            {%- endif -%}
            {%- if progress_percentage > 100 -%}{%- assign progress_percentage = 100 -%}{%- endif -%}
            {%- assign amount_left_money = amount_left | money -%}
            {%- assign free_shipping_remaining_text = settings.cart_drawer_free_shipping_remaining_text | replace: '[amount]', amount_left_money -%}

            <div class="cart-page__shipping-progress-container">
              <div class="cart-page__shipping-msg">
                {% if settings.cart_drawer_free_shipping_icon != blank %}
                  <img src="{{ settings.cart_drawer_free_shipping_icon | image_url: width: 36 }}" width="18" height="18" style="object-fit: contain; flex-shrink: 0;" alt="" loading="lazy">
                {% else %}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                {% endif %}
                {% if amount_left > 0 %}
                  <span>{{ free_shipping_remaining_text }}</span>
                {% else %}
                  <span>{{ settings.cart_drawer_free_shipping_success_text }}</span>
                {% endif %}
              </div>
              <div class="cart-page__shipping-bar">
                <div class="cart-page__shipping-progress" style="width: {{ progress_percentage }}%;"></div>
              </div>
            </div>
          {%- endif -%}

          <!-- Lista de Itens -->
          <div class="cart-page__items">
            {% for item in cart.items %}
              <div class="cart-page__item" id="CartItem-{{ item.index | plus: 1 }}">
                <div class="cart-page__item-image-wrapper">
                  <a href="{{ item.url }}">
                    {% if item.image %}
                      <img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.image.alt | escape }}" loading="lazy" class="cart-page__item-image" width="120" height="145">
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'cart-page__item-image placeholder' }}
                    {% endif %}
                  </a>
                </div>
                <div class="cart-page__item-info">
                  <div class="cart-page__item-meta">
                    <a href="{{ item.url }}" class="cart-page__item-title">{{ item.product.title }}</a>
                    {% unless item.variant.title contains 'Default' %}
                      <p class="cart-page__item-variant">Tamanho: {{ item.variant.title }}</p>
                    {% endunless %}
                    <p class="cart-page__item-price">{{ item.final_line_price | money }}</p>
                    
                    <div class="cart-page__quantity">
                      <button type="button" class="cart-page__qty-btn" aria-label="Diminuir" onclick="updateCartItem({{ item.index | plus: 1 }}, {{ item.quantity | minus: 1 }})">-</button>
                      <input class="cart-page__qty-input" type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantidade" readonly>
                      {% assign max_qty = '' %}
                      {% if item.variant.inventory_management == 'shopify' and item.variant.inventory_policy == 'deny' %}
                        {% assign max_qty = item.variant.inventory_quantity %}
                      {% endif %}
                      {% assign next_qty = item.quantity | plus: 1 %}
                      {% if max_qty != '' and next_qty > max_qty %}
                        {% assign next_qty = max_qty %}
                        {% assign disable_plus = true %}
                      {% else %}
                        {% assign disable_plus = false %}
                      {% endif %}
                      <button type="button" class="cart-page__qty-btn" aria-label="Aumentar" onclick="updateCartItem({{ item.index | plus: 1 }}, {{ next_qty }})"{% if disable_plus %} disabled{% endif %}>+</button>
                    </div>
                  </div>
                  
                  <div class="cart-page__item-remove-wrapper">
                    <button type="button" class="cart-page__remove" aria-label="Remover" onclick="updateCartItem({{ item.index | plus: 1 }}, 0)">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                    </button>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>

          <!-- Botão Continuar Comprando -->
          <div class="cart-page__actions">
            <a href="{{ routes.all_products_collection_url }}" class="cart-page__btn-continue">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
              <span>CONTINUAR COMPRANDO</span>
            </a>
          </div>
        </div>

        <!-- Coluna Direita: Resumo do Pedido -->
        <div class="cart-page__right">
          <div class="cart-page__summary">
            <h2>Resumo do pedido</h2>
            
            <div class="cart-page__summary-row">
              <span>Subtotal</span>
              <span data-cart-subtotal>{{ cart.total_price | money }}</span>
            </div>
            
            <div class="cart-page__summary-row">
              <span>Frete</span>
              <span data-cart-shipping-cost>Calcular</span>
            </div>
            
            <div class="cart-page__summary-divider"></div>
            
            <div class="cart-page__summary-row cart-page__summary-row--total">
              <span>Total</span>
              <span data-cart-total>{{ cart.total_price | money }}</span>
            </div>

            <!-- Simulação de Parcelas -->
            {%- assign installments = section.settings.installments_number | default: 3 -%}
            {%- assign installment_price = cart.total_price | divided_by: installments -%}
            <p class="cart-page__installments" data-cart-installments data-installments="{{ installments }}">
              ou até {{ installments }}x de {{ installment_price | money }} sem juros
            </p>

            <div class="cart-page__summary-divider"></div>

            <!-- Calculadora de Frete -->
            {% render 'shipping-calculator', id: 'cart-page', class: 'cart-page__shipping-calculator' %}
            <a href="https://buscacepinter.correios.com.br/app/endereco/index.php" target="_blank" rel="noopener" class="cart-page__cep-link">Não sei meu CEP</a>

            <!-- Botão de Finalizar Compra -->
            <form action="{{ routes.cart_url }}" method="post" id="cart-page-checkout-form">
              <button type="submit" name="checkout" class="cart-page__btn-checkout">
                FINALIZAR COMPRA
              </button>
            </form>

            <div class="cart-page__secure-badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
              <span>Ambiente 100% seguro</span>
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}

    <!-- Recomendações de Produtos -->
    {%- if cart.item_count > 0 -%}
      <div class="product-recommendations" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ cart.items.first.product_id }}&limit=5">
        {%- if recommendations.performed and recommendations.products_count > 0 -%}
          <div class="cart-recommendations">
            <h2 class="cart-recommendations__heading">{{ section.settings.recommendations_heading | default: "Você também pode gostar" }}</h2>
            <div class="cart-recommendations__grid">
              {%- for product in recommendations.products -%}
                {% render 'product-card', product: product %}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      {%- assign fallback_collection = section.settings.recommendations_collection -%}
      {%- if fallback_collection != blank and fallback_collection.products_count > 0 -%}
        <div class="cart-recommendations">
          <h2 class="cart-recommendations__heading">{{ section.settings.recommendations_heading | default: "Você também pode gostar" }}</h2>
          <div class="cart-recommendations__grid">
            {%- for product in fallback_collection.products limit: 5 -%}
              {% render 'product-card', product: product %}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .cart-page-section {
    padding-block: clamp(3rem, 6vw, 5rem);
    background-color: var(--color-background);
    font-family: 'Inter', sans-serif;
  }

  .cart-page-container {
    max-width: var(--page-width, 90rem);
    margin-inline: auto;
    padding-inline: var(--page-margin, 1.25rem);
  }

  .cart-page__header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-items: flex-start;
    margin-bottom: 1.5rem;
    border-bottom: none;
    padding-bottom: 0;
  }

  .cart-page__header h1 {
    font-size: 2.25rem;
    font-weight: 500;
    color: var(--color-foreground);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .cart-page__item-count {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    font-weight: 400;
  }

  /* Estado Vazio */
  .cart-page__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-block: clamp(6rem, 12vw, 10rem);
    max-width: 480px;
    margin-inline: auto;
  }

  .cart-page__empty-title {
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    font-weight: 500;
    color: var(--color-foreground);
    margin-top: 0;
    margin-bottom: 2.25rem;
    letter-spacing: -0.02em;
  }

  .cart-page__empty-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-accent);
    color: #ffffff;
    padding: 1.125rem 2.75rem;
    border-radius: 9999px;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s ease;
    letter-spacing: 0.02em;
    border: none;
    cursor: pointer;
  }

  .cart-page__empty-btn:hover {
    background-color: var(--color-accent-hover);
    transform: translateY(-2px);
  }

  /* Layout em duas colunas */
  .cart-page__layout {
    display: grid;
    grid-template-columns: 1.8fr 1fr;
    gap: 50px;
    align-items: start;
  }

  /* Barra de Frete Grátis */
  .cart-page__shipping-progress-container {
    background-color: #faf7f4;
    padding: 1.5rem;
    border-radius: 12px;
    margin-bottom: 2.5rem;
  }

  .cart-page__shipping-msg {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-foreground);
    margin-bottom: 0.875rem;
  }

  .cart-page__shipping-msg svg {
    stroke: var(--color-accent);
  }

  .cart-page__shipping-bar {
    width: 100%;
    height: 4px;
    background-color: #e8dfd8;
    border-radius: 9999px;
    overflow: hidden;
  }

  .cart-page__shipping-progress {
    height: 100%;
    background-color: var(--color-accent);
    border-radius: 9999px;
    transition: width 0.5s ease;
  }

  /* Itens do Carrinho */
  .cart-page__items {
    border-top: none;
  }

  .cart-page__item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid #f0eae4;
  }

  .cart-page__item:last-child {
    border-bottom: 1px solid #f0eae4;
  }

  .cart-page__item-image-wrapper {
    width: 120px;
    height: 145px;
    flex-shrink: 0;
    border-radius: 12px;
    overflow: hidden;
    background-color: #faf7f4;
  }

  .cart-page__item-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-page__item-info {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cart-page__item-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .cart-page__item-title {
    font-size: 1.125rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-foreground);
    transition: color 0.2s ease;
  }

  .cart-page__item-title:hover {
    color: var(--color-accent);
  }

  .cart-page__item-variant {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .cart-page__item-price {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-foreground);
    margin: 0;
  }

  .cart-page__item-remove-wrapper {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .cart-page__quantity {
    display: flex;
    align-items: center;
    border: 1px solid #e0d8cf;
    border-radius: 9999px;
    overflow: hidden;
    background-color: #fff;
    width: 100px;
    height: 38px;
    margin-top: 0.75rem;
  }

  .cart-page__qty-btn {
    border: none;
    background: transparent;
    width: 32px;
    height: 100%;
    cursor: pointer;
    font-size: 1.125rem;
    font-weight: 300;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6b6661;
    transition: color 0.2s;
    padding: 0;
  }

  .cart-page__qty-btn:hover {
    color: #1a1a1a;
  }

  .cart-page__qty-input {
    border: none;
    background: transparent;
    width: 36px;
    height: 100%;
    text-align: center;
    font-size: 0.9375rem;
    font-weight: 500;
    color: #1a1a1a;
    padding: 0;
    -moz-appearance: textfield;
  }

  .cart-page__qty-input::-webkit-outer-spin-button,
  .cart-page__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .cart-page__remove {
    border: none;
    background: transparent;
    cursor: pointer;
    color: var(--color-text-secondary);
    transition: color 0.2s;
    padding: 0.5rem;
  }

  .cart-page__remove:hover {
    color: #1a1a1a;
  }

  .cart-page__actions {
    margin-top: 2rem;
  }

  .cart-page__btn-continue {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: 0.75rem;
    text-decoration: none;
    border: 1px solid var(--color-accent);
    padding: 1.125rem 2rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
    background: transparent;
    transition: all 0.3s ease;
    letter-spacing: 0.05em;
  }

  .cart-page__btn-continue:hover {
    background-color: var(--color-accent);
    color: #ffffff;
    border-color: var(--color-accent);
  }

  .cart-page__btn-continue svg {
    stroke: currentColor;
    transition: transform 0.3s ease;
  }

  .cart-page__btn-continue:hover svg {
    transform: translateX(-4px);
  }

  /* Resumo lateral */
  .cart-page__summary {
    background-color: #f7f3ee;
    padding: 2.5rem;
    border-radius: 12px;
  }

  .cart-page__summary h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 0;
    margin-bottom: 2rem;
    color: var(--color-foreground);
    letter-spacing: -0.01em;
  }

  .cart-page__summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9375rem;
    color: var(--color-foreground);
    margin-bottom: 1.25rem;
  }

  .cart-page__summary-row--total {
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .cart-page__summary-divider {
    height: 1px;
    background-color: #e0d8cf;
    margin-block: 1.5rem;
  }

  .cart-page__installments {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    text-align: right;
    margin: 0 0 1rem;
    font-weight: 300;
  }

  /* Calculadora de frete estilizada */
  .shipping-calculator.cart-page__shipping-calculator {
    border: none;
    padding: 0;
    background: transparent;
    margin-bottom: 0.5rem;
  }

  .cart-page__shipping-calculator .shipping-calculator__label {
    font-size: 0.875rem;
    font-weight: 400;
    color: #6b6661;
    margin-bottom: 0.625rem;
    text-transform: none;
    letter-spacing: 0;
    display: block;
  }

  .cart-page__shipping-calculator .shipping-calculator__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 76px;
    gap: 12px;
    margin-bottom: 0.5rem;
  }

  .cart-page__shipping-calculator .shipping-calculator__input {
    min-height: 50px;
    border: 1px solid #dcd7cf;
    border-radius: 9999px;
    background: #faf8f6;
    padding: 0 1.5rem;
    font-size: 1rem;
    color: #4a4540;
    letter-spacing: 0.05em;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .cart-page__shipping-calculator .shipping-calculator__input:focus {
    border-color: var(--color-accent);
  }

  .cart-page__shipping-calculator .shipping-calculator__input::placeholder {
    color: #a69e96;
  }

  .cart-page__shipping-calculator .shipping-calculator__button {
    min-height: 50px;
    width: 76px;
    border: none;
    border-radius: 9999px;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 700;
    padding: 0;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .cart-page__shipping-calculator .shipping-calculator__button:hover {
    background-color: var(--color-accent-hover);
  }

  .cart-page__shipping-calculator .shipping-calculator__button:active {
    transform: scale(0.98);
  }

  .cart-page__shipping-calculator .shipping-calculator__message {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .cart-page__cep-link {
    display: inline-block;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    text-decoration: underline;
    cursor: pointer;
    transition: color 0.2s;
    margin-bottom: 1.5rem;
  }
  
  .cart-page__cep-link:hover {
    color: var(--color-accent);
  }

  .cart-page__btn-checkout {
    width: 100%;
    background-color: var(--color-accent);
    color: #fff;
    border: none;
    padding: 1.125rem;
    border-radius: 9999px;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 1rem;
    text-align: center;
  }

  .cart-page__btn-checkout:hover {
    background-color: var(--color-accent-hover);
    transform: translateY(-2px);
  }

  .cart-page__secure-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .cart-page__secure-badge svg {
    width: 14px;
    height: 14px;
    stroke: var(--color-text-secondary);
  }

  /* Vitrine de Recomendações */
  .cart-recommendations {
    margin-top: 5rem;
  }

  .cart-recommendations__heading {
    text-align: center;
    font-size: 1.75rem;
    font-weight: 500;
    color: var(--color-foreground);
    margin-bottom: 3rem;
  }

  .cart-recommendations__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 24px;
  }

  @media (max-width: 1024px) {
    .cart-page__layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    
    .cart-recommendations__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .cart-page-section {
      padding-block: 2.5rem;
    }

    .cart-page__header {
      margin-bottom: 1.5rem;
    }

    .cart-page__item {
      gap: 1rem;
      padding-block: 1.5rem;
    }

    .cart-page__item-image-wrapper {
      width: 90px;
      height: 110px;
    }

    .cart-page__item-info {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }

    .cart-page__summary {
      padding: 1.5rem;
    }

    .cart-recommendations__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 1rem;
      margin-inline: calc(var(--page-margin, 1.25rem) * -1);
      padding-inline: var(--page-margin, 1.25rem);
      gap: 1rem;
