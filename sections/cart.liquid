{% javascript %}
  function initRecommendations() {
    const productRecommendationsSection = document.querySelector('.product-recommendations');
    if (!productRecommendationsSection) return;

    const handleIntersection = (entries, observer) => {
      if (!entries[0].isIntersecting) return;
      observer.unobserve(productRecommendationsSection);
      const url = productRecommendationsSection.dataset.url;
      fetch(url)
        .then(response => response.text())
        .then(text => {
          const html = document.createElement('div');
          html.innerHTML = text;
          const recommendations = html.querySelector('.product-recommendations');
          if (recommendations && recommendations.innerHTML.trim().length > 0) {
            productRecommendationsSection.innerHTML = recommendations.innerHTML;
          }
        })
        .catch(e => console.error(e));
    };

    const observer = new IntersectionObserver(handleIntersection, {rootMargin: '0px 0px 200px 0px'});
    observer.observe(productRecommendationsSection);
  }

  function initShippingInterceptor() {
    // Interceptar quando o cálculo do frete atualiza para atualizar dinamicamente o resumo
    document.body.addEventListener('submit', function(event) {
      const form = event.target.closest('[data-shipping-form]');
      if (!form) return;
      
      const ratesList = form.querySelector('[data-shipping-rates]');
      if (!ratesList) return;
      
      const observer = new MutationObserver(() => {
        const firstRatePrice = ratesList.querySelector('.shipping-calculator__price');
        const summaryShippingCost = document.querySelector('[data-cart-shipping-cost]');
        if (firstRatePrice && summaryShippingCost) {
          summaryShippingCost.textContent = firstRatePrice.textContent;
          
          // Recalcular o valor total no resumo
          const subtotalText = document.querySelector('[data-cart-subtotal]');
          const totalText = document.querySelector('[data-cart-total]');
          if (subtotalText && totalText) {
            const subtotalCents = parseInt(subtotalText.textContent.replace(/\D/g, ''), 10);
            const shippingText = firstRatePrice.textContent.trim().toLowerCase();
            let shippingCents = 0;
            if (shippingText !== 'grátis' && shippingText !== 'gratis') {
              shippingCents = parseInt(shippingText.replace(/\D/g, ''), 10);
            }
            
            const totalCents = subtotalCents + shippingCents;
            const formattedTotal = (totalCents / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            totalText.textContent = formattedTotal;
            
            // Atualizar parcelas
            const installmentsWrapper = document.querySelector('[data-cart-installments]');
            if (installmentsWrapper) {
              const installmentsCount = parseInt(installmentsWrapper.dataset.installments || 3, 10);
              const installmentVal = totalCents / installmentsCount / 100;
              const formattedInstallment = installmentVal.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
              installmentsWrapper.textContent = `ou até ${installmentsCount}x de ${formattedInstallment} sem juros`;
            }
          }
        }
      });
      
      observer.observe(ratesList, { childList: true, subtree: true });
    });
  }

  window.initCartPage = function() {
    initRecommendations();
    initShippingInterceptor();
  };

  document.addEventListener('DOMContentLoaded', function() {
    window.initCartPage();
  });
{% endjavascript %}

