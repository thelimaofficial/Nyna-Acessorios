{%- layout 'links' -%}

<div class="links-page-container" style="--links-bg-color: {{ section.settings.bg_color }}; --links-accent-color: {{ section.settings.accent_color }}; --links-text-color-on-accent: {{ section.settings.text_color_on_accent }}; --links-text-color-dark: {{ section.settings.text_color_dark }}; --links-icon-size: {{ section.settings.icon_size }}px;">
  <div class="links-content-wrapper">
    <header class="links-header">
      {%- if section.settings.logo_image != blank -%}
        <img 
          class="links-logo" 
          src="{{ section.settings.logo_image | image_url: width: 400 }}" 
          alt="{{ shop.name }}"
          width="{{ section.settings.logo_image.width }}"
          height="{{ section.settings.logo_image.height }}"
          style="--logo-width-desktop: {{ section.settings.logo_width }}px; --logo-width-mobile: {{ section.settings.logo_width_mobile }}px;"
        >
      {%- else -%}
        <div class="links-logo-text">
          <span class="logo-title">{{ section.settings.logo_text }}</span>
          <span class="logo-subtitle">{{ section.settings.logo_text_sub }}</span>
        </div>
      {%- endif -%}
      
      {%- if section.settings.subtitle != blank -%}
        <p class="links-header-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </header>

    <main class="links-main-buttons">
      {%- for block in section.blocks -%}
        {%- if block.type == 'link' -%}
          {%- assign btn_bg = section.settings.accent_color -%}
          {%- if block.settings.button_bg_color != blank and block.settings.button_bg_color != 'rgba(0,0,0,0)' -%}
            {%- assign btn_bg = block.settings.button_bg_color -%}
          {%- endif -%}
          {%- assign btn_text = section.settings.text_color_on_accent -%}
          {%- if block.settings.button_text_color != blank and block.settings.button_text_color != 'rgba(0,0,0,0)' -%}
            {%- assign btn_text = block.settings.button_text_color -%}
          {%- endif -%}
          {%- assign btn_icon_size = section.settings.icon_size -%}
          {%- if block.settings.icon_size > 0 -%}
            {%- assign btn_icon_size = block.settings.icon_size -%}
          {%- endif -%}
          <a 
            href="{{ block.settings.url | default: '#' }}" 
            class="links-button" 
            style="--btn-bg: {{ btn_bg }}; --btn-text: {{ btn_text }}; --btn-icon-size: {{ btn_icon_size }}px;" 
            {{ block.shopify_attributes }}
          >
            <span class="links-button__icon-left">
              {%- if block.settings.icon_image != blank -%}
                <img 
                  src="{{ block.settings.icon_image | image_url: width: 64, height: 64 }}" 
                  alt="{{ block.settings.icon_image.alt | default: block.settings.text }}"
                  width="{{ block.settings.icon_image.width }}"
                  height="{{ block.settings.icon_image.height }}"
                  loading="lazy"
                  class="links-button__custom-icon"
                >
              {%- elsif block.settings.custom_svg != blank -%}
                {{ block.settings.custom_svg }}
              {%- elsif block.settings.icon == 'sparkle' -%}
                <svg viewBox="0 0 24 24"><path d="M12 2L14.8 9.2L22 12L14.8 14.8L12 22L9.2 14.8L2 12L9.2 9.2L12 2Z"/></svg>
              {%- elsif block.settings.icon == 'heart' -%}
                <svg viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
              {%- elsif block.settings.icon == 'bag' -%}
                <svg viewBox="0 0 24 24"><path d="M19 6h-2c0-2.76-2.24-5-5-5S7 3.24 7 6H5c-1.1 0-1.99.9-1.99 2L3 20c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-7-3c1.66 0 3 1.34 3 3H9c0-1.66 1.34-3 3-3zm0 10c-2.76 0-5-2.24-5-5h2c0 1.66 1.34 3 3 3s3-1.34 3-3h2c0 2.76-2.24 5-5 5z"/></svg>
              {%- elsif block.settings.icon == 'gift' -%}
                <svg viewBox="0 0 24 24"><path d="M20 6h-2.18c.11-.31.18-.65.18-1 0-1.66-1.34-3-3-3-1.62 0-2.95 1.29-3 2.9L12 4.7l-.02-.18C11.95 2.92 10.62 1.63 9 1.63c-1.66 0-3 1.34-3 3 0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-5-2.37c.75 0 1.37.61 1.37 1.37s-.61 1.37-1.37 1.37-1.37-.62-1.37-1.37.62-1.37 1.37-1.37zM9 3.63c.75 0 1.37.61 1.37 1.37s-.61 1.37-1.37 1.37-1.37-.62-1.37-1.37.62-1.37 1.37-1.37zM20 19H4v-2h16v2zm0-5H4V8h7v6h2V8h7v6z"/></svg>
              {%- endif -%}
            </span>

            <span class="links-button__text">{{ block.settings.text }}</span>

            <span class="links-button__icon-right">
              <svg viewBox="0 0 24 24"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/></svg>
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </main>
  </div>
</div>

{% stylesheet %}
  .links-page-container {
    width: 100%;
    background-color: var(--links-bg-color);
    color: var(--links-text-color-dark);
    font-family: var(--font-primary--family), sans-serif;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* Content Wrapper */
  .links-content-wrapper {
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    padding: 40px 20px 20px 20px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Header */
  .links-header {
    text-align: center;
    margin-bottom: 30px;
    width: 100%;
  }
  .links-logo {
    display: block;
    margin: 0 auto 15px auto;
    height: auto;
    width: var(--logo-width-mobile);
  }
  .links-logo-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 12px;
  }
  .links-logo-text .logo-title {
    font-family: Georgia, serif;
    font-size: 48px;
    font-weight: 400;
    letter-spacing: 0.05em;
    color: var(--links-text-color-dark);
    line-height: 1.1;
  }
  .links-logo-text .logo-subtitle {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.3em;
    color: var(--links-text-color-dark);
    margin-top: 2px;
    text-transform: uppercase;
  }
  .links-header-subtitle {
    font-size: 14px;
    font-weight: 300;
    color: var(--links-text-color-dark);
    margin: 10px 0 0 0;
    letter-spacing: 0.05em;
  }

  /* Main Buttons */
  .links-main-buttons {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 25px;
  }
  .links-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 52px;
    padding: 6px 24px;
    background-color: var(--btn-bg, var(--links-accent-color));
    color: var(--btn-text, var(--links-text-color-on-accent));
    border-radius: 50px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease, box-shadow 0.2s ease;
    box-sizing: border-box;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
  }
  .links-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.1);
    filter: brightness(0.95);
  }
  .links-button__icon-left {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--btn-icon-size, var(--links-icon-size, 16px));
    height: var(--btn-icon-size, var(--links-icon-size, 16px));
    flex-shrink: 0;
  }
  .links-button__icon-right {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  .links-button__custom-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 2px;
  }
  .links-button__icon-left svg,
  .links-button__icon-right svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
    display: block;
  }
  .links-button__text {
    flex-grow: 1;
    text-align: center;
    padding: 0 10px;
    line-height: 1.2;
  }

  /* Desktop Styles */
  @media (min-width: 769px) {
    .links-logo {
      width: var(--logo-width-desktop);
    }
    .links-content-wrapper {
      padding: 50px 20px 30px 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Links - Perfil e Botões",
  "settings": [
    {
      "type": "header",
      "content": "Perfil / Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Imagem do Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Largura do Logo (Desktop)",
      "default": 180
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "min": 40,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Largura do Logo (Mobile)",
      "default": 140
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Texto do Logo (caso não envie imagem)",
      "default": "nyna"
    },
    {
      "type": "text",
      "id": "logo_text_sub",
      "label": "Subtexto do Logo (caso não envie imagem)",
      "default": "ACESSÓRIOS"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo / Descrição",
      "default": "Elegância em cada detalhe."
    },
    {
      "type": "header",
      "content": "Cores e Estilos"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fundo da Seção",
      "default": "#faf8f5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Cor Principal (Botões)",
      "default": "#B08F7A"
    },
    {
      "type": "color",
      "id": "text_color_on_accent",
      "label": "Cor do Texto sobre os Botões",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color_dark",
      "label": "Cor do Texto Principal",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 12,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Tamanho dos Ícones (Botões)",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Botão de Link",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto do Botão",
          "default": "NOVA COLEÇÃO"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link / Direcionamento"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Ícone Esquerdo",
          "options": [
            {
              "value": "sparkle",
              "label": "Estrela / Brilho"
            },
            {
              "value": "heart",
              "label": "Coração"
            },
            {
              "value": "bag",
              "label": "Sacola de Compras"
            },
            {
              "value": "gift",
              "label": "Presente"
            },
            {
              "value": "none",
              "label": "Nenhum"
            }
          ],
          "default": "sparkle"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Imagem do Ícone (opcional - sobrepõe as opções abaixo)"
        },
        {
          "type": "html",
          "id": "custom_svg",
          "label": "SVG Customizado (opcional - sobrepõe a seleção acima)"
        },
        {
          "type": "header",
          "content": "Cores Customizadas (Opcional)"
        },
        {
          "type": "color",
          "id": "button_bg_color",
          "label": "Cor de Fundo Customizada",
          "info": "Se deixada em branco, usará a cor padrão de fundo dos botões definida na seção."
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Cor do Texto Customizada",
          "info": "Se deixada em branco, usará a cor padrão do texto definida na seção."
        },
        {
          "type": "range",
          "id": "icon_size",
          "min": 0,
          "max": 64,
          "step": 2,
          "unit": "px",
          "label": "Tamanho do Ícone",
          "info": "Defina como 0 para usar o tamanho padrão da seção.",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Links - Perfil e Botões",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "text": "NOVA COLEÇÃO"
          }
        },
        {
          "type": "link",
          "settings": {
            "text": "NOVA COLEÇÃO"
          }
        },
        {
          "type": "link",
          "settings": {
            "text": "NOVA COLEÇÃO"
          }
        }
      ]
    }
  ]
}
{% endschema %}
