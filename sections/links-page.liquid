    },
    {
      "type": "text",
      "id": "top_bar_text_desktop_center",
      "label": "Texto do centro (Desktop)",
      "default": "✦ JOIAS QUE ELEVAM O ESSENCIAL ✦"
    },
    {
      "type": "header",
      "content": "Perfil / Logo"
    },
    {
      "type": "image_picker",
