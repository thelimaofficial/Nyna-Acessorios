<section class="hero full-width" aria-label="{{ section.settings.heading }}">

  {%- comment -%} Background image ─ acts as the model photo {%- endcomment -%}
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          class: 'hero__img',
          alt: section.settings.image.alt | default: section.settings.heading,
          width: 2000,
          height: 1000,
          loading: 'eager',
          fetchpriority: 'high'
      }}
    {%- else -%}
      <img
        class="hero__img"
        src="{{ 'hero-model.png' | asset_url }}"
        alt="{{ section.settings.heading }}"
        width="2000"
        height="1000"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
  </div>

  {%- comment -%} Overlay gradient {%- endcomment -%}
  <div class="hero__overlay" aria-hidden="true"></div>

  {%- comment -%} Content ─ positioned left-center {%- endcomment -%}
  <div class="hero__content">
    {%- if section.settings.subheading != blank -%}
      <p class="hero__eyebrow">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="hero__description">{{ section.settings.description }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a
        class="hero__btn"
        href="{{ section.settings.button_link | default: routes.collections_url }}"
        id="hero-cta"
      >
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>

</section>

{% stylesheet %}
  /* ── Hero wrapper ── */
  .hero {
    position: relative;
    overflow: hidden;
    min-height: var(--hero-height, 88svh);
    display: flex;
    align-items: center;
  }

  /* ── Background image ── */
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    max-width: none;
  }

  /* ── Gradient overlay ── */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to right,
      rgba(30, 22, 18, 0.62) 0%,
      rgba(30, 22, 18, 0.28) 50%,
      rgba(30, 22, 18, 0.04) 80%
    );
  }

  /* ── Content box ── */
  .hero__content {
    position: relative;
    z-index: 2;
    padding-inline: var(--page-margin, 1.25rem);
    max-width: min(42rem, calc(100% - var(--page-margin, 1.25rem) * 2));
    margin-inline-start: max(var(--page-margin, 1.25rem), calc((100% - var(--page-width, 90rem)) / 2 + var(--page-margin, 1.25rem)));
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    animation: hero-fade-in 0.9s ease both;
  }

  @keyframes hero-fade-in {
    from { opacity: 0; transform: translateY(1.5rem); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Eyebrow ── */
  .hero__eyebrow {
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(232, 213, 176, 0.9);
    font-weight: 500;
  }

  /* ── Heading ── */
  .hero__heading {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 300;
    line-height: 1.15;
    color: #faf5ee;
    letter-spacing: 0.01em;
  }

  /* ── Description ── */
  .hero__description {
    font-size: clamp(0.875rem, 1.5vw, 1rem);
    line-height: 1.65;
    color: rgba(250, 245, 238, 0.8);
    max-width: 32ch;
    font-weight: 300;
  }

  /* ── CTA Button ── */
  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    padding: 0.75rem 2rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: #2c2420;
    background-color: #e8d5b0;
    border: 1px solid #e8d5b0;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    border-radius: 2px;
  }

  .hero__btn:hover {
    background-color: transparent;
    color: #e8d5b0;
    border-color: #e8d5b0;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .hero {
      min-height: 75svh;
      align-items: flex-end;
    }

    .hero__overlay {
      background: linear-gradient(
        to top,
        rgba(30, 22, 18, 0.72) 0%,
        rgba(30, 22, 18, 0.1) 60%
      );
    }

    .hero__content {
      margin-inline-start: 0;
      max-width: 100%;
      padding-inline: var(--page-margin, 1.25rem);
      padding-bottom: 3rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Eyebrow text",
      "default": "NYNA Acessórios"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Elegância em cada detalhe"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Acessórios que traduzem feminilidade moderna de forma leve e sofisticada."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Descubra"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
