<section class="instagram-feed section-{{ section.id }}" aria-label="{{ section.settings.heading }}">
  <div class="instagram-feed__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="instagram-feed__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="instagram-feed__content">
      {%- if section.settings.custom_html != blank -%}
        <div class="instagram-feed__html-embed">
          {{ section.settings.custom_html }}
        </div>
      {%- endif -%}
      
      {%- assign manual_images = section.blocks | where: "type", "image" -%}
      {%- if manual_images.size > 0 -%}
        <div class="instagram-feed__manual-grid">
          {%- for block in manual_images -%}
            <div class="instagram-feed__image-wrapper" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: class: 'instagram-feed__image', loading: 'lazy' }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg instagram-feed__image' }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_button and section.settings.button_link != blank -%}
      <div class="instagram-feed__button-wrapper">
        <a href="{{ section.settings.button_link }}" target="_blank" rel="noopener" class="instagram-feed__button">
          {{ section.settings.button_label | default: 'VER MAIS NO INSTAGRAM' }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .instagram-feed {
    padding-block: clamp(4rem, 8vw, 6rem);
  }

  .instagram-feed__container {
    max-width: var(--page-width, 100rem);
    margin-inline: auto;
    padding-inline: var(--page-margin, 1.25rem);
  }

  .instagram-feed__heading {
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 400;
    line-height: 1.15;
    color: var(--color-foreground);
    margin-bottom: clamp(2rem, 4vw, 3rem);
    letter-spacing: 0;
  }

  .instagram-feed__content {
    width: 100%;
  }

  .instagram-feed__html-embed {
    width: 100%;
  }

  /* Manual Grid Fallback */
  .instagram-feed__manual-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .instagram-feed__image-wrapper {
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .instagram-feed__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .instagram-feed__image-wrapper:hover .instagram-feed__image {
    transform: scale(1.05);
  }

  @media (max-width: 990px) {
    .instagram-feed__manual-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .instagram-feed__button-wrapper {
    display: flex;
    justify-content: center;
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .instagram-feed__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 2.5rem;
    height: 3rem;
    font-family: var(--font-primary--family), sans-serif;
    font-size: clamp(0.8125rem, 1.5vw, 0.875rem);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-background, #ffffff);
    background-color: var(--color-accent, #b69f8c);
    border: none;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .instagram-feed__button:hover {
    background-color: var(--color-accent-hover, #a38a77);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px color-mix(in srgb, var(--color-accent, #b69f8c) 15%, transparent);
  }

  .instagram-feed__button:active {
    transform: translateY(0);
    box-shadow: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Instagram Feed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "@bynyna"
    },
    {
      "type": "html",
      "id": "custom_html",
      "label": "Instafeed HTML / Embed code",
      "info": "Cole aqui o código fornecido pelo app Instafeed (ex: <div id='insta-feed'></div>). Se preenchido, ele será renderizado. Você também pode adicionar Blocos de Imagem abaixo para uma versão manual.",
      "default": "<div id=\"insta-feed\"></div>"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Mostrar botão",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão",
      "default": "VER MAIS NO INSTAGRAM"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Link do botão",
      "default": "https://instagram.com/bynyna"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "image",
      "name": "Manual Image",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Instagram Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Feed",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
