<section class="instagram-feed section-{{ section.id }}" aria-label="{{ section.settings.heading }}">
  <div class="instagram-feed__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="instagram-feed__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="instagram-feed__content">
      {%- if section.settings.custom_html != blank -%}
        <div class="instagram-feed__html-embed">
          {{ section.settings.custom_html }}
        </div>
      {%- endif -%}
      
      {%- assign manual_images = section.blocks | where: "type", "image" -%}
      {%- if manual_images.size > 0 -%}
        <div class="instagram-feed__manual-grid">
          {%- for block in manual_images -%}
            <div class="instagram-feed__image-wrapper" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: class: 'instagram-feed__image', loading: 'lazy' }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg instagram-feed__image' }}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .instagram-feed {
    padding-block: clamp(4rem, 8vw, 6rem);
  }

  .instagram-feed__container {
    max-width: var(--page-width, 100rem); /* Wider for images */
    margin-inline: auto;
    padding-inline: var(--page-margin, 1.25rem);
  }

  .instagram-feed__heading {
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 400;
    line-height: 1.15;
    color: var(--color-foreground);
    margin-bottom: clamp(2rem, 4vw, 3rem);
    letter-spacing: 0;
  }

  .instagram-feed__content {
    width: 100%;
  }

  .instagram-feed__html-embed {
    width: 100%;
  }

  /* Manual Grid Fallback */
  .instagram-feed__manual-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem; /* Small gap like in the image */
  }

  .instagram-feed__image-wrapper {
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .instagram-feed__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .instagram-feed__image-wrapper:hover .instagram-feed__image {
    transform: scale(1.05);
  }

  @media (max-width: 990px) {
    .instagram-feed__manual-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Instagram Feed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "@bynyna"
    },
    {
      "type": "html",
      "id": "custom_html",
      "label": "Instafeed HTML / Embed code",
      "info": "Cole aqui o código fornecido pelo app Instafeed (ex: <div id='insta-feed'></div>). Se preenchido, ele será renderizado. Você também pode adicionar Blocos de Imagem abaixo para uma versão manual.",
      "default": "<div id=\"insta-feed\"></div>"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "image",
      "name": "Manual Image",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Instagram Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Feed",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
