<section class="collection-banner section-{{ section.id }}" aria-label="{{ section.settings.title }}">
  <div class="collection-banner__inner">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: class: 'collection-banner__image', loading: 'eager' }}
    {%- else -%}
      <div class="collection-banner__placeholder"></div>
    {%- endif -%}
    
    <div class="collection-banner__content">
      <h1 class="collection-banner__title">{{ section.settings.title | default: collection.title }}</h1>
    </div>
  </div>
</section>

{% stylesheet %}
  .collection-banner {
    width: 100%;
    margin-bottom: 0;
  }

  .collection-banner__inner {
    position: relative;
    width: 100%;
    height: clamp(260px, 29vw, 360px);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    background-color: var(--color-background-secondary);
    overflow: hidden;
  }

  .collection-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .collection-banner__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: var(--color-background-secondary);
    z-index: 0;
  }

  .collection-banner__content {
    position: relative;
    z-index: 1;
    width: min(100%, var(--page-width, 90rem));
    margin-inline: auto;
    padding-inline: clamp(4rem, 18vw, 19rem) var(--page-margin, 1.25rem);
    text-align: left;
  }

  .collection-banner__title {
    font-family: 'Inter', sans-serif;
    color: var(--color-foreground);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0;
    text-shadow: none;
  }

  @media (max-width: 768px) {
    .collection-banner__inner {
      height: 260px;
    }

    .collection-banner__content {
      padding-inline: var(--page-margin, 1.25rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "banner",
      "info": "Leave empty to use the collection title."
    }
  ],
  "presets": [
    {
      "name": "Collection Banner"
    }
  ]
}
{% endschema %}
