{%- assign banner_image = nil -%}
{%- assign banner_title = nil -%}
{%- assign show_title = section.settings.show_title -%}

{%- for block in section.blocks -%}
  {%- if block.type == 'collection_customization' -%}
    {%- assign block_collection_handle = block.settings.collection.handle | default: block.settings.collection -%}
    {%- if block_collection_handle == collection.handle -%}
      {%- if block.settings.image != blank -%}
        {%- assign banner_image = block.settings.image -%}
      {%- endif -%}
      {%- if block.settings.title != blank -%}
        {%- assign banner_title = block.settings.title -%}
      {%- else -%}
        {%- assign banner_title = collection.title -%}
      {%- endif -%}
      {%- assign show_title = block.settings.show_title -%}
      {%- break -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- if banner_image == nil -%}
  {%- if collection.image != blank -%}
    {%- assign banner_image = collection.image -%}
  {%- elsif section.settings.image != blank -%}
    {%- assign banner_image = section.settings.image -%}
  {%- endif -%}
{%- endif -%}

{%- if banner_title == nil -%}
  {%- assign banner_title = section.settings.title | default: collection.title -%}
{%- endif -%}

<section class="collection-banner section-{{ section.id }}" aria-label="{{ banner_title }}">
  <div class="collection-banner__inner">
    {%- if banner_image != blank -%}
      {{ banner_image | image_url: width: 2000 | image_tag: class: 'collection-banner__image', loading: 'eager' }}
    {%- else -%}
      <div class="collection-banner__placeholder"></div>
    {%- endif -%}
    
    {%- if show_title -%}
      <div class="collection-banner__content">
        <h1 class="collection-banner__title">{{ banner_title }}</h1>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .collection-banner {
    width: 100%;
    margin-bottom: 0;
  }

  .collection-banner__inner {
    position: relative;
    width: 100%;
    height: clamp(260px, 29vw, 360px);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    background-color: var(--color-background-secondary);
    overflow: hidden;
  }

  .collection-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .collection-banner__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: var(--color-background-secondary);
    z-index: 0;
  }

  .collection-banner__content {
    position: relative;
    z-index: 1;
    width: min(100%, var(--page-width, 90rem));
    margin-inline: auto;
    padding-inline: clamp(4rem, 18vw, 19rem) var(--page-margin, 1.25rem);
    text-align: left;
  }

  .collection-banner__title {
    font-family: 'Inter', sans-serif;
    color: var(--color-foreground);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0;
    text-shadow: none;
  }

  @media (max-width: 768px) {
    .collection-banner__inner {
      height: 260px;
    }

    .collection-banner__content {
      padding-inline: var(--page-margin, 1.25rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show text on banner",
      "default": true
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "info": "Leave empty to use the collection title."
    }
  ],
  "blocks": [
    {
      "type": "collection_customization",
      "name": "Coleção Personalizada",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Coleção"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Banner da Coleção"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título Personalizado",
          "info": "Deixe em branco para usar o título original da coleção."
        },
        {
          "type": "checkbox",
          "id": "show_title",
          "label": "Mostrar título no banner",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Banner"
    }
  ]
}
{% endschema %}
