{%- if section.settings.show_announcement -%}
  <div class="announcement-bar full-width" role="complementary" aria-label="{{ 'accessibility.announcement_bar' | t }}">
    <div class="announcement-bar__track" aria-hidden="true">
      {%- assign announcement_text = section.settings.text -%}
      {%- for i in (1..6) -%}
        <span class="announcement-bar__item">{{ announcement_text }}</span>
        <span class="announcement-bar__separator" aria-hidden="true">•</span>
      {%- endfor -%}
      {%- for i in (1..6) -%}
        <span class="announcement-bar__item">{{ announcement_text }}</span>
        <span class="announcement-bar__separator" aria-hidden="true">•</span>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .announcement-bar {
    background-color: var(--announcement-bg, #b08f7a);
    color: var(--announcement-color, #ffffffff);
    overflow: hidden;
    height: 2.25rem;
    display: flex;
    align-items: center;
  }

  .announcement-bar__track {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    white-space: nowrap;
    animation: announcement-scroll 28s linear infinite;
    will-change: transform;
  }

  .announcement-bar__item {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .announcement-bar__separator {
    font-size: 0.5rem;
    opacity: 0.6;
  }

  @keyframes announcement-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .announcement-bar__track {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement Bar",
  "class": "announcement-bar-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "DELICADEZA • SOFISTICAÇÃO • ATEMPORALIDADE"
    }
  ]
}
{% endschema %}
