<footer class="site-footer full-width">
  <div class="footer-top">
    <div class="footer-brand">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 800 }}" alt="{{ shop.name }}" width="{{ section.settings.logo_width }}" height="auto" loading="lazy" class="footer-logo-img">
      {%- else -%}
        <img src="{{ 'logo-nyna-footer.svg' | asset_url }}" alt="{{ shop.name }}" width="{{ section.settings.logo_width }}" height="auto" loading="lazy" class="footer-logo-img">
      {%- endif -%}

      <div class="footer-socials">
        {%- if section.settings.social_whatsapp_link != blank -%}
          <a href="{{ section.settings.social_whatsapp_link }}" target="_blank" rel="noopener" class="social-icon">
            <img src="{{ 'wpp-footer.svg' | asset_url }}" alt="WhatsApp" width="52" height="52" loading="lazy">
          </a>
        {%- endif -%}
        {%- if section.settings.social_instagram_link != blank -%}
          <a href="{{ section.settings.social_instagram_link }}" target="_blank" rel="noopener" class="social-icon">
            <img src="{{ 'instagram-footer.svg' | asset_url }}" alt="Instagram" width="52" height="52" loading="lazy">
          </a>
        {%- endif -%}
        {%- if section.settings.social_tiktok_link != blank -%}
          <a href="{{ section.settings.social_tiktok_link }}" target="_blank" rel="noopener" class="social-icon">
            <img src="{{ 'tiktok-footer.svg' | asset_url }}" alt="TikTok" width="52" height="52" loading="lazy">
          </a>
        {%- endif -%}
        {%- if section.settings.social_email_link != blank -%}
          <a href="mailto:{{ section.settings.social_email_link }}" class="social-icon">
            <img src="{{ 'email-footer.svg' | asset_url }}" alt="E-mail" width="52" height="52" loading="lazy">
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="footer-menus">
      {%- for i in (1..3) -%}
        {%- capture menu_id -%}menu_{{ i }}{%- endcapture -%}
        {%- assign menu = section.settings[menu_id] -%}
        {%- if menu != blank -%}
          <div class="footer-menu">
            <h3>{{ menu.title }}</h3>
            <ul>
              {%- for link in menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-copyright">
      &copy; 2026 nyna. Todos os direitos reservados.
    </div>

    <div class="footer-payment">
      {%- if section.settings.show_payment_icons -%}
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag }}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="footer-developer">
      Desenvolvido por <a href="https://www.usealwer.com" target="_blank" rel="noopener">Alwer</a>
    </div>
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    padding: 100px 8% 50px;
    font-family: 'Inter', sans-serif;
    margin: 0;
    width: 100%;
    border-radius: 30px 30px 0 0;
    overflow: hidden;
  }
  .site-footer a {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .site-footer a:hover {
    opacity: 0.8;
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 3fr;
    max-width: 1400px;
    margin: 0 auto;
    gap: 80px;
  }
  .footer-brand {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }
  .footer-logo-img {
    max-width: 100%;
    height: auto;
    display: block;
  }
  .footer-socials {
    display: flex;
    gap: 20px;
    margin-top: 40px;
  }
  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    transition: transform 0.2s, opacity 0.2s;
  }
  .social-icon svg,
  .social-icon img {
    width: 52px;
    height: 52px;
    display: block;
  }
  .social-icon:hover {
    transform: none;
  }
  .footer-menus {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }
  .footer-menu {
    display: flex;
    flex-direction: column;
  }
  .footer-menu h3 {
    font-size: 2.2rem;
    margin-top: 0;
    margin-bottom: 28px;
    font-weight: 300;
    letter-spacing: 0.05em;
  }
  .footer-menu ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-menu li {
    margin-bottom: 18px;
    font-size: 1.35rem;
    font-weight: 300;
    opacity: 0.85;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1400px;
    margin: 100px auto 0;
    padding-top: 30px;
    font-size: 1.15rem;
    font-weight: 300;
    flex-wrap: wrap;
    gap: 30px;
  }
  .footer-copyright {
    opacity: 0.85;
  }
  .footer-payment {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .footer-payment svg,
  .footer-payment img {
    height: 32px;
    width: auto;
  }
  .footer-developer {
    opacity: 0.85;
  }
  .footer-developer a {
    font-weight: 600;
  }
  @media (max-width: 1024px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }
  @media (max-width: 768px) {
    .site-footer {
      padding: 60px 5% 30px;
    }
    .footer-menus {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .footer-menu h3 {
      font-size: 1.8rem;
      margin-bottom: 20px;
    }
    .footer-menu li {
      font-size: 1.15rem;
      margin-bottom: 12px;
    }
    .footer-bottom {
      flex-direction: column;
      text-align: center;
      margin-top: 60px;
      gap: 24px;
    }
  }
{% endstylesheet %}

<style>
  #shopify-section-{{ section.id }} .site-footer {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .social-icon {
    background-color: transparent;
    color: {{ section.settings.background_color }};
  }
  #shopify-section-{{ section.id }} .footer-logo-img {
    width: {{ section.settings.logo_width }}px;
  }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor de Fundo",
      "default": "#b69f8c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do Texto",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Imagem da Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Largura da Logo",
      "default": 360
    },
    {
      "type": "header",
      "content": "Menus"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu 1"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu 2"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Menu 3"
    },
    {
      "type": "header",
      "content": "Redes Sociais"
    },
    {
      "type": "url",
      "id": "social_whatsapp_link",
      "label": "Link WhatsApp"
    },
    {
      "type": "url",
      "id": "social_instagram_link",
      "label": "Link Instagram"
    },
    {
      "type": "url",
      "id": "social_tiktok_link",
      "label": "Link TikTok"
    },
    {
      "type": "text",
      "id": "social_email_link",
      "label": "E-mail de Contato"
    },
    {
      "type": "header",
      "content": "Pagamento"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Mostrar ícones de pagamento",
      "default": true
    }
  ]
}
{% endschema %}
