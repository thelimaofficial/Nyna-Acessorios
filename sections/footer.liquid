<footer class="site-footer full-width">
  <div class="footer-top">
    <div class="footer-brand">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 800 }}" alt="{{ shop.name }}" width="{{ section.settings.logo_width }}" height="auto" loading="lazy" class="footer-logo-img">
      {%- else -%}
        <img src="{{ 'logo-nyna-footer.svg' | asset_url }}" alt="{{ shop.name }}" width="{{ section.settings.logo_width }}" height="auto" loading="lazy" class="footer-logo-img">
      {%- endif -%}

      <div class="footer-socials">
        {%- if section.settings.social_whatsapp_link != blank -%}
          <a href="{{ section.settings.social_whatsapp_link }}" target="_blank" rel="noopener" class="social-icon">
