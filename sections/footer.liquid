          </a>
        {%- endif -%}
        {%- if section.settings.social_instagram_link != blank -%}
          <a href="{{ section.settings.social_instagram_link }}" target="_blank" rel="noopener" class="social-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.203 4.358 2.618 6.78 6.98 6.98 1.28.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm3.98-10.871a1.44 1.44 0 11-2.88 0 1.44 1.44 0 012.88 0z"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.social_tiktok_link != blank -%}
          <a href="{{ section.settings.social_tiktok_link }}" target="_blank" rel="noopener" class="social-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 2.23-1.04 4.38-2.61 5.88-1.57 1.51-3.72 2.3-5.94 2.22-2.31-.08-4.48-1.12-5.94-2.85-1.45-1.72-2.14-4.04-1.89-6.27.24-2.22 1.34-4.24 3.03-5.61 1.68-1.37 3.92-2.04 6.11-1.86v4.06c-1.39-.1-2.78.29-3.88 1.05-1.11.75-1.87 1.93-2.07 3.25-.19 1.32.17 2.69.96 3.75.79 1.05 2.01 1.72 3.32 1.8.19.01.38.01.57.01 1.31-.04 2.54-.58 3.44-1.49.9-.9 1.37-2.13 1.4-3.41.02-4.5.01-9.01.02-13.51h-.01z"/></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.social_email_link != blank -%}
          <a href="mailto:{{ section.settings.social_email_link }}" class="social-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="footer-menus">
      {%- for i in (1..3) -%}
        {%- capture menu_id -%}menu_{{ i }}{%- endcapture -%}
        {%- assign menu = section.settings[menu_id] -%}
        {%- if menu != blank -%}
          <div class="footer-menu">
            <h3>{{ menu.title }}</h3>
            <ul>
              {%- for link in menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-copyright">
      &copy; 2026 nyna. Todos os direitos reservados.
    </div>

    <div class="footer-payment">
      {%- if section.settings.show_payment_icons -%}
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag }}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="footer-developer">
      Desenvolvido por <a href="https://www.usealwer.com" target="_blank" rel="noopener">Alwer</a>
    </div>
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    padding: 100px 8% 50px;
    font-family: 'Inter', sans-serif;
    margin: 0;
    width: 100%;
    border-radius: 30px 30px 0 0;
    overflow: hidden;
  }
  .site-footer a {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .site-footer a:hover {
    opacity: 0.8;
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 3fr;
    max-width: 1400px;
    margin: 0 auto;
    gap: 80px;
  }
  .footer-brand {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }
  .footer-logo-img {
    max-width: 100%;
    height: auto;
    display: block;
  }
  .footer-socials {
    display: flex;
    gap: 20px;
    margin-top: 40px;
  }
  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    transition: transform 0.2s, opacity 0.2s;
  }
  .social-icon svg {
    width: 26px;
    height: 26px;
  }
  .social-icon:hover {
    transform: translateY(-3px);
  }
  .footer-menus {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }
  .footer-menu {
    display: flex;
    flex-direction: column;
  }
  .footer-menu h3 {
    font-size: 2.2rem;
    margin-top: 0;
    margin-bottom: 28px;
    font-weight: 300;
    letter-spacing: 0.05em;
  }
  .footer-menu ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .footer-menu li {
    margin-bottom: 18px;
    font-size: 1.35rem;
    font-weight: 300;
    opacity: 0.85;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1400px;
    margin: 100px auto 0;
    padding-top: 30px;
    font-size: 1.15rem;
    font-weight: 300;
    flex-wrap: wrap;
    gap: 30px;
  }
  .footer-copyright {
    opacity: 0.85;
  }
  .footer-payment {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .footer-payment svg,
  .footer-payment img {
    height: 32px;
    width: auto;
  }
  .footer-developer {
    opacity: 0.85;
  }
  .footer-developer a {
    font-weight: 600;
  }
  @media (max-width: 1024px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }
  @media (max-width: 768px) {
    .site-footer {
      padding: 60px 5% 30px;
    }
    .footer-menus {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .footer-menu h3 {
      font-size: 1.8rem;
      margin-bottom: 20px;
    }
    .footer-menu li {
      font-size: 1.15rem;
      margin-bottom: 12px;
    }
    .footer-bottom {
      flex-direction: column;
      text-align: center;
      margin-top: 60px;
      gap: 24px;
    }
  }
{% endstylesheet %}

<style>
  #shopify-section-{{ section.id }} .site-footer {
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .social-icon {
    background-color: {{ section.settings.text_color }};
    color: {{ section.settings.background_color }};
  }
  #shopify-section-{{ section.id }} .footer-logo-img {
    width: {{ section.settings.logo_width }}px;
  }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Cor de Fundo",
      "default": "#b69f8c"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do Texto",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Imagem da Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Largura da Logo",
      "default": 360
    },
    {
      "type": "header",
      "content": "Menus"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu 1"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu 2"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Menu 3"
    },
    {
      "type": "header",
      "content": "Redes Sociais"
    },
    {
      "type": "url",
      "id": "social_whatsapp_link",
      "label": "Link WhatsApp"
    },
    {
      "type": "url",
      "id": "social_instagram_link",
      "label": "Link Instagram"
    },
    {
      "type": "url",
      "id": "social_tiktok_link",
      "label": "Link TikTok"
    },
    {
      "type": "text",
      "id": "social_email_link",
      "label": "E-mail de Contato"
    },
    {
      "type": "header",
      "content": "Pagamento"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Mostrar ícones de pagamento",
      "default": true
    }
  ]
}
{% endschema %}
