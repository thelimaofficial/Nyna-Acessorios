<section class="product-description section-{{ section.id }}" aria-label="{{ section.settings.heading }}">
  <div class="product-description__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="product-description__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="product-description__content">
      {%- if product.description != blank -%}
        {{ product.description }}
      {%- else -%}
        <p>A descrição deste produto não está disponível no momento.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .product-description {
    padding-block: clamp(1.75rem, 4vw, 2.75rem) clamp(1.25rem, 3vw, 2rem);
    background-color: var(--color-background);
  }

  .product-description__container {
    max-width: 64rem;
    margin-inline: auto;
    padding-inline: var(--page-margin, 1.25rem);
  }

  .product-description__heading {
    text-align: left;
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 400;
    color: var(--color-foreground);
    margin-bottom: 0.75rem;
  }

  .product-description__content {
    max-width: none;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.5;
    text-align: left;
  }

  .product-description__content p {
    margin-bottom: 1rem;
  }
  
  .product-description__content p:last-child {
    margin-bottom: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Description",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Descrição"
    }
  ],
  "presets": [
    {
      "name": "Product Description"
    }
  ]
}
{% endschema %}
