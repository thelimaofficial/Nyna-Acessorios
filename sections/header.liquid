<header
  class="site-header full-width"
  role="banner"
  style="
    --header-bg: {{ section.settings.header_bg_color }};
    --header-text: {{ section.settings.header_text_color }};
    --header-border: {{ section.settings.header_border_color }};
    --cart-badge-bg: {{ section.settings.cart_badge_bg }};
    --cart-badge-text: {{ section.settings.cart_badge_text }};
    --search-width: {{ section.settings.search_bar_width }}%;
    --icon-size: {{ section.settings.icon_size }}px;
    --font-size: {{ section.settings.font_size }}px;
  "
>
  <div class="site-header__inner">
    {%- comment -%} ── Mobile Left controls (hamburger + search) ── {%- endcomment -%}
    <div class="site-header__mobile-left">
      <button
        type="button"
        class="site-header__hamburger"
        aria-label="Abrir menu"
        aria-expanded="false"
        data-mobile-menu-open
      >
        {{ 'hamburger.svg' | inline_asset_content }}
      </button>

      <button
        type="button"
        class="site-header__icon-btn"
        aria-label="{{ 'accessibility.search' | t }}"
        data-search-open
      >
        {{ 'icon-busca.svg' | inline_asset_content }}
      </button>
    </div>

    {%- comment -%} ── Left navigation ── {%- endcomment -%}
    <nav class="site-header__nav site-header__nav--left" aria-label="{{ 'accessibility.nav_left' | t }}">
      {%- for link in section.settings.menu.links -%}
        {%- if forloop.last == false -%}
          {%- assign is_mega_menu = false -%}
          {%- assign handle_check = link.title | handleize -%}
          {%- if handle_check == 'joias' and linklists['menu-joias'].links.size > 0 -%}
            {%- assign is_mega_menu = true -%}
          {%- endif -%}

          {%- assign is_active = link.active -%}
          {%- if is_mega_menu -%}
            {%- if collection.handle == 'joias' -%}
              {%- assign is_active = true -%}
            {%- else -%}
              {%- for child_link in linklists['menu-joias'].links -%}
                {%- if request.path == child_link.url or collection.url == child_link.url or child_link.active -%}
                  {%- assign is_active = true -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endif -%}

          <div
            class="site-header__nav-item"
            {% if is_mega_menu %}
              data-mega-menu-trigger
            {% endif %}
          >
            <a
              class="site-header__nav-link"
              href="{% if handle_check == 'joias' %}/collections/joias{% else %}{{ link.url }}{% endif %}"
              {% if is_active %}
                aria-current="page"
              {% endif %}
              {% if is_mega_menu %}
                aria-haspopup="true" aria-expanded="false"
              {% endif %}
            >
              {{ link.title }}
            </a>

            {%- if is_mega_menu -%}
              <div class="mega-menu" aria-hidden="true" data-mega-menu>
                <div class="mega-menu__inner">
                  <div class="mega-menu__list">
                    {%- for child_link in linklists['menu-joias'].links -%}
                      <a href="{{ child_link.url }}" class="mega-menu__link">{{ child_link.title }}</a>
                    {%- endfor -%}
                  </div>
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    {%- comment -%} ── Logo (center) ── {%- endcomment -%}
    <a class="site-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 320
          | image_tag: width: section.settings.logo_width, alt: section.settings.logo.alt
          | default: shop.name, loading: 'eager'
        }}
      {%- else -%}
        <img
          src="{{ 'logo-nyna.svg' | asset_url }}"
          alt="{{ shop.name }}"
          width="{{ section.settings.logo_width }}"
          height="48"
          style="width: {{ section.settings.logo_width }}px; height: auto;"
          loading="eager"
        >
      {%- endif -%}
    </a>

    {%- comment -%} ── Right navigation + icons ── {%- endcomment -%}
    <div class="site-header__nav site-header__nav--right">
      {%- for link in section.settings.menu.links -%}
        {%- if forloop.last -%}
          <div class="site-header__nav-item">
            <a
              class="site-header__nav-link"
              href="{{ link.url }}"
              {% if link.active %}
                aria-current="page"
              {% endif %}
            >
              {{ link.title }}
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div class="site-header__icons">
        <button
          type="button"
          class="site-header__icon-btn"
          aria-label="{{ 'accessibility.search' | t }}"
          data-search-open
        >
          {{ 'icon-busca.svg' | inline_asset_content }}
        </button>

        {%- if shop.customer_accounts_enabled -%}
          <shopify-account
            class="site-header__icon-btn site-header__account"
            menu="{{ section.settings.customer_account_menu }}"
          >
            <span
              slot="signed-out-avatar"
              class="site-header__account-avatar"
              aria-label="{{ 'accessibility.account' | t }}"
            >
              {{ 'icon-user.svg' | inline_asset_content }}
            </span>
          </shopify-account>
        {%- endif -%}

        <a
          href="{{ routes.cart_url }}"
          class="site-header__icon-btn site-header__cart"
          aria-label="{{ 'accessibility.cart' | t: count: cart.item_count }}"
          data-cart-open
        >
          {%- if cart.item_count > 0 -%}
            <span class="site-header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
          {%- endif -%}
          {{ 'icon-cart.svg' | inline_asset_content }}
        </a>
      </div>

      {%- comment -%} ── Expandable search ── {%- endcomment -%}
      <predictive-search class="search-bar" data-search-overlay aria-hidden="true">
        <form action="{{ routes.search_url }}" method="get" class="search-bar__form" role="search">
          <span class="search-bar__icon search-bar__icon--static" aria-hidden="true">
            {{ 'icon-busca.svg' | inline_asset_content }}
          </span>
          <input
            type="search"
            name="q"
            class="search-bar__input"
            placeholder="{{ section.settings.search_placeholder }}"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            data-search-input
            role="combobox"
            aria-expanded="false"
            aria-owns="predictive-search-results"
            aria-controls="predictive-search-results"
            aria-haspopup="listbox"
            aria-autocomplete="list"
          >
          <input type="hidden" name="options[prefix]" value="last">
          <button
            type="button"
            class="search-bar__icon search-bar__close"
            aria-label="Fechar busca"
            data-search-close
          >
            {{ 'icon-x.svg' | inline_asset_content }}
          </button>
        </form>

        <div class="predictive-search__dropdown" tabindex="-1" data-predictive-search>
          <!-- Results will be loaded here -->
        </div>
      </predictive-search>
    </div>
  </div>
</header>

{%- comment -%} ── Mobile Navigation Drawer ── {%- endcomment -%}
<div class="mobile-drawer__overlay" data-mobile-menu-overlay aria-hidden="true"></div>
<nav class="mobile-drawer" data-mobile-menu-drawer aria-label="Menu mobile" aria-hidden="true">
  <div class="mobile-drawer__header">
    <button type="button" class="mobile-drawer__close" aria-label="Fechar menu" data-mobile-menu-close>
      {{ 'icon-x.svg' | inline_asset_content }}
    </button>
  </div>
  <div class="mobile-drawer__body">
    <ul class="mobile-drawer__menu">
      {%- for link in section.settings.menu.links -%}
        {%- assign handle_check = link.title | handleize -%}
        {%- assign has_submenu = false -%}
        {%- assign child_links = nil -%}

        {%- if link.links.size > 0 -%}
          {%- assign has_submenu = true -%}
          {%- assign child_links = link.links -%}
        {%- elsif handle_check == 'joias' and linklists['menu-joias'].links.size > 0 -%}
          {%- assign has_submenu = true -%}
          {%- assign child_links = linklists['menu-joias'].links -%}
        {%- endif -%}

        {%- assign is_link_active = link.active -%}
        {%- if has_submenu -%}
          {%- if handle_check == 'joias' -%}
            {%- if collection.handle == 'joias' -%}
              {%- assign is_link_active = true -%}
            {%- else -%}
              {%- for child_link in linklists['menu-joias'].links -%}
                {%- if request.path == child_link.url or collection.url == child_link.url or child_link.active -%}
                  {%- assign is_link_active = true -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- else -%}
            {%- for child_link in link.links -%}
              {%- if request.path == child_link.url or collection.url == child_link.url or child_link.active -%}
                {%- assign is_link_active = true -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endif -%}

        <li class="mobile-drawer__menu-item{% if has_submenu %} has-submenu{% endif %}">
          <div class="mobile-drawer__link-wrapper">
            <a href="{{ link.url }}" class="mobile-drawer__link{% if is_link_active %} is-active{% endif %}"{% if is_link_active %} aria-current="page"{% endif %}>
              {{ link.title }}
            </a>
            {%- if has_submenu -%}
              <button type="button" class="mobile-drawer__toggle" aria-label="Toggle submenu" aria-expanded="false">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-chevron">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
            {%- endif -%}
          </div>
          {%- if has_submenu -%}
            <ul class="mobile-drawer__submenu" aria-hidden="true" style="display: none;">
              {%- for child_link in child_links -%}
                <li>
                  <a href="{{ child_link.url }}" class="mobile-drawer__sublink">
                    {{ child_link.title }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</nav>

<style>
  #shopify-section-{{ section.id }} {
    position: sticky;
    top: 0;
    z-index: 1001;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }}.header--hidden-footer {
      transform: translateY(-100%);
      opacity: 0;
      pointer-events: none;
    }
  }
</style>

{% stylesheet %}
  /* ── Header shell ── */
  .site-header {
    background-color: var(--header-bg, var(--color-background));
    border-bottom: 1px solid var(--header-border, var(--color-border));
    position: relative;
    z-index: 100;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--header-height, 4.5rem);
    padding-inline: var(--page-margin, 1.25rem);
    max-width: var(--page-width, 90rem);
    margin-inline: auto;
    width: 100%;
  }

  /* ── Navigation links ── */
  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 100%;
  }

  .site-header__nav-item {
    display: flex;
    align-items: center;
    height: 100%;
  }

  /* ══════════════════════════════════════════
     Mega Menu
     ══════════════════════════════════════════ */
  .mega-menu {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background-color: var(--header-bg, var(--color-background));
    border-bottom: 1px solid var(--header-border, var(--color-border));
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
    z-index: -1;

    /* Animation initial state */
    opacity: 0;
    visibility: hidden;
    transform: translateY(-15px);
    transition: opacity 0.4s cubic-bezier(0.25, 1, 0.5, 1), transform 0.4s cubic-bezier(0.25, 1, 0.5, 1),
      visibility 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    pointer-events: none;
  }

  .mega-menu.is-active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .mega-menu__inner {
    max-width: var(--page-width, 90rem);
    margin: 0 auto;
    padding: 2rem var(--page-margin, 1.25rem) 2.5rem;
    display: flex;
  }

  .mega-menu__list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .mega-menu__link {
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--header-text, var(--color-foreground));
    transition: opacity 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .mega-menu__link:hover {
    opacity: 0.5;
    transform: translateX(6px);
  }

  .site-header__nav--right {
    justify-content: flex-end;
    position: relative;
  }

  .site-header__nav-link {
    font-family: 'Inter', sans-serif;
    font-size: var(--font-size, 0.875rem);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--header-text, var(--color-foreground));
    position: relative;
    padding-bottom: 2px;
    transition: opacity 0.2s ease;
  }

  .site-header__nav-link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -2px;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease;
  }

  .site-header__nav-link:hover::after,
  .site-header__nav-link[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-header__nav-link:hover {
    opacity: 0.7;
  }

  /* ── Logo ── */
  .site-header__logo {
    display: flex;
    justify-content: center;
    text-decoration: none;
    color: inherit;
  }

  .site-header__logo img {
    width: auto;
    height: 3rem;
    object-fit: contain;
  }

  .site-header__logo-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }

  .site-header__logo-brand {
    font-size: 1.875rem;
    font-weight: 300;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--header-text, var(--color-foreground));
  }

  .site-header__logo-tagline {
    font-size: 0.5rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-top: 2px;
  }

  /* ── Icons ── */
  .site-header__icons {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-left: 1.5rem;
  }

  .site-header__icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 2rem;
    position: relative;
    width: 2rem;
    height: 2rem;
    color: var(--header-text, var(--color-foreground));
    text-decoration: none;
    padding: 0.25rem;
    transition: opacity 0.2s ease;
    background: none;
    border: none;
    cursor: pointer;
    font: inherit;
  }

  .site-header__icon-btn:hover {
    opacity: 0.6;
  }

  .site-header__icon-btn svg {
    width: var(--icon-size, 1.5rem);
    height: var(--icon-size, 1.5rem);
    display: block;
    margin: 0 auto;
  }

  .site-header__account {
    transform: translateX(-0.2rem);
    --shopify-account-signed-in-avatar-size: var(--icon-size, 1.5rem);
    --shopify-account-signed-in-avatar-color-background: transparent;
    --shopify-account-signed-in-avatar-color-text: var(--header-text, var(--color-foreground));
  }

  .site-header__account-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
  }

  .site-header__cart {
    margin-left: 0.25rem;
  }

  .site-header__cart-count {
    position: absolute;
    top: -0.35rem;
    right: -0.45rem;
    background-color: var(--cart-badge-bg, var(--color-accent));
    color: var(--cart-badge-text, var(--color-background));
    font-size: 0.55rem;
    font-weight: 700;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    letter-spacing: 0;
  }

  /* ══════════════════════════════════════════
     Expandable Search Bar
     ══════════════════════════════════════════ */
  .search-bar {
    position: absolute;
    top: 0;
    left: auto;
    right: 0;
    bottom: 0;
    width: var(--search-width, 60%);
    display: flex;
    align-items: center;
    background-color: var(--header-bg, var(--color-background));
    z-index: 10;
    padding-inline: 0.25rem;
    clip-path: inset(-1000px -1000px -1000px 100%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: clip-path 0.45s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.35s ease, visibility 0s 0.45s;
  }

  .search-bar.is-active {
    clip-path: inset(-1000px -1000px -1000px -1000px);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: clip-path 0.45s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease, visibility 0s 0s;
  }

  .search-bar__form {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  .search-bar__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--header-text, var(--color-foreground));
    cursor: pointer;
    padding: 0.25rem;
    flex-shrink: 0;
    transition: opacity 0.2s ease;
  }

  .search-bar__icon:hover {
    opacity: 0.6;
  }

  .search-bar__icon svg {
    width: var(--icon-size, 1.5rem);
    height: var(--icon-size, 1.5rem);
    display: block;
  }

  .search-bar__close svg {
    width: 1rem;
    height: 1rem;
  }

  .search-bar__close:hover {
    transform: rotate(90deg);
    transition: opacity 0.2s ease, transform 0.25s ease;
  }

  .search-bar__input {
    flex: 1;
    min-width: 0;
    background: none;
    border: none;
    outline: none;
    font-family: 'Inter', sans-serif;
    font-size: var(--font-size, 0.8rem);
    font-weight: 400;
    color: var(--header-text, var(--color-foreground));
    padding: 0.3rem 0;
    letter-spacing: 0.02em;
  }

  .search-bar__input::placeholder {
    color: color-mix(in srgb, var(--color-foreground) 35%, transparent);
    font-weight: 300;
  }

  .search-bar__input::-webkit-search-decoration,
  .search-bar__input::-webkit-search-cancel-button,
  .search-bar__input::-webkit-search-results-button,
  .search-bar__input::-webkit-search-results-decoration {
    -webkit-appearance: none;
    appearance: none;
  }

  /* ══════════════════════════════════════════
     Predictive Search Dropdown
     ══════════════════════════════════════════ */
  .predictive-search__dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background-color: var(--header-bg, #fff);
    border-bottom: 1px solid var(--header-border, #e6e1db);
    border-left: 1px solid var(--header-border, #e6e1db);
    border-right: 1px solid var(--header-border, #e6e1db);
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
    z-index: -1;
    overflow: hidden;
    min-height: 60px;
    
    opacity: 0;
    visibility: hidden;
    transform: translateY(-15px);
    transition: opacity 0.4s cubic-bezier(0.25, 1, 0.5, 1), transform 0.4s cubic-bezier(0.25, 1, 0.5, 1), visibility 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    pointer-events: none;
  }

  predictive-search[results="true"] .predictive-search__dropdown,
  predictive-search[loading="true"] .predictive-search__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .predictive-search__results-list {
    max-height: 400px;
    overflow-y: auto;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .predictive-search__results-list::-webkit-scrollbar {
    width: 4px;
  }
  .predictive-search__results-list::-webkit-scrollbar-track {
    background: transparent;
  }
  .predictive-search__results-list::-webkit-scrollbar-thumb {
    background-color: #6c584c;
    border-radius: 4px;
  }

  .predictive-search__item {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    color: #111;
    transition: opacity 0.2s ease;
  }

  .predictive-search__item:hover {
    opacity: 0.7;
  }

  .predictive-search__image {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 8px;
    background-color: #f9f9f9;
  }

  .predictive-search__item-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .predictive-search__item-title {
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .predictive-search__item-price {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
  }

  /* ── Mobile Left controls (hidden on desktop) ── */
  .site-header__mobile-left {
    display: none;
  }

  /* ── Hamburger button (hidden on desktop) ── */
  .site-header__hamburger {
    display: none;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--header-text, var(--color-foreground));
    cursor: pointer;
    padding: 0.25rem;
    width: 2rem;
    height: 2rem;
    transition: opacity 0.2s ease;
  }

  .site-header__hamburger:hover {
    opacity: 0.6;
  }

  .site-header__hamburger svg {
    width: var(--icon-size, 1.5rem);
    height: var(--icon-size, 1.5rem);
  }

  /* ── Mobile Drawer ── */
  .mobile-drawer__overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0);
    z-index: 1100;
    visibility: hidden;
    pointer-events: none;
    transition: background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), visibility 0.5s;
  }

  .mobile-drawer__overlay.is-active {
    background-color: rgba(0, 0, 0, 0.4);
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: min(320px, 80vw);
    background-color: var(--color-background, #fff);
    z-index: 1200;
    transform: translateX(-100%);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    scrollbar-width: none;
    border-radius: 0 40px 40px 0;
  }

  .mobile-drawer::-webkit-scrollbar {
    display: none;
  }

  .mobile-drawer.is-active {
    transform: translateX(0);
  }

  .mobile-drawer__header {
    display: flex;
    justify-content: flex-end;
    padding: 1.25rem 1.25rem 0.5rem;
  }

  .mobile-drawer__close {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--color-foreground);
    cursor: pointer;
    padding: 0.25rem;
    width: 2rem;
    height: 2rem;
    transition: opacity 0.2s ease, transform 0.25s ease;
  }

  .mobile-drawer__close:hover {
    opacity: 0.6;
    transform: rotate(90deg);
  }

  .mobile-drawer__close svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .mobile-drawer__body {
    padding: 1rem 1.5rem 2rem;
    flex: 1;
  }

  .mobile-drawer__menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-drawer__menu-item {
    border-bottom: none;
  }

  .mobile-drawer__link-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .mobile-drawer__link {
    flex-grow: 1;
    display: block;
    padding: 0.75rem 0;
    font-family: 'Inter', sans-serif;
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-foreground);
    transition: opacity 0.2s ease;
  }

  .mobile-drawer__link:hover {
    opacity: 0.6;
  }

  .mobile-drawer__link[aria-current="page"],
  .mobile-drawer__link.is-active,
  .mobile-drawer__link.is-open {
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 1.5px;
  }

  .mobile-drawer__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0.75rem 0.5rem;
    color: var(--color-foreground);
    cursor: pointer;
  }

  .mobile-drawer__toggle svg {
    transition: transform 0.3s ease;
  }

  .mobile-drawer__submenu {
    list-style: none;
    padding: 0.5rem 0 1rem 1.5rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .mobile-drawer__sublink {
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-foreground);
    transition: opacity 0.2s ease;
  }

  .mobile-drawer__sublink:hover {
    opacity: 0.6;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .site-header__mobile-left {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      height: 100%;
    }

    .site-header__hamburger {
      display: flex;
    }

    .site-header__nav--left {
      display: none;
    }

    .site-header__nav--right .site-header__nav-link {
      display: none;
    }

    .site-header__inner {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: 0.5rem;
      position: relative;
    }

    .site-header__logo {
      grid-column: 2;
      justify-content: center;
      align-items: center;
      height: 100%;
    }

    .site-header__nav--right {
      grid-column: 3;
      justify-content: flex-end;
      position: static;
    }

    .site-header__icons {
      gap: 0.75rem;
      margin-left: 0;
    }

    .site-header__account {
      transform: none;
    }

    .site-header__cart {
      margin-left: 0;
    }

    .site-header__icons .site-header__icon-btn[data-search-open] {
      display: none;
    }

    .search-bar {
      width: 100%;
      left: 0;
      right: 0;
      padding-inline: var(--page-margin, 1.25rem);
    }

    .search-bar__input {
      font-size: 0.75rem;
    }

    /* Esconde outros elementos quando a busca está aberta no mobile */
    .site-header__inner:has(.search-bar.is-active) .site-header__mobile-left,
    .site-header__inner:has(.search-bar.is-active) .site-header__logo,
    .site-header__inner:has(.search-bar.is-active) .site-header__icons {
      visibility: hidden;
      pointer-events: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var overlay = document.querySelector('[data-search-overlay]');
    var input = document.querySelector('[data-search-input]');
    var openBtns = document.querySelectorAll('[data-search-open]');
    var closeBtn = document.querySelector('[data-search-close]');

    if (!overlay || !input || openBtns.length === 0 || !closeBtn) return;

    function openSearch() {
      overlay.classList.add('is-active');
      overlay.setAttribute('aria-hidden', 'false');
      requestAnimationFrame(function () {
        input.focus();
      });
    }

    function closeSearch() {
      overlay.classList.remove('is-active');
      overlay.setAttribute('aria-hidden', 'true');
      input.value = '';
      
      // Focus on the first visible open button
      var visibleBtn = Array.prototype.filter.call(openBtns, function(btn) {
        return btn.offsetWidth > 0 || btn.offsetHeight > 0;
      })[0] || openBtns[0];
      if (visibleBtn) visibleBtn.focus();
    }

    Array.prototype.forEach.call(openBtns, function(btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        openSearch();
      });
    });

    closeBtn.addEventListener('click', function (e) {
      e.preventDefault();
      closeSearch();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && overlay.classList.contains('is-active')) {
        closeSearch();
        var predictive = document.querySelector('predictive-search');
        if (predictive) predictive.close();
      }
    });

    class PredictiveSearch extends HTMLElement {
      constructor() {
        super();
        this.input = this.querySelector('input[type="search"]');
        this.predictiveSearchResults = this.querySelector('[data-predictive-search]');
        this.form = this.querySelector('form');
        this.abortController = new AbortController();

        this.setupEventListeners();
      }

      setupEventListeners() {
        if (!this.input) return;

        this.input.addEventListener('input', this.debounce((event) => {
          this.onChange(event);
        }, 300));
        
        this.input.addEventListener('focus', () => {
          if (this.input.value.trim().length > 0) {
            this.setAttribute('results', 'true');
          }
        });
        
        document.addEventListener('click', (event) => {
          if (!this.contains(event.target)) {
            this.close();
          }
        });
      }

      onChange() {
        const searchTerm = this.input.value.trim();

        if (!searchTerm.length) {
          this.close();
          return;
        }

        this.getSearchResults(searchTerm);
      }

      getSearchResults(searchTerm) {
        this.setAttribute('loading', 'true');
        // Previne o "piscar" dos resultados antigos limpando a caixa antes da nova busca
        this.predictiveSearchResults.innerHTML = '<div style="padding: 1.5rem; text-align: center; color: #999; font-size: 0.875rem;">Buscando...</div>';

        this.abortController.abort();
        this.abortController = new AbortController();

        fetch(`/search/suggest?q=${encodeURIComponent(searchTerm)}&resources[type]=product&section_id=predictive-search`, {
          signal: this.abortController.signal
        })
          .then((response) => {
            if (!response.ok) {
              throw new Error(response.status);
            }
            return response.text();
          })
          .then((text) => {
            // Insere o HTML diretamente no dropdown para garantir que não haja erros de parser
            this.predictiveSearchResults.innerHTML = text;
            this.setAttribute('results', 'true');
          })
          .catch((error) => {
            if (error.name !== 'AbortError') {
              this.predictiveSearchResults.innerHTML = '<div style="padding:1rem; color:red;">Erro ao buscar resultados.</div>';
              this.setAttribute('results', 'true');
            }
          })
          .finally(() => {
            this.removeAttribute('loading');
          });
      }

      close() {
        this.removeAttribute('results');
      }

      debounce(fn, wait) {
        let t;
        return (...args) => {
          clearTimeout(t);
          t = setTimeout(() => fn.apply(this, args), wait);
        };
      }
    }

    if (!customElements.get('predictive-search')) {
      customElements.define('predictive-search', PredictiveSearch);
    }

    // ── Mega Menu Logic ──
    var megaTriggers = document.querySelectorAll('[data-mega-menu-trigger]');

    megaTriggers.forEach(function (trigger) {
      var menu = trigger.querySelector('[data-mega-menu]');
      var link = trigger.querySelector('.site-header__nav-link');
      var timeoutId;

      if (!menu) return;

      function openMenu() {
        clearTimeout(timeoutId);
        menu.classList.add('is-active');
        menu.setAttribute('aria-hidden', 'false');
        if (link) link.setAttribute('aria-expanded', 'true');
      }

      function closeMenu() {
        timeoutId = setTimeout(function () {
          menu.classList.remove('is-active');
          menu.setAttribute('aria-hidden', 'true');
          if (link) link.setAttribute('aria-expanded', 'false');
        }, 150);
      }

      trigger.addEventListener('mouseenter', openMenu);
      trigger.addEventListener('mouseleave', closeMenu);

      if (link) {
        link.addEventListener('focus', openMenu);
      }

      menu.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          closeMenu();
          if (link) link.focus();
        }
      });

      trigger.addEventListener('focusout', function (e) {
        if (!trigger.contains(e.relatedTarget)) {
          closeMenu();
        }
      });
    });

    // ── Mobile Drawer Logic ──
    var mobileOpenBtn = document.querySelector('[data-mobile-menu-open]');
    var mobileCloseBtn = document.querySelector('[data-mobile-menu-close]');
    var mobileDrawer = document.querySelector('[data-mobile-menu-drawer]');
    var mobileOverlay = document.querySelector('[data-mobile-menu-overlay]');

    if (mobileOpenBtn && mobileCloseBtn && mobileDrawer && mobileOverlay) {
      function openMobileMenu() {
        mobileDrawer.classList.add('is-active');
        mobileOverlay.classList.add('is-active');
        mobileDrawer.setAttribute('aria-hidden', 'false');
        mobileOverlay.setAttribute('aria-hidden', 'false');
        mobileOpenBtn.setAttribute('aria-expanded', 'true');
        document.documentElement.style.overflow = 'hidden';
      }

      function closeMobileMenu() {
        mobileDrawer.classList.remove('is-active');
        mobileOverlay.classList.remove('is-active');
        mobileDrawer.setAttribute('aria-hidden', 'true');
        mobileOverlay.setAttribute('aria-hidden', 'true');
        mobileOpenBtn.setAttribute('aria-expanded', 'false');
        document.documentElement.style.overflow = '';

        // Collapse all submenus on close
        var openSubmenus = mobileDrawer.querySelectorAll('.mobile-drawer__submenu');
        openSubmenus.forEach(function(submenu) {
          submenu.style.display = 'none';
          submenu.setAttribute('aria-hidden', 'true');
        });
        var openChevrons = mobileDrawer.querySelectorAll('.icon-chevron');
        openChevrons.forEach(function(chevron) {
          chevron.style.transform = 'rotate(0deg)';
        });
        var openLinks = mobileDrawer.querySelectorAll('.mobile-drawer__link');
        openLinks.forEach(function(link) {
          link.classList.remove('is-open');
        });
        var openToggles = mobileDrawer.querySelectorAll('.mobile-drawer__toggle');
        openToggles.forEach(function(toggle) {
          toggle.setAttribute('aria-expanded', 'false');
        });
      }

      mobileOpenBtn.addEventListener('click', function (e) {
        e.preventDefault();
        openMobileMenu();
      });

      mobileCloseBtn.addEventListener('click', function (e) {
        e.preventDefault();
        closeMobileMenu();
      });

      mobileOverlay.addEventListener('click', closeMobileMenu);

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && mobileDrawer.classList.contains('is-active')) {
          closeMobileMenu();
        }
      });

      // Submenu toggle logic (Accordion)
      var submenuItems = mobileDrawer.querySelectorAll('.mobile-drawer__menu-item.has-submenu');
      submenuItems.forEach(function (item) {
        var link = item.querySelector('.mobile-drawer__link');
        var toggle = item.querySelector('.mobile-drawer__toggle');
        var submenu = item.querySelector('.mobile-drawer__submenu');
        var chevron = item.querySelector('.icon-chevron');

        if (!link || !toggle || !submenu || !chevron) return;

        function toggleSubmenu(e) {
          e.preventDefault();
          var isExpanded = toggle.getAttribute('aria-expanded') === 'true';
          toggle.setAttribute('aria-expanded', !isExpanded);

          if (isExpanded) {
            submenu.style.display = 'none';
            submenu.setAttribute('aria-hidden', 'true');
            chevron.style.transform = 'rotate(0deg)';
            link.classList.remove('is-open');
          } else {
            submenu.style.display = 'flex';
            submenu.setAttribute('aria-hidden', 'false');
            chevron.style.transform = 'rotate(180deg)';
            link.classList.add('is-open');
          }
        }

        link.addEventListener('click', toggleSubmenu);
        toggle.addEventListener('click', toggleSubmenu);
      });
    }

    // Hide header on mobile when footer is in view
    var footer = document.querySelector('footer');
    var headerSection = document.querySelector('.site-header');
    if (footer && headerSection) {
      var sectionContainer = headerSection.closest('.shopify-section');
      if (sectionContainer) {
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              sectionContainer.classList.add('header--hidden-footer');
            } else {
              sectionContainer.classList.remove('header--hidden-footer');
            }
          });
        }, {
          threshold: 0
        });
        observer.observe(footer);
      }
    }
  })();
{% endjavascript %}

