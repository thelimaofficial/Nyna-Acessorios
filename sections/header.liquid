<header class="site-header full-width" role="banner">
  <div class="site-header__inner">

    {%- comment -%} ── Left navigation ── {%- endcomment -%}
    <nav class="site-header__nav site-header__nav--left" aria-label="{{ 'accessibility.nav_left' | t }}">
      {%- for link in section.settings.menu.links -%}
        {%- if forloop.last == false -%}
          <a class="site-header__nav-link" href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>
            {{ link.title }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    {%- comment -%} ── Logo (center) ── {%- endcomment -%}
    <a class="site-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 320
          | image_tag:
            width: section.settings.logo_width,
            alt: section.settings.logo.alt | default: shop.name,
            loading: 'eager'
        }}
      {%- else -%}
        <img
          src="{{ 'logo-nyna.svg' | asset_url }}"
          alt="{{ shop.name }}"
          style="width: {{ section.settings.logo_width }}px; height: auto;"
          loading="eager"
        >
      {%- endif -%}
    </a>

    {%- comment -%} ── Right navigation + icons ── {%- endcomment -%}
    <div class="site-header__nav site-header__nav--right">
      {%- for link in section.settings.menu.links -%}
        {%- if forloop.last -%}
          <a class="site-header__nav-link" href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>
            {{ link.title }}
          </a>
        {%- endif -%}
      {%- endfor -%}

      <div class="site-header__icons">
        <a href="{{ routes.search_url }}" class="site-header__icon-btn" aria-label="{{ 'accessibility.search' | t }}">
          {{ 'icon-busca.svg' | inline_asset_content }}
        </a>

        {%- if shop.customer_accounts_enabled -%}
          <shopify-account menu="{{ section.settings.customer_account_menu }}" aria-label="{{ 'accessibility.account' | t }}" class="site-header__icon-btn">
            {{ 'icon-user.svg' | inline_asset_content }}
          </shopify-account>
        {%- endif -%}

        <a href="{{ routes.cart_url }}" class="site-header__icon-btn site-header__cart" aria-label="{{ 'accessibility.cart' | t: count: cart.item_count }}">
          {%- if cart.item_count > 0 -%}
            <span class="site-header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
          {%- endif -%}
          {{ 'icon-cart.svg' | inline_asset_content }}
        </a>
      </div>
    </div>

  </div>
</header>

{% stylesheet %}
  /* ── Header shell ── */
  .site-header {
    background-color: var(--header-bg, #faf8f5);
    border-bottom: 1px solid rgba(44, 36, 32, 0.08);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--header-height, 4.5rem);
    padding-inline: var(--page-margin, 1.25rem);
    max-width: var(--page-width, 90rem);
    margin-inline: auto;
    width: 100%;
  }

  /* ── Navigation links ── */
  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .site-header__nav--right {
    justify-content: flex-end;
  }

  .site-header__nav-link {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--header-link-color, #2c2420);
    position: relative;
    padding-bottom: 2px;
    transition: opacity 0.2s ease;
  }

  .site-header__nav-link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -2px;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease;
  }

  .site-header__nav-link:hover::after,
  .site-header__nav-link[aria-current="page"]::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-header__nav-link:hover {
    opacity: 0.7;
  }

  /* ── Logo ── */
  .site-header__logo {
    display: flex;
    justify-content: center;
    text-decoration: none;
    color: inherit;
  }

  .site-header__logo img {
    width: auto;
    height: 3rem;
    object-fit: contain;
  }

  .site-header__logo-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }

  .site-header__logo-brand {
    font-size: 1.875rem;
    font-weight: 300;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #2c2420;
  }

  .site-header__logo-tagline {
    font-size: 0.5rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: #8b7355;
    margin-top: 2px;
  }

  /* ── Icons ── */
  .site-header__icons {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-left: 1.5rem;
  }

  .site-header__icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    color: #2c2420;
    text-decoration: none;
    padding: 0.25rem;
    transition: opacity 0.2s ease;
  }

  .site-header__icon-btn:hover {
    opacity: 0.6;
  }

  .site-header__icon-btn svg {
    width: 1.5rem;
    height: 1.5rem;
    display: block;
  }

  .site-header__cart-count {
    position: absolute;
    top: -0.35rem;
    right: -0.45rem;
    background-color: #8b7355;
    color: #fff;
    font-size: 0.55rem;
    font-weight: 700;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    letter-spacing: 0;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .site-header__nav--left {
      display: none;
    }

    .site-header__nav--right .site-header__nav-link {
      display: none;
    }

    .site-header__inner {
      grid-template-columns: 1fr auto 1fr;
    }

    .site-header__logo {
      grid-column: 2;
      justify-content: center;
    }

    .site-header__nav--right {
      grid-column: 3;
      justify-content: flex-end;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 160
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
