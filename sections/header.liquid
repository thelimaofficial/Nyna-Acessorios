<header class="site-header full-width" role="banner" style="
  --header-bg: {{ section.settings.header_bg_color }};
  --header-text: {{ section.settings.header_text_color }};
  --header-border: {{ section.settings.header_border_color }};
  --cart-badge-bg: {{ section.settings.cart_badge_bg }};
  --cart-badge-text: {{ section.settings.cart_badge_text }};
  --search-width: {{ section.settings.search_bar_width }}%;
  --icon-size: {{ section.settings.icon_size }}px;
  --font-size: {{ section.settings.font_size }}px;
">
  <div class="site-header__inner">
    {%- comment -%} ── Left navigation ── {%- endcomment -%}
    <nav class="site-header__nav site-header__nav--left" aria-label="{{ 'accessibility.nav_left' | t }}">
      {%- for link in section.settings.menu.links -%}
        {%- if forloop.last == false -%}
          <a
            class="site-header__nav-link"
            href="{{ link.url }}"
            {% if link.active %}
              aria-current="page"
            {% endif %}
          >
            {{ link.title }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    {%- comment -%} ── Logo (center) ── {%- endcomment -%}
    <a class="site-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 320
          | image_tag: width: section.settings.logo_width, alt: section.settings.logo.alt
          | default: shop.name, loading: 'eager'
        }}
      {%- else -%}
        <img
          src="{{ 'logo-nyna.svg' | asset_url }}"
          alt="{{ shop.name }}"
          style="width: {{ section.settings.logo_width }}px; height: auto;"
          loading="eager"
        >
      {%- endif -%}
    </a>

    {%- comment -%} ── Right navigation + icons ── {%- endcomment -%}
    <div class="site-header__nav site-header__nav--right">
      {%- for link in section.settings.menu.links -%}
        {%- if forloop.last -%}
          <a
            class="site-header__nav-link"
            href="{{ link.url }}"
            {% if link.active %}
              aria-current="page"
            {% endif %}
          >
            {{ link.title }}
          </a>
        {%- endif -%}
      {%- endfor -%}

      <div class="site-header__icons">
        <button
          type="button"
          class="site-header__icon-btn"
          aria-label="{{ 'accessibility.search' | t }}"
          data-search-open
        >
          {{ 'icon-busca.svg' | inline_asset_content }}
        </button>

        {%- if shop.customer_accounts_enabled -%}
          <a
            href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
            class="site-header__icon-btn"
            aria-label="{{ 'accessibility.account' | t }}"
            {% unless customer %}data-login-open{% endunless %}
          >
            {{ 'icon-user.svg' | inline_asset_content }}
          </a>
        {%- endif -%}

        <a
          href="{{ routes.cart_url }}"
          class="site-header__icon-btn site-header__cart"
          aria-label="{{ 'accessibility.cart' | t: count: cart.item_count }}"
          data-cart-open
        >
          {%- if cart.item_count > 0 -%}
            <span class="site-header__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
          {%- endif -%}
          {{ 'icon-cart.svg' | inline_asset_content }}
        </a>
      </div>

      {%- comment -%} ── Expandable search ── {%- endcomment -%}
      <div class="search-bar" data-search-overlay aria-hidden="true">
        <form action="{{ routes.search_url }}" method="get" class="search-bar__form" role="search">
          <button type="submit" class="search-bar__icon" aria-label="{{ 'accessibility.search' | t }}">
            {{ 'icon-busca.svg' | inline_asset_content }}
          </button>
          <input
            type="search"
            name="q"
            class="search-bar__input"
            placeholder="{{ section.settings.search_placeholder }}"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            data-search-input
          >
          <button
            type="button"
            class="search-bar__icon search-bar__close"
            aria-label="Fechar busca"
            data-search-close
          >
            {{ 'icon-x.svg' | inline_asset_content }}
          </button>
        </form>
      </div>
    </div>
  </div>
</header>

<style>
  #shopify-section-{{ section.id }} {
    position: sticky;
    top: 0;
    z-index: 1001;
  }
</style>

{% stylesheet %}
  /* ── Header shell ── */
  .site-header {
    background-color: var(--header-bg, #faf8f5);
    border-bottom: 1px solid var(--header-border, rgba(44, 36, 32, 0.08));
    position: relative;
    z-index: 100;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--header-height, 4.5rem);
    padding-inline: var(--page-margin, 1.25rem);
    max-width: var(--page-width, 90rem);
    margin-inline: auto;
    width: 100%;
  }

  /* ── Navigation links ── */
  .site-header__nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .site-header__nav--right {
    justify-content: flex-end;
    position: relative;
  }

  .site-header__nav-link {
    font-family: 'Inter', sans-serif;
    font-size: var(--font-size, 0.875rem);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--header-text, #2c2420);
    position: relative;
    padding-bottom: 2px;
    transition: opacity 0.2s ease;
  }

  .site-header__nav-link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -2px;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease;
  }

  .site-header__nav-link:hover::after,
  .site-header__nav-link[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-header__nav-link:hover {
    opacity: 0.7;
  }

  /* ── Logo ── */
  .site-header__logo {
    display: flex;
    justify-content: center;
    text-decoration: none;
    color: inherit;
  }

  .site-header__logo img {
    width: auto;
    height: 3rem;
    object-fit: contain;
  }

  .site-header__logo-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }

  .site-header__logo-brand {
    font-size: 1.875rem;
    font-weight: 300;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--header-text, #2c2420);
  }

  .site-header__logo-tagline {
    font-size: 0.5rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: #8b7355;
    margin-top: 2px;
  }

  /* ── Icons ── */
  .site-header__icons {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-left: 1.5rem;
  }

  .site-header__icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    color: var(--header-text, #2c2420);
    text-decoration: none;
    padding: 0.25rem;
    transition: opacity 0.2s ease;
    background: none;
    border: none;
    cursor: pointer;
    font: inherit;
  }

  .site-header__icon-btn:hover {
    opacity: 0.6;
  }

  .site-header__icon-btn svg {
    width: var(--icon-size, 1.5rem);
    height: var(--icon-size, 1.5rem);
    display: block;
    margin: 0 auto;
  }

  .site-header__cart-count {
    position: absolute;
    top: -0.35rem;
    right: -0.45rem;
    background-color: var(--cart-badge-bg, #8b7355);
    color: var(--cart-badge-text, #fff);
    font-size: 0.55rem;
    font-weight: 700;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    letter-spacing: 0;
  }

  /* ══════════════════════════════════════════
     Expandable Search Bar
     ══════════════════════════════════════════ */
  .search-bar {
    position: absolute;
    top: 0;
    left: auto;
    right: 0;
    bottom: 0;
    width: var(--search-width, 60%);
    display: flex;
    align-items: center;
    background-color: var(--header-bg, #faf8f5);
    z-index: 10;
    padding-inline: 0.25rem;
    clip-path: inset(0 0 0 100%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      clip-path 0.45s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.35s ease,
      visibility 0s 0.45s;
  }

  .search-bar.is-active {
    clip-path: inset(0 0 0 0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      clip-path 0.45s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.3s ease,
      visibility 0s 0s;
  }

  .search-bar__form {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  .search-bar__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--header-text, #2c2420);
    cursor: pointer;
    padding: 0.25rem;
    flex-shrink: 0;
    transition: opacity 0.2s ease;
  }

  .search-bar__icon:hover {
    opacity: 0.6;
  }

  .search-bar__icon svg {
    width: var(--icon-size, 1.5rem);
    height: var(--icon-size, 1.5rem);
    display: block;
  }

  .search-bar__close svg {
    width: 1rem;
    height: 1rem;
  }

  .search-bar__close:hover {
    transform: rotate(90deg);
    transition: opacity 0.2s ease, transform 0.25s ease;
  }

  .search-bar__input {
    flex: 1;
    min-width: 0;
    background: none;
    border: none;
    outline: none;
    font-family: 'Inter', sans-serif;
    font-size: var(--font-size, 0.8rem);
    font-weight: 400;
    color: var(--header-text, #2c2420);
    padding: 0.3rem 0;
    letter-spacing: 0.02em;
  }

  .search-bar__input::placeholder {
    color: rgba(44, 36, 32, 0.35);
    font-weight: 300;
  }

  .search-bar__input::-webkit-search-decoration,
  .search-bar__input::-webkit-search-cancel-button,
  .search-bar__input::-webkit-search-results-button,
  .search-bar__input::-webkit-search-results-decoration {
    -webkit-appearance: none;
    appearance: none;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .site-header__nav--left {
      display: none;
    }

    .site-header__nav--right .site-header__nav-link {
      display: none;
    }

    .site-header__inner {
      grid-template-columns: 1fr auto 1fr;
    }

    .site-header__logo {
      grid-column: 2;
      justify-content: center;
    }

    .site-header__nav--right {
      grid-column: 3;
      justify-content: flex-end;
    }

    .site-header__icons {
      gap: 0.75rem;
      margin-left: 0;
    }

    .search-bar__input {
      font-size: 0.75rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var overlay = document.querySelector('[data-search-overlay]');
    var input = document.querySelector('[data-search-input]');
    var openBtn = document.querySelector('[data-search-open]');
    var closeBtn = document.querySelector('[data-search-close]');

    if (!overlay || !input || !openBtn || !closeBtn) return;

    function openSearch() {
      overlay.classList.add('is-active');
      overlay.setAttribute('aria-hidden', 'false');
      requestAnimationFrame(function () { input.focus(); });
    }

    function closeSearch() {
      overlay.classList.remove('is-active');
      overlay.setAttribute('aria-hidden', 'true');
      input.value = '';
      openBtn.focus();
    }

    openBtn.addEventListener('click', function (e) {
      e.preventDefault();
      openSearch();
    });

    closeBtn.addEventListener('click', function (e) {
      e.preventDefault();
      closeSearch();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && overlay.classList.contains('is-active')) {
        closeSearch();
      }
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "header",
      "content": "Logotipo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 160
    },
    {
      "type": "header",
      "content": "Menus"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "header",
      "content": "Cores e Estilos"
    },
    {
      "type": "color",
      "id": "header_bg_color",
      "label": "Cor de fundo",
      "default": "#faf8f5"
    },
    {
      "type": "color",
      "id": "header_text_color",
      "label": "Cor dos textos e ícones",
      "default": "#2c2420"
    },
    {
      "type": "color",
      "id": "header_border_color",
      "label": "Cor da linha inferior",
      "default": "#e6e1db"
    },
    {
      "type": "color",
      "id": "cart_badge_bg",
      "label": "Cor de fundo do contador do carrinho",
      "default": "#8b7355"
    },
    {
      "type": "color",
      "id": "cart_badge_text",
      "label": "Cor do texto do contador do carrinho",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Barra de Pesquisa"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Texto de placeholder da busca",
      "default": "O que você está procurando?"
    },
    {
      "type": "range",
      "id": "search_bar_width",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Largura da barra de pesquisa",
      "default": 60
    },
    {
      "type": "header",
      "content": "Tamanhos"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Tamanho da fonte do menu",
      "default": 14
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Tamanho dos ícones",
      "default": 24
    }
  ]
}
{% endschema %}
