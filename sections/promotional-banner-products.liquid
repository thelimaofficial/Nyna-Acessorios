<section class="promo-banner-products section-{{ section.id }}">
  {%- style -%}
    .section-{{ section.id }} {
      padding-block: clamp(4rem, 8vw, 6rem);
    }
    .section-{{ section.id }} .promo-banner-products__left {
      background-color: {{ section.settings.banner_bg_color }};
      {% if section.settings.banner_image != blank %}
        background-image: url('{{ section.settings.banner_image | image_url: width: 1000 }}');
        background-size: cover;
        background-position: center;
      {% endif %}
    }
    .section-{{ section.id }} .promo-banner-products__text {
      color: {{ section.settings.banner_text_color }};
    }
  {%- endstyle -%}

  <div class="promo-banner-products__container">
    <div class="promo-banner-products__left">
      <div class="promo-banner-products__content">
        <h2 class="promo-banner-products__text">{{ section.settings.banner_text }}</h2>
      </div>
    </div>
    
    <div class="promo-banner-products__right">
      <div class="promo-banner-products__box">
        {%- if section.settings.right_heading != blank -%}
          <h3 class="promo-banner-products__heading">{{ section.settings.right_heading }}</h3>
        {%- endif -%}
        
        <div class="promo-banner-products__grid">
          {%- assign collection = section.settings.right_collection -%}
          {%- if collection != blank -%}
            {%- for product in collection.products limit: 8 -%}
              <div class="promo-banner-products__slide">
                {% render 'product-card', product: product %}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              <div class="promo-banner-products__slide">
                {% render 'product-card' %}
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .promo-banner-products__container {
    display: flex;
    max-width: min(100%, calc(var(--page-width, 90rem) + 6rem));
    margin-inline: auto;
    padding-left: clamp(0.5rem, 1.5vw, 1rem);
    padding-right: var(--page-margin, 1.25rem);
    min-height: 400px;
  }

  .promo-banner-products__left {
    flex: 7.5;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .promo-banner-products__text {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0;
    text-transform: none;
    text-align: center;
  }

  .promo-banner-products__right {
    flex: 2.5;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
  }

  .promo-banner-products__box {
    background-color: #fff;
    padding: 2rem;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* Adicionando um leve espaçamento para parecer descolado caso necessário */
  }

  .promo-banner-products__heading {
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0;
    color: var(--color-foreground);
    margin-bottom: 2rem;
  }

  .promo-banner-products__grid {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE and Edge */
    padding-bottom: 0.5rem;
  }

  .promo-banner-products__grid::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Opera */
  }

  .promo-banner-products__slide {
    flex: 0 0 calc(50% - 0.75rem);
    scroll-snap-align: start;
    min-width: 0;
  }

  @media (max-width: 768px) {
    .promo-banner-products__container {
      flex-direction: column;
      padding-inline: 0;
    }
    .promo-banner-products__left {
      min-height: 250px;
    }
    .promo-banner-products__box {
      padding: 1.5rem var(--page-margin, 1.25rem);
    }
    .promo-banner-products__grid {
      gap: 1rem;
    }
    .promo-banner-products__slide {
      flex: 0 0 calc(50% - 0.5rem);
    }
  }

  /* Fix for the strange hover jumping behavior */
  .promo-banner-products__grid .product-card {
    margin-bottom: 0 !important;
  }
  .promo-banner-products__grid .product-card:hover {
    margin-bottom: 0 !important;
  }
  .promo-banner-products__grid .product-card__sizes-wrapper {
    display: none !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Promotional Banner",
  "settings": [
    {
      "type": "color",
      "id": "banner_bg_color",
      "label": "Banner Background Color",
      "default": "#c5a491"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image (Optional)"
    },
    {
      "type": "text",
      "id": "banner_text",
      "label": "Banner Text",
      "default": "banner"
    },
    {
      "type": "color",
      "id": "banner_text_color",
      "label": "Banner Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "right_heading",
      "label": "Products Heading",
      "default": "Custom text"
    },
    {
      "type": "collection",
      "id": "right_collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Promotional Banner"
    }
  ]
}
{% endschema %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', function() {
    const grids = document.querySelectorAll('.promo-banner-products__grid');
    
    grids.forEach(grid => {
      const slides = grid.querySelectorAll('.promo-banner-products__slide');
      if (slides.length <= 2) return; // Don't auto-scroll if 2 or fewer items
      
      let isPaused = false;
      let scrollInterval;
      
      const startScroll = () => {
        scrollInterval = setInterval(() => {
          if (isPaused) return;
          
          const maxScroll = grid.scrollWidth - grid.clientWidth;
          
          // se faltar menos de 5px pro final, resetar pro inicio
          if (grid.scrollLeft >= maxScroll - 5) {
            grid.scrollTo({ left: 0, behavior: 'smooth' });
          } else {
            const itemWidth = slides[0].offsetWidth;
            const gap = parseFloat(getComputedStyle(grid).gap) || 0;
            grid.scrollBy({ left: itemWidth + gap, behavior: 'smooth' });
          }
        }, 3000);
      };
      
      startScroll();
      
      // Allow user to interact without it jumping away
      grid.addEventListener('mouseenter', () => isPaused = true);
      grid.addEventListener('mouseleave', () => isPaused = false);
      grid.addEventListener('touchstart', () => isPaused = true, {passive: true});
      grid.addEventListener('touchend', () => {
        setTimeout(() => isPaused = false, 3000);
      }, {passive: true});
    });
  });
{% endjavascript %}
