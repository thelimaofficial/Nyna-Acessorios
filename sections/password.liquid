{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.
{% endcomment %}

<div class="password-page">
  <div class="password-page__content">
    
    <div class="password-page__header">
      {% if settings.logo != blank %}
        {{ settings.logo | image_url: width: 300 | image_tag: class: 'password-page__logo' }}
      {% else %}
        <h1 class="password-page__shop-name">{{ shop.name }}</h1>
      {% endif %}
    </div>

    <div class="password-page__main">
      <h2 class="password-page__title">Em breve</h2>
      
      {% if shop.password_message != blank %}
        <p class="password-page__message">{{ shop.password_message }}</p>
      {% endif %}

      {% form 'storefront_password', class: 'password-page__form' %}
        {% if form.errors %}
          <div class="password-page__errors">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="password-page__input-group">
          <input type="password" 
                 name="password" 
                 id="password-input" 
                 class="password-page__input" 
                 placeholder="Senha de acesso"
                 required>
          <button type="submit" class="password-page__button">
            Entrar
          </button>
        </div>
      {% endform %}
    </div>
    
  </div>
</div>

{% stylesheet %}
  .password-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    background-color: var(--color-background, #faf9f8);
    font-family: 'Inter', sans-serif;
    padding: 2rem;
  }

  .password-page__content {
    max-width: 32rem;
    width: 100%;
    text-align: center;
    background: #fff;
    padding: 3rem 2rem;
    border-radius: 1.5rem;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
  }

  .password-page__header {
    margin-bottom: 2rem;
  }

  .password-page__logo {
    max-width: 100%;
    height: auto;
    max-height: 5rem;
  }

  .password-page__shop-name {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--color-foreground, #111);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .password-page__title {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-foreground, #111);
    margin: 0 0 1rem;
  }

  .password-page__message {
    font-size: 1rem;
    color: #666;
    margin: 0 0 2.5rem;
    line-height: 1.5;
  }

  .password-page__form {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .password-page__errors {
    color: #d93025;
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    background: #fdf0ef;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    width: 100%;
    max-width: 24rem;
  }

  .password-page__input-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    max-width: 24rem;
  }

  .password-page__input {
    width: 100%;
    height: 3.25rem;
    padding: 0 1.25rem;
    border: 1px solid #ddd;
    border-radius: 40px;
    font-size: 1rem;
    font-family: 'Inter', sans-serif;
    color: var(--color-foreground, #111);
    transition: all 0.3s ease;
    box-sizing: border-box;
  }

  .password-page__input:focus {
    outline: none;
    border-color: #111;
    box-shadow: 0 0 0 1px #111;
  }

  .password-page__button {
    width: 100%;
    height: 3.25rem;
    background-color: var(--color-accent, #111);
    color: #fff;
    border: none;
    border-radius: 40px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease, opacity 0.3s ease;
  }

  .password-page__button:hover {
    opacity: 0.9;
  }

  @media (min-width: 768px) {
    .password-page__content {
      padding: 4rem 3rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
