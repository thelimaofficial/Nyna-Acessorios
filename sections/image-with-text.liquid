<section class="image-with-text section-{{ section.id }}" aria-label="{{ section.settings.heading }}">
  <div class="image-with-text__inner {% if section.settings.layout == 'text_first' %}image-with-text__inner--reverse{% endif %}">
    
    <div class="image-with-text__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            class: 'image-with-text__img',
            alt: section.settings.image.alt | default: section.settings.heading,
            loading: 'lazy'
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg image-with-text__img' }}
      {%- endif -%}
    </div>

    <div class="image-with-text__content">
      <div class="image-with-text__content-inner">
        {%- if section.settings.subheading != blank -%}
          <p class="image-with-text__eyebrow">{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="image-with-text__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="image-with-text__text">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="image-with-text__btn">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

{% stylesheet %}
  .image-with-text {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    background-color: var(--color-background);
  }

  .image-with-text__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 6rem);
    align-items: center;
  }

  .image-with-text__inner--reverse .image-with-text__media {
    order: 2;
  }

  .image-with-text__media {
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }

  .image-with-text__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder-svg {
    background-color: color-mix(in srgb, var(--color-foreground) 5%, transparent);
    color: color-mix(in srgb, var(--color-foreground) 20%, transparent);
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .image-with-text__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .image-with-text__content-inner {
    max-width: 420px;
    margin-inline: auto;
  }

  .image-with-text__eyebrow {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .image-with-text__heading {
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0;
    color: var(--color-foreground);
    margin-bottom: 1.5rem;
  }

  .image-with-text__text {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--color-foreground) 80%, transparent);
    margin-bottom: 2rem;
  }

  .image-with-text__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 2.5rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-background);
    background-color: var(--color-foreground);
    border: 1px solid var(--color-foreground);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .image-with-text__btn:hover {
    background-color: transparent;
    color: var(--color-foreground);
  }

  @media (max-width: 768px) {
    .image-with-text__inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .image-with-text__inner--reverse .image-with-text__media {
      order: 0;
    }

    .image-with-text__content-inner {
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image with Text",
  "class": "shopify-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop image placement",
      "options": [
        {
          "value": "image_first",
          "label": "Image first"
        },
        {
          "value": "text_first",
          "label": "Image second"
        }
      ],
      "default": "image_first"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Nossa Essência"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sobre a NYNA"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Acreditamos que a beleza mora nos detalhes. Cada acessório é pensado para realçar a feminilidade de forma leve, sofisticada e atemporal. Joias feitas para durar e te acompanhar em todos os momentos.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Conheça nossa história"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Image with Text"
    }
  ]
}
{% endschema %}
