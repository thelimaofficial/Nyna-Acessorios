{%- assign is_register = false -%}
{%- if template.name == 'register' -%}
  {%- assign is_register = true -%}
{%- endif -%}

<section
  class="customer-auth"
  style="
    --auth-accent: {{ section.settings.accent_color | default: '#805d4a' }};
    --auth-image-bg: {{ section.settings.image_background | default: '#f5f0eb' }};
  "
>
  <div class="customer-auth__media" aria-label="{{ section.settings.banner_alt | escape }}">
    {%- if section.settings.banner_image != blank -%}
      {{
        section.settings.banner_image
        | image_url: width: 1200
        | image_tag:
          widths: '480, 720, 960, 1200',
          sizes: '(min-width: 750px) 50vw, 100vw',
          loading: 'eager',
          class: 'customer-auth__image',
          alt: section.settings.banner_alt
      }}
    {%- else -%}
      <div class="customer-auth__placeholder">
        <span>NYNA Acessórios</span>
      </div>
    {%- endif -%}
  </div>

  <div class="customer-auth__panel">
    <div class="customer-auth__inner">

      {%- if is_register -%}
        <div class="customer-auth__view is-active">
          <h1 class="customer-auth__title">Criar sua conta</h1>
          <p class="customer-auth__subtitle">Cadastre-se para acompanhar pedidos, salvar favoritos e viver uma experiência exclusiva.</p>

          {%- form 'create_customer', class: 'customer-auth__form', novalidate: 'novalidate' -%}
            {%- if form.errors -%}
              <div class="customer-auth__errors" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            <div class="customer-auth__row">
              <div class="customer-auth__field">
                <input
                  type="text"
                  name="customer[first_name]"
                  id="RegisterFirstName"
                  autocomplete="given-name"
                  placeholder="Nome"
                  value="{{ form.first_name }}"
                  required
                >
              </div>
              <div class="customer-auth__field">
                <input
                  type="text"
                  name="customer[last_name]"
                  id="RegisterLastName"
                  autocomplete="family-name"
                  placeholder="Sobrenome"
                  value="{{ form.last_name }}"
                  required
                >
              </div>
            </div>

            <div class="customer-auth__field">
              <input
                type="email"
                name="customer[email]"
                id="RegisterEmail"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                placeholder="E-mail"
                value="{{ form.email }}"
                required
              >
            </div>

            <div class="customer-auth__password-field customer-auth__field">
              <input
                type="password"
                name="customer[password]"
                id="RegisterPassword"
                autocomplete="new-password"
                placeholder="Senha"
                required
                data-password-input
              >
              <button type="button" class="customer-auth__password-toggle" aria-label="Mostrar senha" data-password-toggle>
                <span class="customer-auth__eye customer-auth__eye--show" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" stroke="currentColor" stroke-width="1.5"/>
                    <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </span>
                <span class="customer-auth__eye customer-auth__eye--hide" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M3 3l18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M10.6 5.2A10.8 10.8 0 0 1 12 5c6 0 9.5 7 9.5 7a17.4 17.4 0 0 1-3.1 4.1M6.5 6.7C3.9 8.5 2.5 12 2.5 12s3.5 7 9.5 7c1.7 0 3.2-.5 4.5-1.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </button>
            </div>

            <button type="submit" class="customer-auth__submit">Criar conta</button>
          {%- endform -%}

          <div class="customer-auth__divider">ou</div>

          <a href="#" class="customer-auth__btn-social" onclick="event.preventDefault(); alert('Login social requer configuração via aplicativo Shopify.');">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Continuar com Google
          </a>

          <p class="customer-auth__switch">Já possui conta? <a href="{{ routes.account_login_url }}">Entrar</a></p>
        </div>

      {%- else -%}
        
        {%- comment -%} LOGIN VIEW {%- endcomment -%}
        <div class="customer-auth__view" id="recover" style="display: none;">
          <h1 class="customer-auth__title">Redefinir senha</h1>
          <p class="customer-auth__subtitle">Enviaremos um e-mail com instruções para você redefinir sua senha.</p>

          {%- form 'recover_customer_password', class: 'customer-auth__form' -%}
            {%- assign recover_success = form.posted_successfully? -%}
            {%- if form.errors -%}
              <div class="customer-auth__errors" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            {%- if recover_success -%}
              <div class="customer-auth__success" role="alert">
                Enviamos um e-mail com as instruções para redefinir sua senha.
              </div>
            {%- endif -%}

            <div class="customer-auth__field">
              <input
                type="email"
                name="email"
                id="RecoverEmail"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                placeholder="E-mail"
                required
              >
            </div>

            <button type="submit" class="customer-auth__submit">Enviar instruções</button>
            
            <p class="customer-auth__switch"><a href="#login" onclick="toggleRecover(false); return false;">Cancelar</a></p>
          {%- endform -%}
        </div>

        <div class="customer-auth__view is-active" id="login">
          <h1 class="customer-auth__title">Entrar na sua conta</h1>
          <p class="customer-auth__subtitle">Acesse seus pedidos, favoritos e uma experiência exclusiva.</p>

          {%- form 'customer_login', class: 'customer-auth__form', novalidate: 'novalidate' -%}
            {%- if form.errors -%}
              <div class="customer-auth__errors" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            <div class="customer-auth__field">
              <input
                type="email"
                name="customer[email]"
                id="CustomerEmail"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                placeholder="E-mail"
                required
              >
            </div>

            <div class="customer-auth__password-field customer-auth__field">
              <input
                type="password"
                name="customer[password]"
                id="CustomerPassword"
                autocomplete="current-password"
                placeholder="Senha"
                required
                data-password-input
              >
              <button type="button" class="customer-auth__password-toggle" aria-label="Mostrar senha" data-password-toggle>
                <span class="customer-auth__eye customer-auth__eye--show" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" stroke="currentColor" stroke-width="1.5"/>
                    <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </span>
                <span class="customer-auth__eye customer-auth__eye--hide" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M3 3l18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M10.6 5.2A10.8 10.8 0 0 1 12 5c6 0 9.5 7 9.5 7a17.4 17.4 0 0 1-3.1 4.1M6.5 6.7C3.9 8.5 2.5 12 2.5 12s3.5 7 9.5 7c1.7 0 3.2-.5 4.5-1.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </button>
            </div>

            <div class="customer-auth__support-links">
              <a href="#recover" onclick="toggleRecover(true); return false;" class="customer-auth__forgot">Esqueceu sua senha?</a>
            </div>

            <button type="submit" class="customer-auth__submit">Entrar</button>
          {%- endform -%}

          <div class="customer-auth__divider">ou</div>

          <a href="#" class="customer-auth__btn-social" onclick="event.preventDefault(); alert('Login social requer configuração via aplicativo Shopify.');">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Continuar com Google
          </a>

          <p class="customer-auth__switch">Não possui conta? <a href="{{ routes.account_register_url }}">Criar conta</a></p>
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

<style>
  .customer-auth {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: calc(100vh - var(--header-height, 4.5rem));
    background: #faf8f5;
    color: #1a1a1a;
    font-family: 'Inter', sans-serif;
  }

  .customer-auth__media {
    min-height: 100%;
    background: var(--auth-image-bg, #f5f0eb);
    overflow: hidden;
    position: relative;
    border-right: 1px solid rgba(0,0,0,0.03);
  }

  .customer-auth__image,
  .customer-auth__placeholder {
    width: 100%;
    height: 100%;
    min-height: inherit;
    display: block;
    object-fit: cover;
  }

  .customer-auth__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #eee9e3 0%, #d8c9bd 100%);
  }

  .customer-auth__placeholder span {
    color: #fff;
    font-size: 1.5rem;
    font-weight: 300;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .customer-auth__panel {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4.5rem 2rem;
  }

  .customer-auth__inner {
    width: min(100%, 26rem);
    text-align: center;
  }

  .customer-auth__view {
    display: none;
    animation: authFadeIn 0.4s ease forwards;
  }
  
  .customer-auth__view.is-active {
    display: block;
  }

  @keyframes authFadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .customer-auth__title {
    margin: 0 0 0.5rem;
    font-size: 1.875rem;
    line-height: 1.2;
    font-weight: 500;
    color: #1a1a1a;
    letter-spacing: -0.01em;
  }

  .customer-auth__subtitle {
    margin: 0 0 2.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
    font-weight: 400;
    color: #666;
  }

  .customer-auth__form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
    width: 100%;
  }

  .customer-auth__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    width: 100%;
  }

  .customer-auth__field {
    width: 100%;
  }

  .customer-auth input {
    width: 100%;
    height: 3rem;
    border: 1px solid #e5dfd8;
    border-radius: 8px;
    background: #fff;
    color: #1a1a1a;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    outline: none;
    padding: 0 1.25rem;
    transition: all 0.2s ease;
  }

  .customer-auth input::placeholder {
    color: #a39e99;
    font-weight: 400;
  }

  .customer-auth input:focus {
    border-color: var(--auth-accent, #7d5a44);
    box-shadow: 0 0 0 3px rgba(125, 90, 68, 0.08);
  }

  .customer-auth__password-field {
    position: relative;
    width: 100%;
  }

  .customer-auth__password-field input {
    padding-right: 3rem;
  }

  .customer-auth__password-toggle {
    position: absolute;
    top: 50%;
    right: 0.5rem;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: #888;
    cursor: pointer;
    transform: translateY(-50%);
    transition: color 0.2s ease, background 0.2s ease;
  }

  .customer-auth__password-toggle:hover {
    color: #1a1a1a;
    background: #f5f0eb;
  }

  .customer-auth__eye {
    width: 1.1rem;
    height: 1.1rem;
    display: block;
  }

  .customer-auth__eye svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .customer-auth__eye--hide,
  .customer-auth__password-toggle.is-visible .customer-auth__eye--show {
    display: none;
  }

  .customer-auth__password-toggle.is-visible .customer-auth__eye--hide {
    display: block;
  }

  .customer-auth__support-links {
    width: 100%;
    display: flex;
    justify-content: flex-end;
    margin-top: -0.5rem;
  }

  .customer-auth__forgot {
    color: #666;
    font-size: 0.75rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .customer-auth__forgot:hover {
    color: #1a1a1a;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .customer-auth__submit {
    width: 100%;
    height: 3rem;
    margin-top: 0.5rem;
    border: 1px solid var(--auth-accent, #7d5a44);
    border-radius: 9999px;
    background: var(--auth-accent, #7d5a44);
    color: #fff;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .customer-auth__submit:hover {
    background: #5e4233;
    border-color: #5e4233;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(125, 90, 68, 0.15);
  }

  .customer-auth__divider {
    display: flex;
    align-items: center;
    width: 100%;
    margin: 1.5rem 0;
    color: #a39e99;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .customer-auth__divider::before,
  .customer-auth__divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: #e5dfd8;
  }

  .customer-auth__divider::before { margin-right: 1rem; }
  .customer-auth__divider::after { margin-left: 1rem; }

  .customer-auth__btn-social {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    height: 3rem;
    border: 1px solid #e5dfd8;
    border-radius: 9999px;
    background: #fff;
    color: #1a1a1a;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .customer-auth__btn-social:hover {
    background: #faf8f5;
    border-color: #d1cbc5;
  }

  .customer-auth__switch {
    margin: 2.5rem 0 0;
    font-size: 0.875rem;
    color: #666;
  }

  .customer-auth__switch a {
    color: var(--auth-accent, #7d5a44);
    font-weight: 500;
    text-decoration: none;
    margin-left: 0.25rem;
    transition: color 0.2s ease;
  }

  .customer-auth__switch a:hover {
    color: #5e4233;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .customer-auth__errors,
  .customer-auth__success {
    width: 100%;
    margin: 0;
    border-radius: 8px;
    font-size: 0.8125rem;
    line-height: 1.5;
    text-align: left;
    padding: 0.875rem 1rem;
  }

  .customer-auth__errors {
    background: #fff5f5;
    color: #c0392b;
    border: 1px solid #ffdcd9;
  }

  .customer-auth__success {
    background: #f0faf5;
    color: #27ae60;
    border: 1px solid #d4f2e3;
    margin-bottom: 1.25rem;
  }

  .customer-auth__errors ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  @media (max-width: 768px) {
    .customer-auth {
      grid-template-columns: 1fr;
    }

    .customer-auth__media {
      min-height: 18rem;
    }

    .customer-auth__panel {
      padding: 3rem 1.5rem;
    }

    .customer-auth__inner {
      width: 100%;
      max-width: 24rem;
    }

    .customer-auth__row {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>

<script>
  (function () {
    // Password toggle
    const toggles = document.querySelectorAll('[data-password-toggle]');
    toggles.forEach(function (toggle) {
      const field = toggle.closest('.customer-auth__password-field');
      const input = field ? field.querySelector('[data-password-input]') : null;

      if (!input) return;

      toggle.addEventListener('click', function () {
        const shouldShow = input.type === 'password';
        input.type = shouldShow ? 'text' : 'password';
        toggle.classList.toggle('is-visible', shouldShow);
        toggle.setAttribute('aria-label', shouldShow ? 'Ocultar senha' : 'Mostrar senha');
      });
    });

    // Check for recover hash on load
    if (window.location.hash === '#recover') {
      toggleRecover(true);
    }
  })();

  function toggleRecover(show) {
    const loginView = document.getElementById('login');
    const recoverView = document.getElementById('recover');
    
    if (loginView && recoverView) {
      if (show) {
        loginView.style.display = 'none';
        loginView.classList.remove('is-active');
        recoverView.style.display = 'block';
        // Add tiny delay for animation to trigger
        setTimeout(() => recoverView.classList.add('is-active'), 10);
        window.location.hash = '#recover';
      } else {
        recoverView.style.display = 'none';
        recoverView.classList.remove('is-active');
        loginView.style.display = 'block';
        setTimeout(() => loginView.classList.add('is-active'), 10);
        window.location.hash = '#login';
      }
    }
  }
</script>

{% schema %}
{
  "name": "Customer auth",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image"
    },
    {
      "type": "text",
      "id": "banner_alt",
      "label": "Banner alt text",
      "default": "Banner"
    },
    {
      "type": "color",
      "id": "image_background",
      "label": "Banner placeholder color",
      "default": "#f5f0eb"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#7d5a44"
    }
  ]
}
{% endschema %}
