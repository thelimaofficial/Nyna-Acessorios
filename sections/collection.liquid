{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<collection-filters class="collection-main section-{{ section.id }}" data-base-url="{{ routes.all_products_collection_url | default: '/collections/all' }}">
  <h1 class="collection-main__title">{{ collection.title | default: 'Joias' }}</h1>
  
  <div class="collection-toolbar">
    {%- assign active_menu = blank -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'category_menu' and block.settings.collection.handle == collection.handle -%}
        {%- assign active_menu = block.settings.menu -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if active_menu == blank -%}
      {%- if collection.handle == 'joias' -%}
        {%- if linklists['menu-joias'].links.size > 0 -%}
          {%- assign active_menu = 'menu-joias' -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}

    {%- if active_menu != blank -%}
      <div class="collection-toolbar__chips">
        {%- for link in linklists[active_menu].links -%}
          {%- assign link_handle = link.object.handle | default: link.title | handleize -%}
          {%- assign is_current_collection = false -%}
          {%- if link.active -%}
            {%- assign is_current_collection = true -%}
          {%- endif -%}
          {%- if link_handle == collection.handle -%}
            {%- assign is_current_collection = true -%}
          {%- endif -%}
          <a href="{{ link.url }}" class="collection-toolbar__chip{% if is_current_collection %} is-active{% endif %}">{{ link.title }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}
    
    <div class="collection-toolbar__actions">
      <span class="collection-toolbar__count">{{ collection.products_count | default: '0' }} produtos</span>
      
      {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
      <custom-select class="collection-toolbar__dropdown" data-param="sort_by">
        <span class="collection-toolbar__dropdown-label">Ordenar por<span class="collection-toolbar__colon">:</span></span>
        <div class="collection-toolbar__select" tabindex="0">
          <span class="custom-select__value">
            {%- case sort_by -%}
              {%- when 'price-ascending' -%}MENOR PREÇO
              {%- when 'price-descending' -%}MAIOR PREÇO
              {%- else -%}MAIS POPULARES
            {%- endcase -%}
          </span>
        </div>
        
        <div class="custom-select__dropdown">
          <button class="custom-select__option {% if sort_by == 'price-ascending' %}is-selected{% endif %}" data-value="price-ascending">MENOR PREÇO</button>
          <button class="custom-select__option {% if sort_by == 'price-descending' %}is-selected{% endif %}" data-value="price-descending">MAIOR PREÇO</button>
          <button class="custom-select__option {% if sort_by == 'manual' or sort_by == blank %}is-selected{% endif %}" data-value="manual">MAIS POPULARES</button>
        </div>
      </custom-select>
      
      <button type="button" class="collection-toolbar__dropdown" data-filter-drawer-trigger style="cursor: pointer; padding-right: 2.625rem;">
        <span class="collection-toolbar__dropdown-label" style="margin-right: 0; color: #050505; font-weight: 500;">Filtrar por</span>
      </button>
    </div>
  </div>

  {% paginate collection.products by 20 %}
    <div class="collection-products">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <div class="collection-empty">
          <p>Nenhuma joia encontrada nesta categoria no momento.</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <div class="collection-pagination">
        {{ paginate | default_pagination }}
      </div>
    {%- endif -%}
  {% endpaginate %}
</collection-filters>

{% render 'filter-drawer' %}

{% stylesheet %}
  .collection-main {
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding-inline: 0;
    padding-top: clamp(3.25rem, 5vw, 3.75rem);
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }

  .collection-main__title {
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0;
    color: var(--color-foreground);
    margin-bottom: 1.375rem;
  }

  /* Toolbar */
  .collection-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .collection-toolbar__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .collection-toolbar__chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.125rem;
    min-width: 5.1875rem;
    padding: 0.4375rem 1.25rem;
    border: 1px solid #e0e0e0;
    border-radius: 9999px;
    text-decoration: none;
    color: #6b6661;
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1;
    background-color: #fff;
    transition: all 0.2s ease;
  }

  .collection-toolbar__chip:hover,
  .collection-toolbar__chip.is-active {
    border-color: #111;
    color: #111;
  }

  .collection-toolbar__chip.is-active {
    background-color: #fff;
    border: 1.5px solid #111;
    color: #111;
    font-weight: 500;
    box-shadow: none;
  }

  .collection-toolbar__actions {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    flex-wrap: wrap;
    margin-left: auto;
  }

  .collection-toolbar__count {
    min-width: 4.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: #050505;
    text-align: right;
  }

  .collection-toolbar__dropdown {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.125rem;
    border: 1px solid #595959;
    border-radius: 9999px;
    padding: 0.3125rem 2.625rem 0.3125rem 1.375rem;
    background-color: #fff;
  }

  .collection-toolbar__dropdown::after {
    content: '';
    position: absolute;
    right: 1.125rem;
    top: 50%;
    width: 0;
    height: 0;
    border-left: 0.3125rem solid transparent;
    border-right: 0.3125rem solid transparent;
    border-top: 0.4375rem solid #222;
    transform: translateY(-35%);
    pointer-events: none;
  }

  .collection-toolbar__dropdown[data-param='sort_by'] {
    width: 17.5rem;
  }

  .collection-toolbar__dropdown[data-param='sort_by'].is-open {
    z-index: 120;
  }

  .collection-toolbar__dropdown[data-param='filter'] {
    width: 10.25rem;
  }

  .collection-toolbar__dropdown-label {
    font-size: 0.75rem;
    color: #666;
    margin-right: 0.5rem;
    white-space: nowrap;
  }

  custom-select {
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .collection-toolbar__select {
    border: none;
    background: transparent;
    flex: 1;
    min-width: 0;
    font-size: 0.75rem;
    font-weight: 500;
    color: #333;
    cursor: pointer;
    outline: none;
    padding-right: 0;
    appearance: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .custom-select__value {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .collection-toolbar__dropdown[data-param='filter'] .collection-toolbar__select {
    display: none;
  }

  /* Custom Dropdown Options Box */
  .custom-select__dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 14rem;
    background-color: #fff;
    border: 1px solid #d7d7d7;
    border-radius: 12px;
    padding: 0.5rem 0;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    z-index: 100;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                transform 0.25s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                visibility 0.25s;
  }

  custom-select.is-open .custom-select__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .custom-select__option {
    display: block;
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    padding: 0.625rem 1.25rem;
    font-size: 0.75rem;
    font-weight: 400;
    color: #333;
    cursor: pointer;
    transition: background-color 0.2s ease;
    white-space: nowrap;
    font-family: inherit;
  }

  .custom-select__option:hover {
    background-color: #f6f6f6;
  }

  .custom-select__option.is-selected {
    font-weight: 600;
  }

  .collection-toolbar__dropdown[data-param='sort_by'] .custom-select__dropdown {
    top: calc(100% + 0.5rem);
    left: 0;
    right: auto;
    width: 100%;
    min-width: 100%;
    border: 1px solid #e8e8e8;
    border-radius: 2rem;
    padding: 1.25rem 0;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
  }

  .collection-toolbar__dropdown[data-param='sort_by'] .custom-select__option {
    padding: 0.5rem 1.375rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: #050505;
    letter-spacing: 0;
    font-weight: 400;
  }

  .collection-toolbar__dropdown[data-param='sort_by'] .custom-select__option:hover {
    background-color: #f7f7f7;
    color: #050505;
  }
  /* Grid Layout */
  .collection-products {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    column-gap: clamp(1rem, 3vw, 2rem);
    row-gap: 2.5rem;
  }

  .collection-pagination {
    grid-column: 1 / -1;
    margin-top: 2rem;
    text-align: center;
  }

  .collection-empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 4rem 1rem;
    color: var(--color-text-secondary);
    font-size: 1rem;
  }

  .collection-main.is-loading {
    opacity: 0.5;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  /* Responsive Adjustments */
  @media (max-width: 990px) {
    .collection-products {
      grid-template-columns: repeat(2, 1fr);
    }
    
    .collection-toolbar {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    
    .collection-toolbar__actions {
      width: 100%;
      justify-content: flex-start;
    }
  }

  @media (max-width: 768px) {
    .collection-main {
      padding-inline: var(--page-margin, 1.25rem);
      padding-top: 1.5rem;
    }

    .collection-main__title {
      margin-bottom: 1.25rem;
    }

    .collection-products {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      column-gap: 1rem;
      row-gap: 2.5rem;
    }

    .collection-toolbar__actions {
      flex-direction: row;
      align-items: center;
      gap: 0.5rem;
      width: 100%;
    }
    
    .collection-toolbar__dropdown {
      flex: 1;
      width: auto;
      min-width: 0;
      padding: 0.3125rem 1.875rem 0.3125rem 1rem;
    }

    .collection-toolbar__dropdown::after {
      right: 0.75rem;
    }

    .collection-toolbar__dropdown[data-param='sort_by'] .collection-toolbar__select {
      display: none;
    }

    .collection-toolbar__colon {
      display: none;
    }

    .collection-toolbar__count {
      display: none;
    }

    .collection-toolbar__dropdown-label {
      margin-right: 0;
      font-weight: 500;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection Grid",
  "settings": [],
  "blocks": [
    {
      "type": "category_menu",
      "name": "Menu de Coleção",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Qual coleção exibirá este menu?"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu de categorias (Filtro)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Grid"
    }
  ]
}
{% endschema %}

{% javascript %}
class CollectionFilters extends HTMLElement {
  constructor() {
    super();
    this.addEventListener('click', this.onClick.bind(this));
    window.addEventListener('popstate', this.onPopState.bind(this));
  }

  onClick(event) {
    const chip = event.target.closest('.collection-toolbar__chip');
    if (chip) {
      event.preventDefault();
      this.fetchPage(chip.getAttribute('href'));
    }
  }
  
  onPopState(event) {
    this.fetchPage(window.location.pathname + window.location.search, false);
  }

  async fetchPage(url, updateHistory = true) {
    this.classList.add('is-loading');

    try {
      const response = await fetch(url);
      if (!response.ok) throw new Error('Network error');
      
      const htmlText = await response.text();
      const parser = new DOMParser();
      const doc = parser.parseFromString(htmlText, 'text/html');

      // Update the main container (Title, Toolbar, Grid)
      const newFilters = doc.querySelector('collection-filters');
      if (newFilters) {
        this.innerHTML = newFilters.innerHTML;
      }

      // Update Banner if it exists
      const newBanner = doc.querySelector('.collection-banner');
      const currentBanner = document.querySelector('.collection-banner');
      if (newBanner && currentBanner) {
        currentBanner.innerHTML = newBanner.innerHTML;
      }

      // Update Page Title
      if (doc.title) {
        document.title = doc.title;
      }

      if (updateHistory) {
        history.pushState({ url }, '', url);
      }
    } catch (error) {
      console.error('Error fetching filtered page:', error);
      window.location.href = url; // Fallback to normal navigation
    } finally {
      this.classList.remove('is-loading');
    }
  }
}

if (!customElements.get('collection-filters')) {
  customElements.define('collection-filters', CollectionFilters);
}

class CustomSelect extends HTMLElement {
  constructor() {
    super();
    this.display = this.querySelector('.collection-toolbar__select');
    this.valueText = this.querySelector('.custom-select__value');
    this.options = this.querySelectorAll('.custom-select__option');
    this.isOpen = false;
    this.paramName = this.dataset.param || 'sort_by';

    this.toggle = this.toggle.bind(this);
    this.close = this.close.bind(this);
    this.onOptionClick = this.onOptionClick.bind(this);
  }

  connectedCallback() {
    this.addEventListener('click', this.toggle);
    this.options.forEach(opt => opt.addEventListener('click', this.onOptionClick));
    document.addEventListener('click', this.close);
  }

  disconnectedCallback() {
    this.removeEventListener('click', this.toggle);
    this.options.forEach(opt => opt.removeEventListener('click', this.onOptionClick));
    document.removeEventListener('click', this.close);
  }

  toggle(e) {
    if (e.target.closest('.custom-select__option')) return;
    e.stopPropagation();
    this.isOpen = !this.isOpen;
    this.classList.toggle('is-open', this.isOpen);
  }

  close(e) {
    if (this.isOpen && !this.contains(e.target)) {
      this.isOpen = false;
      this.classList.remove('is-open');
    }
  }

  onOptionClick(e) {
    e.stopPropagation();
    const value = e.currentTarget.dataset.value;
    const text = e.currentTarget.textContent;
    
    // Update visuals
    this.valueText.textContent = text;
    this.options.forEach(opt => opt.classList.remove('is-selected'));
    e.currentTarget.classList.add('is-selected');
    
    this.isOpen = false;
    this.classList.remove('is-open');

    // Trigger update
    if (this.paramName === 'sort_by') {
      const url = new URL(window.location.href);
      url.searchParams.set('sort_by', value);
      
      const filters = document.querySelector('collection-filters');
      if (filters && typeof filters.fetchPage === 'function') {
        filters.fetchPage(url.toString());
      } else {
        window.location.href = url.toString();
      }
    }
  }
}

if (!customElements.get('custom-select')) {
  customElements.define('custom-select', CustomSelect);
}
{% endjavascript %}
