{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<collection-filters class="collection-main section-{{ section.id }}" data-base-url="{{ routes.all_products_collection_url | default: '/collections/all' }}">
  <h1 class="collection-main__title">{{ collection.title | default: 'Joias' }}</h1>
  
  <div class="collection-toolbar">
    {%- if section.settings.show_category_menu -%}
      <div class="collection-toolbar__chips">
        {%- if section.settings.filter_menu != blank -%}
          {%- for link in linklists[section.settings.filter_menu].links -%}
            <a href="{{ link.url }}" class="collection-toolbar__chip {% if link.active %}is-active{% endif %}">{{ link.title }}</a>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endif -%}
    
    <div class="collection-toolbar__actions">
      <span class="collection-toolbar__count">{{ collection.products_count | default: '0' }} produtos</span>
      
      <div class="collection-toolbar__dropdown">
        <label for="SortBy">Ordenar por:</label>
        <select id="SortBy" name="sort_by" class="collection-toolbar__select">
          <option value="manual">MAIS POPULARES</option>
          <option value="price-ascending">MENOR PREÇO</option>
          <option value="price-descending">MAIOR PREÇO</option>
        </select>
      </div>
      
      <div class="collection-toolbar__dropdown">
        <label for="FilterBy">Filtrar por</label>
        <select id="FilterBy" class="collection-toolbar__select">
          <option value="all">TODOS</option>
        </select>
      </div>
    </div>
  </div>

  <div class="collection-products">
    {% paginate collection.products by 20 %}
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <div class="collection-empty">
          <p>Nenhuma joia encontrada nesta categoria no momento.</p>
        </div>
      {%- endfor -%}
      
      {%- if paginate.pages > 1 -%}
        <div class="collection-pagination">
          {{ paginate | default_pagination }}
        </div>
      {%- endif -%}
    {% endpaginate %}
  </div>
</collection-filters>

{% stylesheet %}
  .collection-main {
    max-width: var(--page-width, 1400px);
    margin-inline: auto;
    padding-inline: var(--page-margin, 1.25rem);
    padding-bottom: clamp(4rem, 8vw, 6rem);
  }

  .collection-main__title {
    text-align: center;
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 500;
    color: #111;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  /* Toolbar */
  .collection-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .collection-toolbar__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .collection-toolbar__chip {
    padding: 0.5rem 1.25rem;
    border: 1px solid #ddd;
    border-radius: 9999px;
    text-decoration: none;
    color: #333;
    font-size: 0.8125rem;
    font-weight: 400;
    transition: all 0.2s ease;
  }

  .collection-toolbar__chip:hover,
  .collection-toolbar__chip.is-active {
    border-color: #333;
    color: #111;
  }

  .collection-toolbar__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .collection-toolbar__count {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #111;
  }

  .collection-toolbar__dropdown {
    display: flex;
    align-items: center;
    border: 1px solid #ddd;
    border-radius: 9999px;
    padding: 0.25rem 1rem;
    background-color: #fff;
  }

  .collection-toolbar__dropdown label {
    font-size: 0.75rem;
    color: #666;
    margin-right: 0.5rem;
    white-space: nowrap;
  }

  .collection-toolbar__select {
    border: none;
    background: transparent;
    font-size: 0.75rem;
    font-weight: 500;
    color: #333;
    cursor: pointer;
    outline: none;
    padding-right: 1.5rem;
    appearance: none;
    background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%23333333%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E");
    background-repeat: no-repeat;
    background-position: right center;
    background-size: 0.65rem auto;
  }

  /* Grid Layout */
  .collection-products {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    column-gap: 1.5rem;
    row-gap: 3rem;
  }

  .collection-pagination {
    grid-column: 1 / -1;
    margin-top: 2rem;
    text-align: center;
  }

  .collection-empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 4rem 1rem;
    color: #666;
    font-size: 1rem;
  }

  .collection-main.is-loading {
    opacity: 0.5;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  /* Responsive Adjustments */
  @media (max-width: 1200px) {
    .collection-products {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 990px) {
    .collection-products {
      grid-template-columns: repeat(3, 1fr);
    }
    
    .collection-toolbar {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    
    .collection-toolbar__actions {
      width: 100%;
      justify-content: flex-start;
    }
  }

  @media (max-width: 768px) {
    .collection-products {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 1rem;
      row-gap: 2rem;
    }
    
    .collection-toolbar__actions {
      flex-direction: column;
      align-items: flex-start;
    }
    
    .collection-toolbar__dropdown {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection Grid",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_category_menu",
      "label": "Habilitar menu de categorias",
      "default": true
    },
    {
      "type": "link_list",
      "id": "filter_menu",
      "label": "Menu de categorias (Filtro)",
      "info": "Selecione o menu que deseja exibir como chips. Para ter um menu diferente por coleção, use 'Origens Dinâmicas' (ícone de cilindro) e vincule a um Metafield de Coleção."
    }
  ],
  "presets": [
    {
      "name": "Collection Grid"
    }
  ]
}
{% endschema %}

{% javascript %}
class CollectionFilters extends HTMLElement {
  constructor() {
    super();
    this.addEventListener('click', this.onClick.bind(this));
    window.addEventListener('popstate', this.onPopState.bind(this));
  }

  onClick(event) {
    const chip = event.target.closest('.collection-toolbar__chip');
    if (chip) {
      event.preventDefault();
      this.fetchPage(chip.getAttribute('href'));
    }
  }
  
  onPopState(event) {
    this.fetchPage(window.location.pathname + window.location.search, false);
  }

  async fetchPage(url, updateHistory = true) {
    this.classList.add('is-loading');

    try {
      const response = await fetch(url);
      if (!response.ok) throw new Error('Network error');
      
      const htmlText = await response.text();
      const parser = new DOMParser();
      const doc = parser.parseFromString(htmlText, 'text/html');

      // Update the main container (Title, Toolbar, Grid)
      const newFilters = doc.querySelector('collection-filters');
      if (newFilters) {
        this.innerHTML = newFilters.innerHTML;
      }

      // Update Banner if it exists
      const newBanner = doc.querySelector('.collection-banner');
      const currentBanner = document.querySelector('.collection-banner');
      if (newBanner && currentBanner) {
        currentBanner.innerHTML = newBanner.innerHTML;
      }

      // Update Page Title
      if (doc.title) {
        document.title = doc.title;
      }

      if (updateHistory) {
        history.pushState({ url }, '', url);
      }
    } catch (error) {
      console.error('Error fetching filtered page:', error);
      window.location.href = url; // Fallback to normal navigation
    } finally {
      this.classList.remove('is-loading');
    }
  }
}

if (!customElements.get('collection-filters')) {
  customElements.define('collection-filters', CollectionFilters);
}
{% endjavascript %}
