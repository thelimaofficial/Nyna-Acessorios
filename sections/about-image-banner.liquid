<section class="about-image-banner section-{{ section.id }} {% if section.settings.full_width %}full-width{% endif %}"
         style="--banner-height: {{ section.settings.desktop_height }}px; --banner-height-mobile: {{ section.settings.mobile_height }}px;">
  <div class="about-image-banner__container">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          class: 'about-image-banner__img',
          widths: '375, 550, 750, 1100, 1500, 2000',
          loading: 'lazy'
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg about-image-banner__img' }}
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .about-image-banner {
    width: 100%;
    overflow: hidden;
  }

  .about-image-banner__container {
    position: relative;
    width: 100%;
    height: var(--banner-height, 450px);
    background-color: var(--color-background-secondary);
  }

  .about-image-banner__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  @media (max-width: 768px) {
    .about-image-banner__container {
      height: var(--banner-height-mobile, 250px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Banner de Imagem",
  "class": "shopify-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width layout",
      "default": true
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Desktop height",
      "default": 450
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 100,
      "max": 500,
      "step": 50,
      "unit": "px",
      "label": "Mobile height",
      "default": 250
    }
  ],
  "presets": [
    {
      "name": "Banner de Imagem",
      "settings": {
        "desktop_height": 450,
        "mobile_height": 250
      }
    }
  ]
}
{% endschema %}
