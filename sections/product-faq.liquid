<section class="product-faq section-{{ section.id }}" aria-label="{{ section.settings.heading }}">
  <div class="product-faq__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="product-faq__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="product-faq__list">
      {%- for block in section.blocks -%}
        <div class="product-faq__item" {{ block.shopify_attributes }}>
          <h3 class="product-faq__question">{{ block.settings.question }}</h3>
          <div class="product-faq__answer">
            {{ block.settings.answer }}
          </div>
        </div>
      {%- else -%}
        <div class="product-faq__item">
          <h3 class="product-faq__question">Pergunta Exemplo?</h3>
          <div class="product-faq__answer">
            <p>Esta é uma resposta de exemplo. Adicione blocos de perguntas frequentes na personalização do tema.</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .product-faq {
    padding-block: clamp(1.25rem, 3vw, 2rem) clamp(3rem, 6vw, 4rem);
    background-color: var(--color-background);
  }

  .product-faq__container {
    max-width: 64rem;
    margin-inline: auto;
    padding-inline: var(--page-margin, 1.25rem);
  }

  .product-faq__heading {
    text-align: left;
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 400;
    color: var(--color-foreground);
    margin-bottom: 1rem;
  }

  .product-faq__list {
    max-width: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .product-faq__item {
    text-align: left;
  }

  .product-faq__question {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-foreground);
    margin: 0 0 0.35rem;
  }

  .product-faq__answer {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  .product-faq__answer p {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Perguntas Frequentes"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "pergunta 1?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>resposta 1</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "pergunta 1?",
            "answer": "<p>resposta 1</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "pergunta 2?",
            "answer": "<p>resposta 2</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "pergunta 3?",
            "answer": "<p>resposta 3</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
