{% doc %}
  NYNA Intent Engine - Sistema de recomendação comportamental
  Este snippet rastreia o comportamento do usuário e exibe recomendações contextuais
  baseadas em pontuação de intenção (Intent Score).
{% enddoc %}

<script>
  window.NYNA_INTENT_DATA = {
    pageType: {{ request.page_type | json }},
    product: {
      id: {{ product.id | json }},
      handle: {{ product.handle | json }},
      title: {{ product.title | json }},
      type: {{ product.type | default: collection.title | json }},
      available: {{ product.available | json }}
    },
    collection: {
      id: {{ collection.id | json }},
      handle: {{ collection.handle | json }},
      title: {{ collection.title | json }}
    }
  };
  window.NYNA_INTENT_DEBUG = true; // Habilitado para debug inicial, pode ser desativado depois
</script>

<div id="nyna-intent-engine" class="nyna-intent-engine" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="nyna-intent-title" aria-describedby="nyna-intent-desc">
  <div class="nyna-intent-backdrop" data-intent-close></div>
  
  <div class="nyna-intent-modal">
    <div class="nyna-intent-header">
      <h2 id="nyna-intent-title" class="nyna-intent-title">Escolhas que combinam com você</h2>
      <p id="nyna-intent-desc" class="nyna-intent-desc">Reunimos as peças que mais chamaram sua atenção.</p>
      <button type="button" class="nyna-intent-close" data-intent-close aria-label="Fechar recomendações">
        {{ 'icon-x.svg' | inline_asset_content }}
      </button>
    </div>
    
    <div class="nyna-intent-content">
      <div id="nyna-intent-loading" class="nyna-intent-loading">
        <div class="nyna-intent-spinner"></div>
      </div>
      <div id="nyna-intent-grid" class="nyna-intent-grid" style="display: none;">
        <!-- Produtos renderizados via AJAX entrarão aqui -->
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .nyna-intent-engine {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: 'Inter', sans-serif;
  }

  body.nyna-intent-open {
    overflow: hidden !important;
    padding-right: var(--scrollbar-compensate, 0px) !important;
  }

  .nyna-intent-engine.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .nyna-intent-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }

  .nyna-intent-modal {
    position: relative;
    background-color: var(--color-background, #fff);
    width: 100%;
    max-width: 800px;
    max-height: 90vh;
    border-radius: 48px;
    box-shadow: 0 40px 110px rgba(0, 0, 0, 0.42);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: translateY(20px) scale(0.98);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nyna-intent-engine.is-active .nyna-intent-modal {
    transform: translateY(0) scale(1);
  }

  .nyna-intent-header {
    padding: 2.4rem 5rem 1.4rem;
    position: relative;
    text-align: center;
  }

  .nyna-intent-title {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-foreground, #111);
    margin: 0 0 0.35rem;
    letter-spacing: 0;
  }

  .nyna-intent-desc {
    font-size: 0.9rem;
    line-height: 1.35;
    color: #3d3a38;
    margin: 0;
  }

  .nyna-intent-close {
    position: absolute;
    top: 2.3rem;
    right: 2.4rem;
    background: none;
    border: none;
    padding: 0.25rem;
    cursor: pointer;
    color: var(--color-foreground, #111);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nyna-intent-close svg {
    width: 1.6rem;
    height: 1.6rem;
    stroke-width: 1.5px;
  }

  .nyna-intent-close:hover {
    background: none;
    opacity: 0.5;
    transform: rotate(90deg);
  }

  .nyna-intent-close:focus,
  .nyna-intent-close:focus-visible {
    outline: none;
    box-shadow: none;
  }

  .nyna-intent-content {
    padding: 0 4rem 2.4rem;
    overflow-y: hidden;
    overflow-x: hidden;
    flex-grow: 1;
  }

  .nyna-intent-loading {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 200px;
  }

  .nyna-intent-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(0, 0, 0, 0.05);
    border-radius: 50%;
    border-top-color: var(--color-foreground, #111);
    animation: nyna-spin 1s ease-in-out infinite;
  }

  @keyframes nyna-spin {
    to { transform: rotate(360deg); }
  }

  .nyna-intent-grid {
    display: flex;
    gap: 2.625rem;
    align-items: stretch;
    justify-content: center;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0;
    scrollbar-width: none;
  }

  .nyna-intent-grid::-webkit-scrollbar {
    display: none;
  }

  /* Estilos do card minimalista injetado via AJAX */
  .intent-minimal-card {
    flex: 0 0 calc((100% - 5.25rem) / 3);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    text-align: center;
    min-width: 0;
  }

  .intent-minimal-card__link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .intent-minimal-card__image-wrapper {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 0.9rem;
    aspect-ratio: 1;
    background: #f7e6df;
  }

  .intent-minimal-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  
  .intent-minimal-card:hover .intent-minimal-card__image {
    transform: scale(1.03);
  }

  .intent-minimal-card__badge {
    position: absolute;
    top: 0;
    right: 0;
    background-color: #b09586;
    color: #fff;
    min-width: 4.15rem;
    min-height: 1.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1;
    padding: 0.35rem 0.55rem;
    border-radius: 0 8px 0 7px;
    letter-spacing: 0.02em;
    z-index: 2;
  }

  .intent-minimal-card__title {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    line-height: 1.2;
    font-weight: 600;
    min-height: 2.2rem;
    margin: 0 0 0.65rem;
    color: var(--color-foreground, #111);
  }

  .intent-minimal-card__price {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    justify-content: center;
    min-height: 2rem;
    margin-bottom: 1rem;
  }

  .intent-minimal-card__price-compare {
    font-size: 0.9rem;
    line-height: 1;
    font-weight: 600;
    color: var(--color-foreground, #111);
  }

  .intent-minimal-card__price-compare s {
    text-decoration: line-through;
  }

  .intent-minimal-card__price-current {
    font-size: 0.95rem;
    line-height: 1.1;
    font-weight: 600;
    color: var(--color-foreground, #111);
  }

  .intent-minimal-card__btn {
    display: block;
    width: 100%;
    background-color: var(--color-accent, #b09586);
    color: #fff;
    text-align: center;
    text-decoration: none;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
    font-family: 'Inter', sans-serif;
    padding: 0.55rem 1rem;
    border-radius: 9999px;
    margin-top: auto;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .intent-minimal-card__btn:hover {
    background-color: var(--color-accent-hover, #9a7e70);
    transform: translateY(-1px);
  }



  @media (max-width: 768px) {
    .nyna-intent-engine {
      padding: 1rem;
    }

    .nyna-intent-modal {
      max-height: 85vh;
      border-radius: 32px;
    }

    .nyna-intent-header {
      padding: 2.25rem 3.5rem 1.25rem;
    }

    .nyna-intent-title {
      font-size: 1.15rem;
      margin: 0 0 0.35rem;
      padding: 0;
    }

    .nyna-intent-desc {
      font-size: 0.85rem;
    }

    .nyna-intent-close {
      top: 1.35rem;
      right: 1.35rem;
    }

    .nyna-intent-content {
      padding: 0 1.25rem 1.75rem;
    }

    .nyna-intent-grid {
      gap: 1rem;
    }
    
    .intent-minimal-card {
      flex: 0 0 calc(50% - 0.5rem);
    }
  }

  @media (max-width: 480px) {
    .nyna-intent-header {
      padding: 2rem 3rem 1.1rem;
    }

    .nyna-intent-desc {
      font-size: 0.8rem;
    }

    .intent-minimal-card {
      flex-basis: calc(100% - 0.5rem);
    }
  }
{% endstylesheet %}

{% javascript %}
  (function() {
    // Utilities
    const log = (...args) => {
      if (window.NYNA_INTENT_DEBUG) console.log('[NYNA Intent]', ...args);
    };

    const throttle = (func, limit) => {
      let inThrottle;
      return function() {
        const args = arguments;
        const context = this;
        if (!inThrottle) {
          func.apply(context, args);
          inThrottle = true;
          setTimeout(() => inThrottle = false, limit);
        }
      }
    };

    const STORAGE_KEY = 'nyna_intent_data';
    const SESSION_KEY = 'nyna_intent_shown';

    // State
    const state = {
      sessionStartTime: Date.now(),
      lastActivityTime: Date.now(),
      pageStartTime: Date.now(),
      lastCloseTime: sessionStorage.getItem('nyna_last_close') ? parseInt(sessionStorage.getItem('nyna_last_close')) : null,
      hasInteractedSinceClose: false,
      isModalOpen: false,
      data: {
        categories: {},
        products: {}
      },
      currentCategory: null,
      currentIntentLevel: 'LOW'
    };

    // 1 & 2. IntentTracker & IntentScore
    const IntentTracker = {
      init() {
        this.loadData();
        this.trackPageLoad();
        this.setupEventListeners();
      },

      loadData() {
        try {
          const stored = localStorage.getItem(STORAGE_KEY);
          if (stored) {
            state.data = JSON.parse(stored);
          }
        } catch (e) {
          log('Error loading data', e);
        }
        this.evaluateScore();
      },

      saveData() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(state.data));
        } catch (e) {
          log('Error saving data', e);
        }
        this.evaluateScore();
      },

      addCategoryScore(category, points) {
        if (!category) return;
        if (!state.data.categories[category]) state.data.categories[category] = 0;
        state.data.categories[category] += points;
        log(`Added ${points} to category ${category}`);
      },

      addProductScore(handle, id, category, points) {
        if (!handle || !id) return;
        if (!state.data.products[handle]) {
          state.data.products[handle] = { id, category, score: 0, views: 0 };
        }
        state.data.products[handle].score += points;
        log(`Added ${points} to product ${handle}`);
      },

      trackPageLoad() {
        const pd = window.NYNA_INTENT_DATA;
        if (!pd) return;

        if (pd.pageType === 'collection' && pd.collection.title) {
          const cat = pd.collection.title;
          this.addCategoryScore(cat, 1);
          
          setTimeout(() => {
            this.addCategoryScore(cat, 2);
            this.saveData();
          }, 15000);
        } 
        else if (pd.pageType === 'product' && pd.product.handle) {
          const { handle, id, type } = pd.product;
          
          if (state.data.products[handle]) {
            this.addProductScore(handle, id, type, 5); // Revisit
            state.data.products[handle].views += 1;
          } else {
            this.addCategoryScore(type, 3);
            this.addProductScore(handle, id, type, 0); // Init
            state.data.products[handle].views = 1;
            
            // Check if viewed 3+ products in same category
            const productsInCat = Object.values(state.data.products).filter(p => p.category === type).length;
            if (productsInCat >= 3) {
              this.addCategoryScore(type, 4);
            }
          }
          
          setTimeout(() => {
            this.addCategoryScore(type, 3);
            this.addProductScore(handle, id, type, 3);
            this.saveData();
          }, 20000);
        }
        this.saveData();
      },

      setupEventListeners() {
        // Track Add to Cart as high intent
        document.body.addEventListener('click', (e) => {
          const btn = e.target.closest('form[action^="/cart/add"] button[type="submit"], .product-card__add-to-cart');
          if (btn) {
            const pd = window.NYNA_INTENT_DATA;
            if (pd && pd.product && pd.product.handle) {
              this.addProductScore(pd.product.handle, pd.product.id, pd.product.type, 15);
              this.saveData();
            }
          }
        });
      },

      evaluateScore() {
        // Find top category
        let topCat = null;
        let maxCatScore = 0;
        for (const [cat, score] of Object.entries(state.data.categories)) {
          if (score > maxCatScore) {
            maxCatScore = score;
            topCat = cat;
          }
        }
        state.currentCategory = topCat;

        // Calculate total score for Intent Level
        const totalScore = Object.values(state.data.categories).reduce((a, b) => a + b, 0);
        
        if (totalScore >= 15) {
          state.currentIntentLevel = 'HIGH';
        } else if (totalScore >= 5) {
          state.currentIntentLevel = 'MEDIUM';
        } else {
          state.currentIntentLevel = 'LOW';
        }
        
        log(`Intent Level: ${state.currentIntentLevel}, Top Category: ${state.currentCategory} (Score: ${maxCatScore})`);
      }
    };

    // 3. BehaviorTrigger
    const BehaviorTrigger = {
      init() {
        this.setupActivityTracking();
        this.setupExitIntent();
        this.startInactivityTimer();
      },

      setupActivityTracking() {
        const updateActivity = throttle(() => {
          state.lastActivityTime = Date.now();
          if (state.lastCloseTime && !state.isModalOpen && !state.hasInteractedSinceClose) {
            state.hasInteractedSinceClose = true;
            log('Nova interação significativa detectada após fechamento do popup.');
          }
        }, 500);

        window.addEventListener('mousemove', updateActivity);
        window.addEventListener('scroll', updateActivity, { passive: true });
        window.addEventListener('keydown', updateActivity);
        window.addEventListener('click', updateActivity);
        window.addEventListener('touchstart', updateActivity, { passive: true });
        window.addEventListener('touchmove', updateActivity, { passive: true });
        window.addEventListener('pointermove', updateActivity, { passive: true });
        window.addEventListener('wheel', updateActivity, { passive: true });
      },

      startInactivityTimer() {
        setInterval(() => {
          if (state.isModalOpen || document.hidden) return;

          const now = Date.now();

          if (state.lastCloseTime) {
            const timeSinceClose = now - state.lastCloseTime;
            const cooldownLeft = 120000 - timeSinceClose;
            
            if (cooldownLeft > 0) {
              // Em cooldown
              // Para evitar flood no console, só logamos o cooldown a cada ~10s
              if (Math.floor(cooldownLeft / 1000) % 10 === 0) {
                 log(`Em cooldown. Restante: ${Math.floor(cooldownLeft / 1000)}s`);
              }
              return;
            }
            if (!state.hasInteractedSinceClose) {
              // Passou do cooldown mas sem nova interação
              return;
            }
          }

          const inactiveTime = now - state.lastActivityTime;
          const sessionTime = now - state.sessionStartTime;

          // Tempos de inatividade necessários
          const requiredInactiveTime = state.currentIntentLevel === 'HIGH' ? 8000 : 15000;
          
          if (inactiveTime > requiredInactiveTime && inactiveTime < requiredInactiveTime + 10000) {
            // 120000ms = 2 mins (tempo mínimo da primeira exibição se não for HIGH)
            const hasEnoughTime = sessionTime > 120000;
            this.evaluateTriggers('INACTIVITY', hasEnoughTime);
          }
        }, 2000); // Check a cada 2 segundos
      },

      setupExitIntent() {
        // Desktop only
        if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
          document.addEventListener('mouseleave', (e) => {
            if (state.isModalOpen || document.hidden) return;
            if (state.lastCloseTime && (Date.now() - state.lastCloseTime < 120000 || !state.hasInteractedSinceClose)) return;

            if (e.clientY <= 0) {
              const sessionTime = Date.now() - state.sessionStartTime;
              const hasEnoughTime = sessionTime > 120000;
              this.evaluateTriggers('EXIT_INTENT', hasEnoughTime);
            }
          });
        }
      },

      evaluateTriggers(triggerSource, hasEnoughSessionTime) {
        if (state.isModalOpen) return;

        const level = state.currentIntentLevel;

        let shouldShow = false;

        if (level === 'HIGH') {
          shouldShow = true; // High intent sempre mostra quando há gatilho
        } else if (level === 'MEDIUM' && hasEnoughSessionTime) {
          shouldShow = true; // Medium intent precisa de tempo de navegação
        }

        if (shouldShow) {
          log(`Exibição permitida. Motivo: Gatilho de ${triggerSource} atingido com intenção ${level}.`);
          RecommendationEngine.prepareAndShow();
        }
      }
    };

    // 4 & 5 & 6. RecommendationEngine & Popup
    const RecommendationEngine = {
      async prepareAndShow() {
        if (state.isModalOpen) return;
        state.isModalOpen = true;

        const { products } = state.data;
        const productsArray = Object.entries(products).map(([handle, data]) => ({ handle, ...data }));
        
        // Ordena produtos por score e visualizações
        productsArray.sort((a, b) => b.score - a.score || b.views - a.views);

        const maxCards = 3;
        const exactProducts = productsArray.slice(0, maxCards);
        
        const titleEl = document.getElementById('nyna-intent-title');
        const descEl = document.getElementById('nyna-intent-desc');

        // Mantém o texto fixo conforme a imagem
        if (titleEl) titleEl.textContent = 'Escolhas que combinam com você';
        if (descEl) descEl.textContent = 'Reunimos as peças que mais chamaram sua atenção.';

        RecommendationPopup.open();

        try {
          const grid = document.getElementById('nyna-intent-grid');
          const loading = document.getElementById('nyna-intent-loading');
          grid.innerHTML = '';
          
          let fetchedHTML = '';
          
          // 1. Fetch exact products by handle
          const fetchPromises = exactProducts.map(p => 
            fetch(`/products/${p.handle}?section_id=intent-recommendations-card`)
              .then(res => res.text())
              .then(html => {
                const doc = new DOMParser().parseFromString(html, 'text/html');
                const card = doc.querySelector('.shopify-section');
                return card ? card.innerHTML : '';
              })
              .catch(() => '')
          );

          const exactResults = await Promise.all(fetchPromises);
          fetchedHTML += exactResults.join('');

          // 2. Fetch related products via Recommendations API to fill up to 3
          if (exactProducts.length > 0) {
            const topProductId = exactProducts[0].id;
            const needed = maxCards - exactProducts.length;
            if (needed > 0) {
              const recRes = await fetch(`/recommendations/products?product_id=${topProductId}&limit=${needed + 2}&section_id=intent-recommendations`);
              if (recRes.ok) {
                const recHtml = await recRes.text();
                const doc = new DOMParser().parseFromString(recHtml, 'text/html');
                const cards = doc.querySelectorAll('.shopify-section .intent-minimal-card');
                
                let added = 0;
                cards.forEach(card => {
                  // Previne duplicidade simples verificando hrefs
                  const href = card.querySelector('a')?.getAttribute('href');
                  if (href && !fetchedHTML.includes(href) && added < needed) {
                    fetchedHTML += card.outerHTML;
                    added++;
                  }
                });
              }
            }
          }

          loading.style.display = 'none';
          grid.innerHTML = fetchedHTML;
          grid.style.display = 'flex';

          // Remove o bloqueio de apenas 1 por sessão, para permitir reabertura futura
          // sessionStorage.setItem(SESSION_KEY, 'true');
          // state.hasShownThisSession = true;

          // Inicia carrossel automático
          let autoScrollInterval;
          const startAutoScroll = () => {
            if (autoScrollInterval) clearInterval(autoScrollInterval);
            autoScrollInterval = setInterval(() => {
              const card = grid.querySelector('.intent-minimal-card');
              if (!card) return;
              const cardWidth = card.offsetWidth + parseInt(window.getComputedStyle(grid).gap || 24);
              if (grid.scrollLeft + grid.clientWidth >= grid.scrollWidth - 10) {
                grid.scrollTo({ left: 0, behavior: 'smooth' });
              } else {
                grid.scrollBy({ left: cardWidth, behavior: 'smooth' });
              }
            }, 3000);
          };
          const stopAutoScroll = () => clearInterval(autoScrollInterval);

          if (grid.querySelectorAll('.intent-minimal-card').length > maxCards) {
            startAutoScroll();
            grid.addEventListener('mouseenter', stopAutoScroll);
            grid.addEventListener('mouseleave', startAutoScroll);
            grid.addEventListener('touchstart', stopAutoScroll);
          }

        } catch (err) {
          log('Error fetching recommendations', err);
          RecommendationPopup.close(); // Close on failure
        }
      }
    };

    const RecommendationPopup = {
      open() {
        const engine = document.getElementById('nyna-intent-engine');
        
        // Compensate for scrollbar to prevent layout shift
        const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
        document.body.style.setProperty('--scrollbar-compensate', `${scrollbarWidth}px`);
        document.body.classList.add('nyna-intent-open');

        engine.classList.add('is-active');
        engine.setAttribute('aria-hidden', 'false');
        
        // Accessibility Focus Trap
        const closeBtn = document.querySelector('.nyna-intent-close');
        if (closeBtn) closeBtn.focus();
        
        document.addEventListener('keydown', this.handleEsc);
      },
      
      close() {
        const engine = document.getElementById('nyna-intent-engine');
        engine.classList.remove('is-active');
        engine.setAttribute('aria-hidden', 'true');
        state.isModalOpen = false;
        
        document.body.style.removeProperty('--scrollbar-compensate');
        document.body.classList.remove('nyna-intent-open');
        
        // Cooldown Logic
        state.lastCloseTime = Date.now();
        state.hasInteractedSinceClose = false;
        sessionStorage.setItem('nyna_last_close', state.lastCloseTime);
        log('Popup closed. Cooldown initiated.');
        
        document.removeEventListener('keydown', this.handleEsc);
      },
      
      handleEsc(e) {
        if (e.key === 'Escape') {
          RecommendationPopup.close();
        }
      },

      setupListeners() {
        document.querySelectorAll('[data-intent-close]').forEach(el => {
          el.addEventListener('click', (e) => {
            e.preventDefault();
            this.close();
          });
        });
      }
    };

    // Initialize
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        IntentTracker.init();
        BehaviorTrigger.init();
        RecommendationPopup.setupListeners();
      });
    } else {
      IntentTracker.init();
      BehaviorTrigger.init();
      RecommendationPopup.setupListeners();
    }

  })();
{% endjavascript %}
