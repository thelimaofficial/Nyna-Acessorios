{% comment %}
  Cart Drawer Snippet
  Responsável por exibir o carrinho lateral (drawer) com foco em design luxury/minimalista.
{% endcomment %}

<div class="cart-drawer-overlay" data-cart-overlay aria-hidden="true"></div>

<div class="cart-drawer" data-cart-drawer aria-hidden="true">
  <div class="cart-drawer__header">
    <button type="button" class="cart-drawer__close" data-cart-close aria-label="Fechar carrinho">
      {{ 'icon-x.svg' | inline_asset_content }}
    </button>
  </div>

  <div class="cart-drawer__content">
    {% if cart.item_count == 0 %}
      <div class="cart-drawer__empty">
        <h2 class="cart-drawer__empty-title">Sua sacola está vazia</h2>
        <p class="cart-drawer__empty-text">
          Tem uma conta? <a href="{{ routes.account_login_url }}">Faça login</a> para finalizar a<br> compra mais rápido.
        </p>
        <a href="{{ routes.all_products_collection_url }}" class="cart-drawer__btn">Continuar comprando</a>
      </div>
    {% else %}
      {% comment %}
        Lógica para exibir os itens do carrinho futuramente.
        Por ora, renderizamos a lista básica ou direcionamos para a página do carrinho.
      {% endcomment %}
      <div class="cart-drawer__items" style="text-align: center; margin-top: 2rem;">
         <p style="font-family: 'Inter', sans-serif;">Você tem {{ cart.item_count }} item(s) no carrinho.</p>
         <a href="{{ routes.cart_url }}" class="cart-drawer__btn" style="margin-top: 1rem;">Ver Carrinho</a>
      </div>
    {% endif %}
  </div>
</div>

<style>
  /* Base overlay styles */
  .cart-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(10, 10, 10, 0.15); /* Camada super leve, quase invisível */
    backdrop-filter: blur(2px); /* Desfoque mais fraco (~10%) */
    -webkit-backdrop-filter: blur(2px);
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), visibility 0.5s;
    will-change: opacity;
  }

  .cart-drawer-overlay.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Drawer styles */
  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 480px; /* Largura elegante estilo luxury e-commerce */
    height: 100vh;
    height: 100dvh;
    background-color: #ffffff;
    z-index: 1002;
    transform: translateX(100%);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); /* Animação moderna e fluida */
    will-change: transform;
    display: flex;
    flex-direction: column;
    border-top-left-radius: 32px; /* Cantos superiores esquerdos arredondados */
    box-shadow: -15px 0 40px rgba(0, 0, 0, 0.08);
  }

  .cart-drawer.is-active {
    transform: translateX(0);
  }

  .cart-drawer__header {
    display: flex;
    justify-content: flex-end; /* Apenas o botão X na direita */
    align-items: center;
    padding: 2.5rem 2.5rem 1rem 2.5rem;
    position: relative;
  }

  .cart-drawer__close {
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    color: #1a1a1a;
    transition: opacity 0.3s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cart-drawer__close svg {
    width: 1.25rem;
    height: 1.25rem;
    stroke-width: 1px;
  }

  .cart-drawer__close:hover {
    opacity: 0.5;
    transform: rotate(90deg);
  }

  .cart-drawer__content {
    flex: 1;
    overflow-y: auto;
    padding: 0 3rem 3rem 3rem;
    display: flex;
    flex-direction: column;
  }

  /* Empty state */
  .cart-drawer__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    height: 100%;
    margin: auto 0;
  }

  .cart-drawer__empty-title {
    font-family: 'Inter', sans-serif;
    font-size: 1.75rem;
    font-weight: 600;
    color: #000;
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }

  .cart-drawer__empty-text {
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    font-weight: 400;
    color: #2a2a2a;
    line-height: 1.6;
    margin-bottom: 2.5rem;
    max-width: 340px;
  }

  .cart-drawer__empty-text a {
    color: #000;
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .cart-drawer__empty-text a:hover {
    opacity: 0.6;
  }

  .cart-drawer__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.125rem 2.5rem;
    background-color: #6d5848; /* Tom de marrom sofisticado, inspirado em joias/acessórios */
    color: #ffffff;
    text-decoration: none;
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    font-weight: 400;
    border-radius: 100px; /* Pill shape elegante */
    transition: background-color 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    letter-spacing: 0.02em;
  }

  .cart-drawer__btn:hover {
    background-color: #554437;
    transform: translateY(-2px);
  }

  .cart-drawer__btn:active {
    transform: translateY(0);
  }

  /* O scroll do body agora é bloqueado via JavaScript para não quebrar o header sticky */

  @media (max-width: 768px) {
    .cart-drawer {
      max-width: 90%;
      border-top-left-radius: 24px;
    }
    .cart-drawer__header {
      padding: 1.5rem 1.5rem 1rem 1.5rem;
    }
    .cart-drawer__content {
      padding: 0 1.5rem 2rem 1.5rem;
    }
    .cart-drawer__empty-title {
      font-size: 1.5rem;
    }
  }
</style>

<script>
  (function () {
    const overlay = document.querySelector('[data-cart-overlay]');
    const drawer = document.querySelector('[data-cart-drawer]');
    const closeBtn = document.querySelector('[data-cart-close]');
    
    if (!overlay || !drawer) return;

    function preventScroll(e) {
      if (!e.target.closest('[data-cart-drawer]')) {
        e.preventDefault();
      }
    }

    function lockScroll() {
      window.addEventListener('wheel', preventScroll, { passive: false });
      window.addEventListener('touchmove', preventScroll, { passive: false });
    }

    function unlockScroll() {
      window.removeEventListener('wheel', preventScroll);
      window.removeEventListener('touchmove', preventScroll);
    }

    function openCart() {
      overlay.classList.add('is-active');
      drawer.classList.add('is-active');
      overlay.setAttribute('aria-hidden', 'false');
      drawer.setAttribute('aria-hidden', 'false');
      lockScroll();
    }

    function closeCart() {
      overlay.classList.remove('is-active');
      drawer.classList.remove('is-active');
      overlay.setAttribute('aria-hidden', 'true');
      drawer.setAttribute('aria-hidden', 'true');
      unlockScroll();
    }

    // Usando event delegation para capturar cliques no carrinho em qualquer lugar do site (header, rodapé, mobile, elementos dinâmicos)
    document.body.addEventListener('click', function(e) {
      // O closest() garante que clique no SVG ou SPAN dentro do link (A) será capturado corretamente
      const cartTrigger = e.target.closest('[data-cart-open], a[href="{{ routes.cart_url }}"]');
      
      if (cartTrigger) {
        // Só abre o drawer se não estiver na página do carrinho
        if (window.location.pathname !== '{{ routes.cart_url }}') {
          e.preventDefault();
          openCart();
        }
      }
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', function (e) {
        e.preventDefault();
        closeCart();
      });
    }

    // Fecha ao clicar fora (no overlay)
    overlay.addEventListener('click', closeCart);

    // Fecha ao pressionar ESC
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && drawer.classList.contains('is-active')) {
        closeCart();
      }
    });
  })();
</script>
