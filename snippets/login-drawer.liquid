{% doc %}
  Renders the customer authentication drawer with login and register views.

  @example
  {% render 'login-drawer' %}
{% enddoc %}

<div class="login-drawer-overlay" data-login-overlay aria-hidden="true"></div>

<div class="login-drawer" data-login-drawer aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="LoginDrawerTitle">
  <div class="login-drawer__header">
    <button type="button" class="login-drawer__close" data-login-close aria-label="Fechar login">
      {{ 'icon-x.svg' | inline_asset_content }}
    </button>
  </div>

  <div class="login-drawer__content">
    <div class="login-drawer__inner">
      <div class="login-drawer__view login-drawer__view--active" data-login-view="login">
        <h2 id="LoginDrawerTitle" class="login-drawer__title">Entrar na sua conta</h2>
        <p class="login-drawer__subtitle">Acesse seus pedidos, favoritos e checkout mais rapido.</p>

        {% form 'customer_login', class: 'login-drawer__form', novalidate: 'novalidate' %}
          {% if form.errors %}
            <div class="login-drawer__errors" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="login-drawer__field">
            <label for="CustomerEmail">Email</label>
            <input
              type="email"
              name="customer[email]"
              id="CustomerEmail"
              value="{{ form.email }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              placeholder="seu@email.com"
              required
              data-login-first-input
            >
          </div>

          <div class="login-drawer__field">
            <label for="CustomerPassword">Senha</label>
            <div class="login-drawer__password-field">
              <input
                type="password"
                name="customer[password]"
                id="CustomerPassword"
                autocomplete="current-password"
                placeholder="Senha"
                required
                data-password-input
              >
              <button type="button" class="login-drawer__password-toggle" aria-label="Mostrar senha" data-password-toggle>
                <span class="login-drawer__eye login-drawer__eye--show" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" stroke="currentColor" stroke-width="1.5"/>
                    <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </span>
                <span class="login-drawer__eye login-drawer__eye--hide" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M3 3l18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M10.6 5.2A10.8 10.8 0 0 1 12 5c6 0 9.5 7 9.5 7a17.4 17.4 0 0 1-3.1 4.1M6.5 6.7C3.9 8.5 2.5 12 2.5 12s3.5 7 9.5 7c1.7 0 3.2-.5 4.5-1.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </button>
            </div>
          </div>

          <div class="login-drawer__forgot-password">
            <a href="{{ routes.account_recover_url }}">Esqueceu sua senha?</a>
          </div>

          <button type="submit" class="login-drawer__btn">Entrar</button>
        {% endform %}

        <div class="login-drawer__footer">
          Nao possui conta?
          <button type="button" class="login-drawer__switch" data-auth-view-trigger="register">Criar conta</button>
        </div>
      </div>

      <div class="login-drawer__view" data-login-view="register" aria-hidden="true">
        <h2 class="login-drawer__title">Criar sua conta</h2>
        <p class="login-drawer__subtitle">Cadastre-se para acompanhar pedidos, salvar favoritos e viver uma experiencia exclusiva.</p>

        {% form 'create_customer', class: 'login-drawer__form login-drawer__form--register', novalidate: 'novalidate' %}
          {% if form.errors %}
            <div class="login-drawer__errors" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="login-drawer__field-row">
            <div class="login-drawer__field">
              <label for="RegisterFirstName">Nome</label>
              <input
                type="text"
                name="customer[first_name]"
                id="RegisterFirstName"
                autocomplete="given-name"
                placeholder="Nome"
                value="{{ form.first_name }}"
                required
                data-register-first-input
              >
            </div>

            <div class="login-drawer__field">
              <label for="RegisterLastName">Sobrenome</label>
              <input
                type="text"
                name="customer[last_name]"
                id="RegisterLastName"
                autocomplete="family-name"
                placeholder="Sobrenome"
                value="{{ form.last_name }}"
                required
              >
            </div>
          </div>

          <div class="login-drawer__field">
            <label for="RegisterEmail">Email</label>
            <input
              type="email"
              name="customer[email]"
              id="RegisterEmail"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              placeholder="seu@email.com"
              value="{{ form.email }}"
              required
            >
          </div>

          <div class="login-drawer__field">
            <label for="RegisterPassword">Senha</label>
            <div class="login-drawer__password-field">
              <input
                type="password"
                name="customer[password]"
                id="RegisterPassword"
                autocomplete="new-password"
                placeholder="Senha"
                required
                data-password-input
              >
              <button type="button" class="login-drawer__password-toggle" aria-label="Mostrar senha" data-password-toggle>
                <span class="login-drawer__eye login-drawer__eye--show" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" stroke="currentColor" stroke-width="1.5"/>
                    <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </span>
                <span class="login-drawer__eye login-drawer__eye--hide" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M3 3l18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M10.6 5.2A10.8 10.8 0 0 1 12 5c6 0 9.5 7 9.5 7a17.4 17.4 0 0 1-3.1 4.1M6.5 6.7C3.9 8.5 2.5 12 2.5 12s3.5 7 9.5 7c1.7 0 3.2-.5 4.5-1.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </button>
            </div>
          </div>

          <div class="login-drawer__field">
            <label for="RegisterPasswordConfirmation">Confirmar senha</label>
            <div class="login-drawer__password-field">
              <input
                type="password"
                id="RegisterPasswordConfirmation"
                autocomplete="new-password"
                placeholder="Confirmar senha"
                required
                data-register-password-confirmation
                data-password-input
              >
              <button type="button" class="login-drawer__password-toggle" aria-label="Mostrar senha" data-password-toggle>
                <span class="login-drawer__eye login-drawer__eye--show" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" stroke="currentColor" stroke-width="1.5"/>
                    <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </span>
                <span class="login-drawer__eye login-drawer__eye--hide" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M3 3l18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M10.6 5.2A10.8 10.8 0 0 1 12 5c6 0 9.5 7 9.5 7a17.4 17.4 0 0 1-3.1 4.1M6.5 6.7C3.9 8.5 2.5 12 2.5 12s3.5 7 9.5 7c1.7 0 3.2-.5 4.5-1.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </button>
            </div>
          </div>

          <p class="login-drawer__match-error" data-register-match-error role="alert">As senhas precisam ser iguais.</p>

          <button type="submit" class="login-drawer__btn">Criar conta</button>
        {% endform %}

        <div class="login-drawer__footer">
          Ja possui conta?
          <button type="button" class="login-drawer__switch" data-auth-view-trigger="login">Entrar</button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .login-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(10, 10, 10, 0.15);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), visibility 0.5s;
    will-change: opacity;
  }

  .login-drawer-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  .login-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 480px;
    height: 100vh;
    height: 100dvh;
    background-color: #ffffff;
    z-index: 1002;
    transform: translateX(100%);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
    display: flex;
    flex-direction: column;
    border-top-left-radius: 32px;
    border-bottom-left-radius: 32px;
    box-shadow: -15px 0 40px rgba(0, 0, 0, 0.08);
  }

  .login-drawer.is-active {
    transform: translateX(0);
  }

  .login-drawer__header {
    display: flex;
    justify-content: flex-end;
    padding: 2.5rem 2.5rem 1rem;
    flex-shrink: 0;
  }

  .login-drawer__close,
  .login-drawer__switch {
    background: none;
    border: none;
    cursor: pointer;
    color: #1a1a1a;
    font: inherit;
  }

  .login-drawer__close {
    padding: 0.5rem;
    transition: opacity 0.3s ease, transform 0.4s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .login-drawer__close svg {
    width: 1.25rem;
    height: 1.25rem;
    stroke-width: 1px;
  }

  .login-drawer__close:hover {
    opacity: 0.5;
    transform: rotate(90deg);
  }

  .login-drawer__content {
    flex: 1;
    overflow-y: auto;
    padding: 2.5rem 3rem 3rem;
    display: flex;
    flex-direction: column;
  }

  .login-drawer__inner,
  .login-drawer__view {
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }

  .login-drawer__view {
    display: none;
  }

  .login-drawer__view--active {
    display: flex;
  }

  .login-drawer__title {
    font-family: 'Inter', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 0.625rem;
    letter-spacing: 0;
    text-align: center;
  }

  .login-drawer__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: #555;
    line-height: 1.5;
    margin: 0 0 2.5rem;
    text-align: center;
  }

  .login-drawer__form {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .login-drawer__field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .login-drawer__field {
    margin-bottom: 1.125rem;
    display: flex;
    flex-direction: column;
  }

  .login-drawer__field label {
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #1a1a1a;
    margin-bottom: 0.5rem;
    letter-spacing: 0.01em;
  }

  .login-drawer__field input {
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    padding: 0.875rem 1.375rem;
    border: 1px solid #e0e0e0;
    border-radius: 9999px;
    outline: none;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
    width: 100%;
    color: #1a1a1a;
    background: #fff;
  }

  .login-drawer__field input::placeholder {
    color: #bbb;
  }

  .login-drawer__field input:focus {
    border-color: #7d5a44;
    box-shadow: 0 0 0 3px rgba(125, 90, 68, 0.08);
  }

  .login-drawer__password-field {
    position: relative;
    width: 100%;
  }

  .login-drawer__password-field input {
    padding-right: 3rem;
  }

  .login-drawer__password-toggle {
    position: absolute;
    top: 50%;
    right: 0.85rem;
    width: 1.75rem;
    height: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #7b746f;
    cursor: pointer;
    transform: translateY(-50%);
    transition: color 0.2s ease, background 0.2s ease;
  }

  .login-drawer__password-toggle:hover {
    color: #1a1a1a;
    background: #f5f1ee;
  }

  .login-drawer__eye {
    width: 1.05rem;
    height: 1.05rem;
    display: block;
  }

  .login-drawer__eye svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .login-drawer__eye--hide,
  .login-drawer__password-toggle.is-visible .login-drawer__eye--show {
    display: none;
  }

  .login-drawer__password-toggle.is-visible .login-drawer__eye--hide {
    display: block;
  }

  .login-drawer__forgot-password {
    text-align: right;
    margin-top: -0.25rem;
    margin-bottom: 2rem;
  }

  .login-drawer__forgot-password a,
  .login-drawer__switch {
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #1a1a1a;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
  }

  .login-drawer__forgot-password a:hover,
  .login-drawer__switch:hover {
    opacity: 0.6;
  }

  .login-drawer__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 1rem;
    background-color: #7d5a44;
    color: #ffffff;
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    font-weight: 500;
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    letter-spacing: 0.01em;
    transition: background-color 0.25s ease, transform 0.25s ease;
  }

  .login-drawer__btn:hover {
    background-color: #5e4233;
    transform: translateY(-1px);
  }

  .login-drawer__btn:active {
    transform: translateY(0);
  }

  .login-drawer__errors,
  .login-drawer__match-error {
    background-color: #fff5f5;
    border: 1px solid #ffcccc;
    border-radius: 8px;
    padding: 0.75rem 1rem;
    margin: 0 0 1.5rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    color: #c0392b;
    line-height: 1.5;
  }

  .login-drawer__errors ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .login-drawer__match-error {
    display: none;
    margin-top: -0.25rem;
  }

  .login-drawer__match-error.is-visible {
    display: block;
  }

  .login-drawer__footer {
    margin-top: auto;
    padding-top: 2.5rem;
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    color: #555;
  }

  @media (max-width: 768px) {
    .login-drawer {
      max-width: 90%;
      border-top-left-radius: 24px;
      border-bottom-left-radius: 24px;
    }

    .login-drawer__content {
      padding: 2rem 1.75rem 2.5rem;
    }

    .login-drawer__field-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>

<script>
  (function () {
    const overlay = document.querySelector('[data-login-overlay]');
    const drawer = document.querySelector('[data-login-drawer]');
    const closeBtn = document.querySelector('[data-login-close]');
    const firstInput = document.querySelector('[data-login-first-input]');
    const registerFirstInput = document.querySelector('[data-register-first-input]');
    const viewTriggers = document.querySelectorAll('[data-auth-view-trigger]');
    let lastFocusedElement;

    if (!overlay || !drawer) return;

    function setView(viewName) {
      drawer.querySelectorAll('[data-login-view]').forEach(function (view) {
        const isActive = view.dataset.loginView === viewName;
        view.classList.toggle('login-drawer__view--active', isActive);
        view.setAttribute('aria-hidden', isActive ? 'false' : 'true');
      });

      setTimeout(function () {
        if (viewName === 'register' && registerFirstInput) {
          registerFirstInput.focus();
        } else if (firstInput) {
          firstInput.focus();
        }
      }, 80);
    }

    drawer.querySelectorAll('[data-password-toggle]').forEach(function (toggle) {
      const field = toggle.closest('.login-drawer__password-field');
      const input = field ? field.querySelector('[data-password-input]') : null;

      if (!input) return;

      toggle.addEventListener('click', function () {
        const shouldShow = input.type === 'password';
        input.type = shouldShow ? 'text' : 'password';
        toggle.classList.toggle('is-visible', shouldShow);
        toggle.setAttribute('aria-label', shouldShow ? 'Ocultar senha' : 'Mostrar senha');
      });
    });

    viewTriggers.forEach(function (trigger) {
      trigger.addEventListener('click', function () {
        setView(trigger.dataset.authViewTrigger);
      });
    });

    const registerForm = drawer.querySelector('.login-drawer__form--register');

    if (registerForm) {
      registerForm.addEventListener('submit', function (event) {
        const password = registerForm.querySelector('#RegisterPassword');
        const confirmation = registerForm.querySelector('[data-register-password-confirmation]');
        const error = registerForm.querySelector('[data-register-match-error]');

        if (!password || !confirmation || !error) return;

        if (password.value !== confirmation.value) {
          event.preventDefault();
          error.classList.add('is-visible');
          confirmation.setAttribute('aria-invalid', 'true');
          confirmation.focus();
        } else {
          error.classList.remove('is-visible');
          confirmation.removeAttribute('aria-invalid');
        }
      });
    }

    function preventScroll(e) {
      if (!e.target.closest('[data-login-drawer]')) {
        e.preventDefault();
      }
    }

    function lockScroll() {
      window.addEventListener('wheel', preventScroll, { passive: false });
      window.addEventListener('touchmove', preventScroll, { passive: false });
    }

    function unlockScroll() {
      window.removeEventListener('wheel', preventScroll);
      window.removeEventListener('touchmove', preventScroll);
    }

    function openLogin() {
      lastFocusedElement = document.activeElement;
      setView('login');
      overlay.classList.add('is-active');
      drawer.classList.add('is-active');
      overlay.setAttribute('aria-hidden', 'false');
      drawer.setAttribute('aria-hidden', 'false');
      lockScroll();
    }

    function closeLogin() {
      overlay.classList.remove('is-active');
      drawer.classList.remove('is-active');
      overlay.setAttribute('aria-hidden', 'true');
      drawer.setAttribute('aria-hidden', 'true');
      unlockScroll();
      if (lastFocusedElement) lastFocusedElement.focus();
    }

    document.body.addEventListener('click', function(e) {
      const loginTrigger = e.target.closest('[data-login-open]');
      if (loginTrigger) {
        e.preventDefault();
        openLogin();
      }
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', function (e) {
        e.preventDefault();
        closeLogin();
      });
    }

    overlay.addEventListener('click', closeLogin);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && drawer.classList.contains('is-active')) {
        closeLogin();
      }

      if (e.key === 'Tab' && drawer.classList.contains('is-active')) {
        const activeView = drawer.querySelector('[data-login-view].login-drawer__view--active');
        const focusRoot = activeView || drawer;
        const focusable = focusRoot.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (!first || !last) return;

        if (e.shiftKey) {
          if (document.activeElement === first) { last.focus(); e.preventDefault(); }
        } else {
          if (document.activeElement === last) { first.focus(); e.preventDefault(); }
        }
      }
    });
  })();
</script>
