{% comment %}
  Login Drawer Snippet
  Responsável por exibir o formulário de login lateral inspirado no cart drawer.
{% endcomment %}

<div class="login-drawer-overlay" data-login-overlay aria-hidden="true"></div>

<div class="login-drawer" data-login-drawer aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="LoginDrawerTitle">
  <div class="login-drawer__header">
    <button type="button" class="login-drawer__close" data-login-close aria-label="Fechar login">
      {{ 'icon-x.svg' | inline_asset_content }}
    </button>
  </div>

  <div class="login-drawer__content">
    <div class="login-drawer__inner">
      <h2 id="LoginDrawerTitle" class="login-drawer__title">Entrar na sua conta</h2>
      <p class="login-drawer__subtitle">Acesse seus pedidos, favoritos e checkout mais rápido.</p>

      {% form 'customer_login', class: 'login-drawer__form' %}
        {{ form.errors | default_errors }}
        
        <div class="login-drawer__field">
          <label for="CustomerEmail">Email</label>
          <input type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" autocorrect="off" autocapitalize="off" placeholder="seu@email.com" required data-login-first-input>
        </div>

        <div class="login-drawer__field">
          <label for="CustomerPassword">Senha</label>
          <input type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password" placeholder="••••••••" required>
        </div>
        
        <div class="login-drawer__forgot-password">
          <a href="{{ routes.account_recover_url }}">Esqueceu sua senha?</a>
        </div>

        <button type="submit" class="login-drawer__btn">Entrar</button>
      {% endform %}

      <div class="login-drawer__divider">
        <span>ou</span>
      </div>

      <div class="login-drawer__social">
        <a href="#" class="login-drawer__social-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
          Continuar com Google
        </a>
        <a href="#" class="login-drawer__social-btn">
          {{ 'icon-apple.svg' | inline_asset_content }}
          Continuar com Apple
        </a>
      </div>

      <div class="login-drawer__footer">
        Não possui conta? <a href="{{ routes.account_register_url }}">Criar conta</a>
      </div>
    </div>
  </div>
</div>

<style>
  /* Base overlay styles - mesmo do carrinho */
  .login-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(10, 10, 10, 0.15);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), visibility 0.5s;
    will-change: opacity;
  }

  .login-drawer-overlay.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Drawer styles */
  .login-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 480px; /* Largura igual a do carrinho */
    height: 100vh;
    height: 100dvh;
    background-color: #ffffff;
    z-index: 1002;
    transform: translateX(100%);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
    display: flex;
    flex-direction: column;
    border-top-left-radius: 32px;
    box-shadow: -15px 0 40px rgba(0, 0, 0, 0.08);
  }

  .login-drawer.is-active {
    transform: translateX(0);
  }

  .login-drawer__header {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    padding: 2.5rem 2.5rem 0.5rem 2.5rem;
    position: relative;
  }

  .login-drawer__close {
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    color: #1a1a1a;
    transition: opacity 0.3s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .login-drawer__close svg {
    width: 1.25rem;
    height: 1.25rem;
    stroke-width: 1px;
  }

  .login-drawer__close:hover {
    opacity: 0.5;
    transform: rotate(90deg);
  }

  .login-drawer__content {
    flex: 1;
    overflow-y: auto;
    padding: 0 3.5rem 3.5rem 3.5rem;
    display: flex;
    flex-direction: column;
  }

  .login-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .login-drawer__title {
    font-family: 'Inter', sans-serif;
    font-size: 1.625rem;
    font-weight: 600;
    color: #000;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.01em;
    text-align: center;
  }

  .login-drawer__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    font-weight: 400;
    color: #2a2a2a;
    line-height: 1.5;
    margin: 0 0 2rem 0;
    text-align: center;
  }

  .login-drawer__form {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .login-drawer__field {
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
  }

  .login-drawer__field label {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    color: #000;
    margin-bottom: 0.5rem;
  }

  .login-drawer__field input {
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    padding: 0.875rem 1.25rem;
    border: 1px solid #e0e0e0;
    border-radius: 100px; /* Pill shape para inputs baseada na imagem */
    outline: none;
    transition: border-color 0.3s ease;
    width: 100%;
  }

  .login-drawer__field input::placeholder {
    color: #a0a0a0;
  }

  .login-drawer__field input:focus {
    border-color: #6d5848;
  }

  .login-drawer__forgot-password {
    text-align: right;
    margin-top: -0.5rem;
    margin-bottom: 1.5rem;
  }

  .login-drawer__forgot-password a {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    color: #000;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: opacity 0.2s ease;
  }

  .login-drawer__forgot-password a:hover {
    opacity: 0.6;
  }

  .login-drawer__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.125rem 2.5rem;
    background-color: #6d5848; /* Tom de marrom sofisticado */
    color: #ffffff;
    text-decoration: none;
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    font-weight: 400;
    border-radius: 100px;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    letter-spacing: 0.02em;
    width: 100%;
  }

  .login-drawer__btn:hover {
    background-color: #554437;
    transform: translateY(-2px);
  }

  .login-drawer__btn:active {
    transform: translateY(0);
  }

  .login-drawer__divider {
    display: flex;
    align-items: center;
    text-align: center;
    margin: 2rem 0;
  }

  .login-drawer__divider::before,
  .login-drawer__divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid #e0e0e0;
  }

  .login-drawer__divider span {
    padding: 0 1rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    color: #000;
    font-weight: 500;
  }

  .login-drawer__social {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .login-drawer__social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem;
    background-color: #fff;
    color: #000;
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    font-weight: 500;
    border: 1px solid #e0e0e0;
    border-radius: 100px;
    text-decoration: none;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .login-drawer__social-btn svg {
    width: 18px;
    height: 18px;
    display: block;
  }

  .login-drawer__social-btn:hover {
    background-color: #f9f9f9;
    border-color: #d0d0d0;
  }

  .login-drawer__footer {
    margin-top: auto;
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    color: #2a2a2a;
    padding-top: 1rem;
  }

  .login-drawer__footer a {
    color: #000;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: opacity 0.2s ease;
  }

  .login-drawer__footer a:hover {
    opacity: 0.6;
  }

  /* O scroll do body agora é bloqueado via JavaScript para não quebrar o header sticky */

  @media (max-width: 768px) {
    .login-drawer {
      max-width: 90%;
      border-top-left-radius: 24px;
    }
    .login-drawer__content {
      padding: 0 1.5rem 2rem 1.5rem;
    }
  }
</style>

<script>
  (function () {
    const overlay = document.querySelector('[data-login-overlay]');
    const drawer = document.querySelector('[data-login-drawer]');
    const closeBtn = document.querySelector('[data-login-close]');
    const firstInput = document.querySelector('[data-login-first-input]');
    let lastFocusedElement;
    
    if (!overlay || !drawer) return;

    function preventScroll(e) {
      if (!e.target.closest('[data-login-drawer]')) {
        e.preventDefault();
      }
    }

    function lockScroll() {
      window.addEventListener('wheel', preventScroll, { passive: false });
      window.addEventListener('touchmove', preventScroll, { passive: false });
    }

    function unlockScroll() {
      window.removeEventListener('wheel', preventScroll);
      window.removeEventListener('touchmove', preventScroll);
    }

    function openLogin() {
      // Armazena o elemento que tinha o foco antes de abrir o modal
      lastFocusedElement = document.activeElement;
      
      overlay.classList.add('is-active');
      drawer.classList.add('is-active');
      overlay.setAttribute('aria-hidden', 'false');
      drawer.setAttribute('aria-hidden', 'false');
      lockScroll();
      
      // Foco automático no input de e-mail (usando timeout para aguardar a renderização inicial/animação)
      setTimeout(() => {
        if (firstInput) firstInput.focus();
      }, 100);
    }

    function closeLogin() {
      overlay.classList.remove('is-active');
      drawer.classList.remove('is-active');
      overlay.setAttribute('aria-hidden', 'true');
      drawer.setAttribute('aria-hidden', 'true');
      unlockScroll();
      
      // Retorna foco para o botão de login
      if (lastFocusedElement) {
        lastFocusedElement.focus();
      }
    }

    // Usando event delegation para capturar cliques no ícone de login
    // Adicionei verificação se o usuário já não está logado para não abrir no /account mas sim no /account/login
    document.body.addEventListener('click', function(e) {
      const loginTrigger = e.target.closest('[data-login-open], a[href="{{ routes.account_login_url }}"]');
      
      if (loginTrigger) {
        if (window.location.pathname !== '{{ routes.account_login_url }}' && window.location.pathname !== '{{ routes.account_url }}') {
          e.preventDefault();
          openLogin();
        }
      }
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', function (e) {
        e.preventDefault();
        closeLogin();
      });
    }

    overlay.addEventListener('click', closeLogin);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && drawer.classList.contains('is-active')) {
        closeLogin();
      }
      
      // Trap focus simplificado (apenas previne ir muito fora do modal)
      if (e.key === 'Tab' && drawer.classList.contains('is-active')) {
        const focusableElements = drawer.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
        const firstElement = focusableElements[0];
        const lastElement = focusableElements[focusableElements.length - 1];

        if (e.shiftKey) {
          if (document.activeElement === firstElement) {
            lastElement.focus();
            e.preventDefault();
          }
        } else {
          if (document.activeElement === lastElement) {
            firstElement.focus();
            e.preventDefault();
          }
        }
      }
    });
  })();
</script>
