{% comment %}
  Login Drawer Snippet
  - Layout limpo e minimalista seguindo referência visual.
  - Se o cliente já estiver logado, o ícone no header redireciona direto para a conta (ver header.liquid).
{% endcomment %}

<div class="login-drawer-overlay" data-login-overlay aria-hidden="true"></div>

<div class="login-drawer" data-login-drawer aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="LoginDrawerTitle">
  <div class="login-drawer__header">
    <button type="button" class="login-drawer__close" data-login-close aria-label="Fechar login">
      {{ 'icon-x.svg' | inline_asset_content }}
    </button>
  </div>

  <div class="login-drawer__content">
    <div class="login-drawer__inner">
      <h2 id="LoginDrawerTitle" class="login-drawer__title">Entrar na sua conta</h2>
      <p class="login-drawer__subtitle">Acesse seus pedidos, favoritos e checkout mais rápido.</p>

      {% form 'customer_login', class: 'login-drawer__form', novalidate: 'novalidate' %}
        {% if form.errors %}
          <div class="login-drawer__errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="login-drawer__field">
          <label for="CustomerEmail">Email</label>
          <input
            type="email"
            name="customer[email]"
            id="CustomerEmail"
            value="{{ form.email }}"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            placeholder="seu@email.com"
            required
            data-login-first-input
          >
        </div>

        <div class="login-drawer__field">
          <label for="CustomerPassword">Senha</label>
          <input
            type="password"
            name="customer[password]"
            id="CustomerPassword"
            autocomplete="current-password"
            placeholder="••••••••"
            required
          >
        </div>

        <div class="login-drawer__forgot-password">
          <a href="{{ routes.account_recover_url }}">Esqueceu sua senha?</a>
        </div>

        <button type="submit" class="login-drawer__btn">Entrar</button>
      {% endform %}

      <div class="login-drawer__footer">
        Não possui conta? <a href="{{ routes.account_register_url }}">Criar conta</a>
      </div>
    </div>
  </div>
</div>

<style>
  /* Overlay — igual aos outros drawers */
  .login-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(10, 10, 10, 0.15);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), visibility 0.5s;
    will-change: opacity;
  }

  .login-drawer-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  /* Drawer */
  .login-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 480px;
    height: 100vh;
    height: 100dvh;
    background-color: #ffffff;
    z-index: 1002;
    transform: translateX(100%);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
    display: flex;
    flex-direction: column;
    border-top-left-radius: 32px;
    border-bottom-left-radius: 32px;
    box-shadow: -15px 0 40px rgba(0, 0, 0, 0.08);
  }

  .login-drawer.is-active {
    transform: translateX(0);
  }

  /* Header (só o X) */
  .login-drawer__header {
    display: flex;
    justify-content: flex-end;
    padding: 2.5rem 2.5rem 1rem 2.5rem;
    flex-shrink: 0;
  }

  .login-drawer__close {
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    color: #1a1a1a;
    transition: opacity 0.3s ease, transform 0.4s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .login-drawer__close svg {
    width: 1.25rem;
    height: 1.25rem;
    stroke-width: 1px;
  }

  .login-drawer__close:hover {
    opacity: 0.5;
    transform: rotate(90deg);
  }

  /* Conteúdo */
  .login-drawer__content {
    flex: 1;
    overflow-y: auto;
    padding: 2.5rem 3rem 3rem;
    display: flex;
    flex-direction: column;
  }

  .login-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* Título e subtítulo */
  .login-drawer__title {
    font-family: 'Inter', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 0.625rem 0;
    letter-spacing: -0.02em;
    text-align: center;
  }

  .login-drawer__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: #555;
    line-height: 1.5;
    margin: 0 0 2.5rem 0;
    text-align: center;
  }

  /* Formulário */
  .login-drawer__form {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .login-drawer__field {
    margin-bottom: 1.125rem;
    display: flex;
    flex-direction: column;
  }

  .login-drawer__field label {
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #1a1a1a;
    margin-bottom: 0.5rem;
    letter-spacing: 0.01em;
  }

  .login-drawer__field input {
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    padding: 0.875rem 1.375rem;
    border: 1px solid #e0e0e0;
    border-radius: 9999px;
    outline: none;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
    width: 100%;
    color: #1a1a1a;
    background: #fff;
  }

  .login-drawer__field input::placeholder {
    color: #bbb;
  }

  .login-drawer__field input:focus {
    border-color: #7d5a44;
    box-shadow: 0 0 0 3px rgba(125, 90, 68, 0.08);
  }

  /* Esqueceu senha */
  .login-drawer__forgot-password {
    text-align: right;
    margin-top: -0.25rem;
    margin-bottom: 2rem;
  }

  .login-drawer__forgot-password a {
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #1a1a1a;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
  }

  .login-drawer__forgot-password a:hover {
    opacity: 0.6;
  }

  /* Botão Entrar */
  .login-drawer__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 1rem;
    background-color: #7d5a44;
    color: #ffffff;
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    font-weight: 500;
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    letter-spacing: 0.01em;
    transition: background-color 0.25s ease, transform 0.25s ease;
  }

  .login-drawer__btn:hover {
    background-color: #5e4233;
    transform: translateY(-1px);
  }

  .login-drawer__btn:active {
    transform: translateY(0);
  }

  /* Erros */
  .login-drawer__errors {
    background-color: #fff5f5;
    border: 1px solid #ffcccc;
    border-radius: 8px;
    padding: 0.75rem 1rem;
    margin-bottom: 1.5rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    color: #c0392b;
    line-height: 1.5;
  }

  .login-drawer__errors ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Rodapé "Criar conta" */
  .login-drawer__footer {
    margin-top: auto;
    padding-top: 2.5rem;
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    color: #555;
  }

  .login-drawer__footer a {
    color: #1a1a1a;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
  }

  .login-drawer__footer a:hover {
    opacity: 0.6;
  }

  @media (max-width: 768px) {
    .login-drawer {
      max-width: 90%;
      border-top-left-radius: 24px;
      border-bottom-left-radius: 24px;
    }
    .login-drawer__content {
      padding: 2rem 1.75rem 2.5rem;
    }
  }
</style>

<script>
  (function () {
    const overlay = document.querySelector('[data-login-overlay]');
    const drawer = document.querySelector('[data-login-drawer]');
    const closeBtn = document.querySelector('[data-login-close]');
    const firstInput = document.querySelector('[data-login-first-input]');
    let lastFocusedElement;

    if (!overlay || !drawer) return;

    function preventScroll(e) {
      if (!e.target.closest('[data-login-drawer]')) {
        e.preventDefault();
      }
    }

    function lockScroll() {
      window.addEventListener('wheel', preventScroll, { passive: false });
      window.addEventListener('touchmove', preventScroll, { passive: false });
    }

    function unlockScroll() {
      window.removeEventListener('wheel', preventScroll);
      window.removeEventListener('touchmove', preventScroll);
    }

    function openLogin() {
      lastFocusedElement = document.activeElement;
      overlay.classList.add('is-active');
      drawer.classList.add('is-active');
      overlay.setAttribute('aria-hidden', 'false');
      drawer.setAttribute('aria-hidden', 'false');
      lockScroll();
      setTimeout(() => { if (firstInput) firstInput.focus(); }, 120);
    }

    function closeLogin() {
      overlay.classList.remove('is-active');
      drawer.classList.remove('is-active');
      overlay.setAttribute('aria-hidden', 'true');
      drawer.setAttribute('aria-hidden', 'true');
      unlockScroll();
      if (lastFocusedElement) lastFocusedElement.focus();
    }

    document.body.addEventListener('click', function(e) {
      const loginTrigger = e.target.closest('[data-login-open]');
      if (loginTrigger) {
        e.preventDefault();
        openLogin();
      }
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', function (e) {
        e.preventDefault();
        closeLogin();
      });
    }

    overlay.addEventListener('click', closeLogin);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && drawer.classList.contains('is-active')) {
        closeLogin();
      }

      if (e.key === 'Tab' && drawer.classList.contains('is-active')) {
        const focusable = drawer.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey) {
          if (document.activeElement === first) { last.focus(); e.preventDefault(); }
        } else {
          if (document.activeElement === last) { first.focus(); e.preventDefault(); }
        }
      }
    });
  })();
</script>
