{% doc %}
  Renders the customer authentication drawer with login and register views.

  @example
  {% render 'login-drawer' %}
{% enddoc %}

<div class="login-drawer-overlay" data-login-overlay aria-hidden="true"></div>

<div class="login-drawer" data-login-drawer aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="LoginDrawerTitle">
  <div class="login-drawer__header">
    <button type="button" class="login-drawer__close" data-login-close aria-label="Fechar login">
      {{ 'icon-x.svg' | inline_asset_content }}
    </button>
  </div>

  <div class="login-drawer__content">
    <div class="login-drawer__inner">
      
      {%- comment -%} RECOVER VIEW {%- endcomment -%}
      <div class="login-drawer__view" data-login-view="recover" aria-hidden="true">
        <h2 class="login-drawer__title">Redefinir senha</h2>
        <p class="login-drawer__subtitle">Enviaremos um e-mail com instruções para você redefinir sua senha.</p>

        {% form 'recover_customer_password', class: 'login-drawer__form' %}
          {% assign recover_success = form.posted_successfully? %}
          {% if form.errors %}
            <div class="login-drawer__errors" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          {% if recover_success %}
            <div class="login-drawer__success" role="alert">
              Enviamos um e-mail com as instruções para redefinir sua senha.
            </div>
          {% endif %}

          <div class="login-drawer__field">
            <label for="RecoverEmailDrawer">E-mail</label>
            <input
              type="email"
              name="email"
              id="RecoverEmailDrawer"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              placeholder="seu@email.com"
              required
              data-recover-first-input
            >
          </div>

          <button type="submit" class="login-drawer__btn">Enviar instruções</button>

          <div class="login-drawer__footer">
            <button type="button" class="login-drawer__switch" data-auth-view-trigger="login">Cancelar</button>
          </div>
        {% endform %}
      </div>

      {%- comment -%} LOGIN VIEW {%- endcomment -%}
      <div class="login-drawer__view login-drawer__view--active" data-login-view="login">
        <h2 id="LoginDrawerTitle" class="login-drawer__title">Entrar na sua conta</h2>
        <p class="login-drawer__subtitle">Acesse seus pedidos, favoritos e uma experiência exclusiva.</p>

        {% form 'customer_login', class: 'login-drawer__form', novalidate: 'novalidate' %}
          {% if form.errors %}
            <div class="login-drawer__errors" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="login-drawer__field">
            <label for="CustomerEmailDrawer">E-mail</label>
            <input
              type="email"
              name="customer[email]"
              id="CustomerEmailDrawer"
              value="{{ form.email }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              placeholder="seu@email.com"
              required
              data-login-first-input
            >
          </div>

          <div class="login-drawer__field">
            <label for="CustomerPasswordDrawer">Senha</label>
            <div class="login-drawer__password-field">
              <input
                type="password"
                name="customer[password]"
                id="CustomerPasswordDrawer"
                autocomplete="current-password"
                placeholder="Senha"
                required
                data-password-input
              >
              <button type="button" class="login-drawer__password-toggle" aria-label="Mostrar senha" data-password-toggle>
                <span class="login-drawer__eye login-drawer__eye--show" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" stroke="currentColor" stroke-width="1.5"/>
                    <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </span>
                <span class="login-drawer__eye login-drawer__eye--hide" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M3 3l18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M10.6 5.2A10.8 10.8 0 0 1 12 5c6 0 9.5 7 9.5 7a17.4 17.4 0 0 1-3.1 4.1M6.5 6.7C3.9 8.5 2.5 12 2.5 12s3.5 7 9.5 7c1.7 0 3.2-.5 4.5-1.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </button>
            </div>
          </div>

          <div class="login-drawer__forgot-password">
            <button type="button" class="login-drawer__switch" data-auth-view-trigger="recover">Esqueceu sua senha?</button>
          </div>

          <button type="submit" class="login-drawer__btn">Entrar</button>
        {% endform %}

        <div class="login-drawer__divider">ou</div>

        <a href="#" class="login-drawer__btn-social" onclick="event.preventDefault(); alert('Login social requer configuração via aplicativo Shopify.');">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Continuar com Google
        </a>

        <div class="login-drawer__footer">
          Não possui conta?
          <button type="button" class="login-drawer__switch" data-auth-view-trigger="register">Criar conta</button>
        </div>
      </div>

      {%- comment -%} REGISTER VIEW {%- endcomment -%}
      <div class="login-drawer__view" data-login-view="register" aria-hidden="true">
        <h2 class="login-drawer__title">Criar sua conta</h2>
        <p class="login-drawer__subtitle">Cadastre-se para acompanhar pedidos, salvar favoritos e viver uma experiência exclusiva.</p>

        {% form 'create_customer', class: 'login-drawer__form login-drawer__form--register', novalidate: 'novalidate' %}
          {% if form.errors %}
            <div class="login-drawer__errors" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="login-drawer__field-row">
            <div class="login-drawer__field">
              <label for="RegisterFirstNameDrawer">Nome</label>
              <input
                type="text"
                name="customer[first_name]"
                id="RegisterFirstNameDrawer"
                autocomplete="given-name"
                placeholder="Nome"
                value="{{ form.first_name }}"
                required
                data-register-first-input
              >
            </div>

            <div class="login-drawer__field">
              <label for="RegisterLastNameDrawer">Sobrenome</label>
              <input
                type="text"
                name="customer[last_name]"
                id="RegisterLastNameDrawer"
                autocomplete="family-name"
                placeholder="Sobrenome"
                value="{{ form.last_name }}"
                required
              >
            </div>
          </div>

          <div class="login-drawer__field">
            <label for="RegisterEmailDrawer">E-mail</label>
            <input
              type="email"
              name="customer[email]"
              id="RegisterEmailDrawer"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              placeholder="seu@email.com"
              value="{{ form.email }}"
              required
            >
          </div>

          <div class="login-drawer__field">
            <label for="RegisterPasswordDrawer">Senha</label>
            <div class="login-drawer__password-field">
              <input
                type="password"
                name="customer[password]"
                id="RegisterPasswordDrawer"
                autocomplete="new-password"
                placeholder="Senha"
                required
                data-password-input
              >
              <button type="button" class="login-drawer__password-toggle" aria-label="Mostrar senha" data-password-toggle>
                <span class="login-drawer__eye login-drawer__eye--show" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" stroke="currentColor" stroke-width="1.5"/>
                    <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </span>
                <span class="login-drawer__eye login-drawer__eye--hide" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M3 3l18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M10.6 5.2A10.8 10.8 0 0 1 12 5c6 0 9.5 7 9.5 7a17.4 17.4 0 0 1-3.1 4.1M6.5 6.7C3.9 8.5 2.5 12 2.5 12s3.5 7 9.5 7c1.7 0 3.2-.5 4.5-1.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </button>
            </div>
          </div>

          <div class="login-drawer__field">
            <label for="RegisterPasswordConfirmationDrawer">Confirmar senha</label>
            <div class="login-drawer__password-field">
              <input
                type="password"
                id="RegisterPasswordConfirmationDrawer"
                autocomplete="new-password"
                placeholder="Confirmar senha"
                required
                data-register-password-confirmation
                data-password-input
              >
              <button type="button" class="login-drawer__password-toggle" aria-label="Mostrar senha" data-password-toggle>
                <span class="login-drawer__eye login-drawer__eye--show" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" stroke="currentColor" stroke-width="1.5"/>
                    <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </span>
                <span class="login-drawer__eye login-drawer__eye--hide" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <path d="M3 3l18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M10.6 5.2A10.8 10.8 0 0 1 12 5c6 0 9.5 7 9.5 7a17.4 17.4 0 0 1-3.1 4.1M6.5 6.7C3.9 8.5 2.5 12 2.5 12s3.5 7 9.5 7c1.7 0 3.2-.5 4.5-1.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </button>
            </div>
          </div>

          <p class="login-drawer__match-error" data-register-match-error role="alert">As senhas precisam ser iguais.</p>

          <button type="submit" class="login-drawer__btn">Criar conta</button>
        {% endform %}

        <div class="login-drawer__divider">ou</div>

        <a href="#" class="login-drawer__btn-social" onclick="event.preventDefault(); alert('Login social requer configuração via aplicativo Shopify.');">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Continuar com Google
        </a>

        <div class="login-drawer__footer">
          Já possui conta?
          <button type="button" class="login-drawer__switch" data-auth-view-trigger="login">Entrar</button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .login-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(10, 10, 10, 0.15);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), visibility 0.5s;
    will-change: opacity;
  }

  .login-drawer-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  .login-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 480px;
    height: 100vh;
    height: 100dvh;
    background-color: #ffffff;
    z-index: 1002;
    transform: translateX(100%);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
    display: flex;
    flex-direction: column;
    border-top-left-radius: 32px;
    border-bottom-left-radius: 32px;
    box-shadow: -15px 0 40px rgba(0, 0, 0, 0.08);
  }

  .login-drawer.is-active {
    transform: translateX(0);
  }

  .login-drawer__header {
    display: flex;
    justify-content: flex-end;
    padding: 2.5rem 2.5rem 1rem;
    flex-shrink: 0;
  }

  .login-drawer__close,
  .login-drawer__switch {
    background: none;
    border: none;
    cursor: pointer;
    color: #1a1a1a;
    font: inherit;
  }

  .login-drawer__close {
    padding: 0.5rem;
    transition: opacity 0.3s ease, transform 0.4s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .login-drawer__close svg {
    width: 1.25rem;
    height: 1.25rem;
    stroke-width: 1px;
  }

  .login-drawer__close:hover {
    opacity: 0.5;
    transform: rotate(90deg);
  }

  .login-drawer__content {
    flex: 1;
    overflow-y: auto;
    padding: 0 3rem 3rem;
    display: flex;
    flex-direction: column;
  }

  .login-drawer__inner,
  .login-drawer__view {
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }

  .login-drawer__view {
    display: none;
    animation: authDrawerFadeIn 0.4s ease forwards;
  }

  @keyframes authDrawerFadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .login-drawer__view--active {
    display: flex;
  }

  .login-drawer__title {
    font-family: 'Inter', sans-serif;
    font-size: 1.75rem;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
    text-align: center;
  }

  .login-drawer__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: #666;
    line-height: 1.5;
    margin: 0 0 2.5rem;
    text-align: center;
  }

  .login-drawer__form {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .login-drawer__field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .login-drawer__field {
    margin-bottom: 1.125rem;
    display: flex;
    flex-direction: column;
  }

  .login-drawer__field label {
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #1a1a1a;
    margin-bottom: 0.5rem;
    letter-spacing: 0.01em;
  }

  .login-drawer__field input {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    padding: 0.875rem 1.25rem;
    border: 1px solid #e5dfd8;
    border-radius: 8px;
    outline: none;
    transition: all 0.2s ease;
    width: 100%;
    height: 3rem;
    color: #1a1a1a;
    background: #fff;
  }

  .login-drawer__field input::placeholder {
    color: #a39e99;
    font-weight: 400;
  }

  .login-drawer__field input:focus {
    border-color: #7d5a44;
    box-shadow: 0 0 0 3px rgba(125, 90, 68, 0.08);
  }

  .login-drawer__password-field {
    position: relative;
    width: 100%;
  }

  .login-drawer__password-field input {
    padding-right: 3rem;
  }

  .login-drawer__password-toggle {
    position: absolute;
    top: 50%;
    right: 0.5rem;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: #888;
    cursor: pointer;
    transform: translateY(-50%);
    transition: color 0.2s ease, background 0.2s ease;
  }

  .login-drawer__password-toggle:hover {
    color: #1a1a1a;
    background: #f5f0eb;
  }

  .login-drawer__eye {
    width: 1.1rem;
    height: 1.1rem;
    display: block;
  }

  .login-drawer__eye svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .login-drawer__eye--hide,
  .login-drawer__password-toggle.is-visible .login-drawer__eye--show {
    display: none;
  }

  .login-drawer__password-toggle.is-visible .login-drawer__eye--hide {
    display: block;
  }

  .login-drawer__forgot-password {
    text-align: right;
    margin-top: -0.25rem;
    margin-bottom: 2rem;
  }

  .login-drawer__switch {
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #7d5a44;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease, color 0.2s ease;
  }

  .login-drawer__forgot-password .login-drawer__switch {
    color: #666;
    text-decoration: none;
  }

  .login-drawer__forgot-password .login-drawer__switch:hover {
    color: #1a1a1a;
    text-decoration: underline;
  }

  .login-drawer__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 3rem;
    background-color: #7d5a44;
    color: #ffffff;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    border: 1px solid #7d5a44;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .login-drawer__btn:hover {
    background-color: #5e4233;
    border-color: #5e4233;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(125, 90, 68, 0.15);
  }

  .login-drawer__btn:active {
    transform: translateY(0);
  }

  .login-drawer__divider {
    display: flex;
    align-items: center;
    width: 100%;
    margin: 1.5rem 0;
    color: #a39e99;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .login-drawer__divider::before,
  .login-drawer__divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: #e5dfd8;
  }

  .login-drawer__divider::before { margin-right: 1rem; }
  .login-drawer__divider::after { margin-left: 1rem; }

  .login-drawer__btn-social {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    height: 3rem;
    border: 1px solid #e5dfd8;
    border-radius: 8px;
    background: #fff;
    color: #1a1a1a;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .login-drawer__btn-social:hover {
    background: #faf8f5;
    border-color: #d1cbc5;
  }

  .login-drawer__errors,
  .login-drawer__success {
    border-radius: 8px;
    padding: 0.75rem 1rem;
    margin: 0 0 1.5rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .login-drawer__errors {
    background-color: #fff5f5;
    border: 1px solid #ffcccc;
    color: #c0392b;
  }

  .login-drawer__success {
    background-color: #f0faf5;
    border: 1px solid #d4f2e3;
    color: #27ae60;
  }

  .login-drawer__errors ul {
    margin: 0;
    padding: 0;
    padding-left: 1rem;
  }

  .login-drawer__match-error {
    display: none;
    margin-top: -0.25rem;
    background-color: #fff5f5;
    border: 1px solid #ffcccc;
    border-radius: 8px;
    padding: 0.75rem 1rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    color: #c0392b;
    line-height: 1.5;
  }

  .login-drawer__match-error.is-visible {
    display: block;
    margin-bottom: 1rem;
  }

  .login-drawer__footer {
    margin-top: auto;
    padding-top: 1.5rem;
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    color: #666;
  }

  .login-drawer__footer .login-drawer__switch {
    margin-left: 0.25rem;
  }

  @media (max-width: 768px) {
    .login-drawer {
      max-width: 90%;
      border-top-left-radius: 24px;
      border-bottom-left-radius: 24px;
    }

    .login-drawer__content {
      padding: 0 1.75rem 2.5rem;
    }

    .login-drawer__field-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>

<script>
  (function () {
    const overlay = document.querySelector('[data-login-overlay]');
    const drawer = document.querySelector('[data-login-drawer]');
    const closeBtn = document.querySelector('[data-login-close]');
    const loginFirstInput = document.querySelector('[data-login-first-input]');
    const registerFirstInput = document.querySelector('[data-register-first-input]');
    const recoverFirstInput = document.querySelector('[data-recover-first-input]');
    const viewTriggers = document.querySelectorAll('[data-auth-view-trigger]');
    let lastFocusedElement;

    if (!overlay || !drawer) return;

    function setView(viewName) {
      drawer.querySelectorAll('[data-login-view]').forEach(function (view) {
        const isActive = view.dataset.loginView === viewName;
        view.classList.toggle('login-drawer__view--active', isActive);
        view.setAttribute('aria-hidden', isActive ? 'false' : 'true');
      });

      setTimeout(function () {
        if (viewName === 'register' && registerFirstInput) {
          registerFirstInput.focus();
        } else if (viewName === 'recover' && recoverFirstInput) {
          recoverFirstInput.focus();
        } else if (loginFirstInput) {
          loginFirstInput.focus();
        }
      }, 80);
    }

    drawer.querySelectorAll('[data-password-toggle]').forEach(function (toggle) {
      const field = toggle.closest('.login-drawer__password-field');
      const input = field ? field.querySelector('[data-password-input]') : null;

      if (!input) return;

      toggle.addEventListener('click', function () {
        const shouldShow = input.type === 'password';
        input.type = shouldShow ? 'text' : 'password';
        toggle.classList.toggle('is-visible', shouldShow);
        toggle.setAttribute('aria-label', shouldShow ? 'Ocultar senha' : 'Mostrar senha');
      });
    });

    viewTriggers.forEach(function (trigger) {
      trigger.addEventListener('click', function (e) {
        e.preventDefault();
        setView(trigger.dataset.authViewTrigger);
      });
    });

    const registerForm = drawer.querySelector('.login-drawer__form--register');

    if (registerForm) {
      registerForm.addEventListener('submit', function (event) {
        const password = registerForm.querySelector('#RegisterPasswordDrawer');
        const confirmation = registerForm.querySelector('[data-register-password-confirmation]');
        const error = registerForm.querySelector('[data-register-match-error]');

        if (!password || !confirmation || !error) return;

        if (password.value !== confirmation.value) {
          event.preventDefault();
          error.classList.add('is-visible');
          confirmation.setAttribute('aria-invalid', 'true');
          confirmation.focus();
        } else {
          error.classList.remove('is-visible');
          confirmation.removeAttribute('aria-invalid');
        }
      });
    }

    function preventScroll(e) {
      if (!e.target.closest('[data-login-drawer]')) {
        e.preventDefault();
      }
    }

    function lockScroll() {
      window.addEventListener('wheel', preventScroll, { passive: false });
      window.addEventListener('touchmove', preventScroll, { passive: false });
    }

    function unlockScroll() {
      window.removeEventListener('wheel', preventScroll);
      window.removeEventListener('touchmove', preventScroll);
    }

    function openLogin() {
      lastFocusedElement = document.activeElement;
      setView('login');
      overlay.classList.add('is-active');
      drawer.classList.add('is-active');
      overlay.setAttribute('aria-hidden', 'false');
      drawer.setAttribute('aria-hidden', 'false');
      lockScroll();
    }

    function closeLogin() {
      overlay.classList.remove('is-active');
      drawer.classList.remove('is-active');
      overlay.setAttribute('aria-hidden', 'true');
      drawer.setAttribute('aria-hidden', 'true');
      unlockScroll();
      if (lastFocusedElement) lastFocusedElement.focus();
    }

    document.body.addEventListener('click', function(e) {
      const loginTrigger = e.target.closest('[data-login-open]');
      if (loginTrigger) {
        e.preventDefault();
        openLogin();
      }
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', function (e) {
        e.preventDefault();
        closeLogin();
      });
    }

    overlay.addEventListener('click', closeLogin);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && drawer.classList.contains('is-active')) {
        closeLogin();
      }

      if (e.key === 'Tab' && drawer.classList.contains('is-active')) {
        const activeView = drawer.querySelector('[data-login-view].login-drawer__view--active');
        const focusRoot = activeView || drawer;
        const focusable = focusRoot.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (!first || !last) return;

        if (e.shiftKey) {
          if (document.activeElement === first) { last.focus(); e.preventDefault(); }
        } else {
          if (document.activeElement === last) { first.focus(); e.preventDefault(); }
        }
      }
    });
  })();
</script>
